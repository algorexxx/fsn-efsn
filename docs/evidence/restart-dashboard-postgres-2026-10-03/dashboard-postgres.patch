+        connectionTimeoutMillis: Number(timeout),
+        statement_timeout: Number(timeout),
+        query_timeout: Number(timeout),
     };
     const file = requiredSetting(environment, 'DB_PASSWORD_FILE');
     if (!isAbsolute(file)) {
