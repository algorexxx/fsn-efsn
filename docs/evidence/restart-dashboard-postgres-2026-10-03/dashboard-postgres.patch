+    if (!/^[1-9][0-9]{0,9}$/.test(timeout) || Number(timeout) > 2147483647) {
+        throw new Error('DB_TIMEOUT_MS must be an integer from 1 to 2147483647');
+    }
     const config = {
         host: loopbackHost(environment, 'DB_HOST'),
         port: portNumber(environment, 'DB_PORT', 1),
@@ -43,6 +47,9 @@ function loadDatabaseConfig(environment) {
         user: requiredSetting(environment, 'DB_USER'),
