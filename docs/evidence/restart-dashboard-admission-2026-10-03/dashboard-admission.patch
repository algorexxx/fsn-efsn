+const { connect, login, send, inventory, waitMessage } = require('./fixtures/wire-client.cjs');
+
+test('real collector bounds registration and ping while retaining only native metadata across reconnect', { timeout: 15000 }, async t => {
+    const server = await startCollector(t);
+    const viewer = connect(t, server.port, 'primus');
+    await viewer.opened;
+    const oversized = connect(t, server.port, 'api');
+    await oversized.opened;
+    send(oversized, 'hello', { id: 'node-a', secret: secretA, info: { ...info(), node: 'å'.repeat(1024) } });
+    await oversized.closed;
+    assert.deepEqual(await inventory(viewer), []);
+
+    const bounded = info();
+    bounded.node += 'x'.repeat(2048 - Buffer.byteLength(JSON.stringify(bounded)));
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA, { ...bounded, name: 'untrusted-label', ip: 'reported-ip', extension: { note: 'unused' } });
+    send(owner, 'node-ping', { id: 'node-a', clientTime: 'å'.repeat(63) });
+    const pong = await waitMessage(owner, message => message.emit && message.emit[0] === 'node-pong');
+    assert.equal(pong.emit[1].clientTime, 'å'.repeat(63));
+    assert.equal(Number.isSafeInteger(pong.emit[1].serverTime), true);
+    const [accepted] = await inventory(viewer);
+    assert.deepEqual(accepted.info, { ...bounded, ip: '127.0.0.1' });
+    assert.deepEqual(accepted.reports, { block: null, stats: null, pending: null });
+
+    const from = viewer.messages.length;
+    send(owner, 'node-ping', { id: 'node-a', clientTime: 'å'.repeat(64) });
+    await owner.closed;
+    await waitMessage(viewer, message => message.action === 'inactive', from);
+    assert.equal(owner.messages.filter(message => message.emit && message.emit[0] === 'node-pong').length, 1);
+    const [inactive] = await inventory(viewer);
+    assert.equal(inactive.uptime.lastStatus, false);
+    assert.deepEqual(inactive.info, accepted.info);
+    assert.deepEqual(inactive.reports, { block: null, stats: null, pending: null });
+
+    const replacement = connect(t, server.port, 'api');
+    await login(replacement, 'node-a', secretA);
+    const [reconnected] = await inventory(viewer);
+    assert.deepEqual(reconnected.info, { ...info(), ip: '127.0.0.1' });
+    assert.equal(reconnected.uptime.lastStatus, true);
+    viewer.socket.close();
+    replacement.socket.close();
+    await Promise.all([viewer.closed, replacement.closed]);
+    await server.stop();
+});
diff --git a/test/metadata-admission.test.cjs b/test/metadata-admission.test.cjs
