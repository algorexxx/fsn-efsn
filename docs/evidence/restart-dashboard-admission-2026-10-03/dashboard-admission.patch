+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { loadCollector, connectCollector, hello, secretA } = require('./fixtures/collector.cjs');
+const { info } = require('./fixtures/telemetry-report.cjs');
+
+test('registration projects the native metadata fields and collector identity before collection', t => {
+    const collector = loadCollector(t);
+    const spark = connectCollector(collector);
+    const input = { ...info(), name: 'different-label', ip: 'reported-ip', extension: { notes: 'unused' } };
+
+    spark.handlers.get('hello')({ id: 'node-a', secret: secretA, info: input });
+
+    assert.deepEqual(JSON.parse(JSON.stringify(collector.calls[0].data.info)), info());
+    assert.equal(collector.calls[0].data.ip, '127.0.0.1');
+    assert.equal(spark.ended, false);
+});
+
+test('registration rejects missing or malformed native fields before reserving the identity', t => {
+    const invalid = [{ node: undefined }, { node: '' }, { net: 99032659 }, { protocol: [] }, { api: {} }, { os: null }, { os_v: true }, { client: 1 }, { port: -1 }, { port: 65536 }, { port: 1.5 }, { canUpdateHistory: 'true' }];
+
+    const results = invalid.map(fields => {
+        const collector = loadCollector(t);
+        const rejected = connectCollector(collector);
+        rejected.handlers.get('hello')({ id: 'node-a', secret: secretA, info: { ...info(), ...fields } });
+        const before = collector.calls.map(call => call.method);
+        const next = connectCollector(collector, 'replacement');
+        hello(next);
+        return { rejected: rejected.ended, before, next: next.emitted };
+    });
+
+    assert.deepEqual(results, invalid.map(() => ({ rejected: true, before: [], next: [{ name: 'ready', data: undefined }] })));
+});
+
+test('registration accounts for UTF-8 and JSON escaping within its serialized metadata budget', t => {
+    const results = ['a'.repeat(2048), 'å'.repeat(1024), '\u0000'.repeat(342)].map(node => {
+        const collector = loadCollector(t);
+        const spark = connectCollector(collector);
+        spark.handlers.get('hello')({ id: 'node-a', secret: secretA, info: { ...info(), node } });
+        return { ended: spark.ended, calls: collector.calls, emitted: spark.emitted };
+    });
+
+    assert.deepEqual(results, Array(3).fill({ ended: true, calls: [], emitted: [] }));
+});
+
+test('registration accepts the exact serialized metadata boundary and rejects one byte beyond', t => {
+    const bounded = info();
+    bounded.node += 'x'.repeat(2048 - Buffer.byteLength(JSON.stringify(bounded)));
+    const results = [bounded, { ...bounded, node: bounded.node + 'x' }].map(value => {
+        const collector = loadCollector(t);
+        const spark = connectCollector(collector);
+        spark.handlers.get('hello')({ id: 'node-a', secret: secretA, info: value });
+        return { ended: spark.ended, registered: collector.calls.length };
+    });
+
+    assert.equal(Buffer.byteLength(JSON.stringify(bounded)), 2048);
+    assert.deepEqual(results, [{ ended: false, registered: 1 }, { ended: true, registered: 0 }]);
+});
+
+test('native efsn timestamp strings and the exact ping boundary are echoed unchanged', t => {
+    const values = ['2026-10-03 12:34:56.123456789 +0000 UTC m=+123456789.123456789', 'x'.repeat(126), 'å'.repeat(63), '\u0000'.repeat(21)];
+    const results = values.map(clientTime => {
+        const collector = loadCollector(t);
+        const spark = connectCollector(collector);
+        hello(spark);
+        collector.calls.length = 0;
+        spark.handlers.get('node-ping')({ id: 'node-a', clientTime });
+        return { ended: spark.ended, pong: JSON.parse(JSON.stringify(spark.emitted[1])), calls: collector.calls };
+    });
+
+    assert.deepEqual(results, values.map(clientTime => ({ ended: false, pong: { name: 'node-pong', data: { clientTime, serverTime: 1234 } }, calls: [] })));
+});
+
+test('invalid ping values end the telemetry session without echoing their contents', t => {
+    const values = [undefined, null, {}, [], 1, true, '', 'x'.repeat(127), 'å'.repeat(64), '\u0000'.repeat(22)];
+    const results = values.map(clientTime => {
+        const collector = loadCollector(t);
+        const spark = connectCollector(collector);
+        hello(spark);
+        collector.calls.length = 0;
+        spark.handlers.get('node-ping')({ id: 'node-a', clientTime });
+        return { ended: spark.ended, emitted: spark.emitted, calls: collector.calls };
+    });
+
+    assert.deepEqual(results, values.map(() => ({ ended: true, emitted: [{ name: 'ready', data: undefined }], calls: [{ method: 'inactive', spark: 'session-a' }] })));
+});
