diff --git a/.github/workflows/validate.yml b/.github/workflows/validate.yml
new file mode 100644
index 0000000..1173e63
--- /dev/null
+++ b/.github/workflows/validate.yml
@@ -0,0 +1,47 @@
+name: Validate dashboard
+
+on:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  validate:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    env:
+      CI: 'true'
+      REACT_APP_STATS_API_PATH: /stats-api
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020
+        with:
+          node-version: 24.21.0
+          package-manager-cache: false
+      - name: Select npm
+        run: npm install --global npm@10.9.0 --ignore-scripts --no-audit --no-fund
+      - name: Install backend
+        run: npm ci --engine-strict --ignore-scripts --no-audit --no-fund
+      - name: Backend contracts
+        run: npm test
+      - name: Backend sockets
+        run: npm run test:wire
+      - name: Install frontend
+        working-directory: react-frontend
+        run: npm ci --engine-strict --ignore-scripts --no-audit --no-fund
+      - name: Frontend contracts
+        working-directory: react-frontend
+        env:
+          REACT_APP_STATS_POLL_INTERVAL_MS: '100'
+          REACT_APP_STATS_REQUEST_TIMEOUT_MS: '50'
+        run: npm test -- --watchAll=false --runInBand
+      - name: Build frontend
+        working-directory: react-frontend
+        env:
+          REACT_APP_STATS_POLL_INTERVAL_MS: '250'
+          REACT_APP_STATS_REQUEST_TIMEOUT_MS: '1000'
+        run: npm run build
