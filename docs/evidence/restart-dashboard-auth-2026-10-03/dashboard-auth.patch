diff --git a/test/collector.test.cjs b/test/collector.test.cjs
new file mode 100644
index 0000000..a4d7912
--- /dev/null
+++ b/test/collector.test.cjs
@@ -0,0 +1,182 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { loadCollector, connectCollector, hello, secretA, secretB, secretNext } = require('./fixtures/collector.cjs');
+
+const events = [
+    ['update', { stats: { block: {} } }, 'update'],
+    ['block', { block: { number: 1 } }, 'addBlock'],
+    ['pending', { stats: { pending: 1 } }, 'updatePending'],
+    ['stats', { stats: { peers: 1, mining: true } }, 'updateStats'],
+    ['history', { history: [{ number: 1 }] }, 'addHistory'],
+    ['latency', { latency: '12' }, 'updateLatency'],
+    ['node-ping', { clientTime: '2026-10-03T00:00:00Z' }, null],
+];
+
+test('ordinary hello becomes ready and strips the credential before collection', t => {
+    const collector = loadCollector(t);
+    const spark = connectCollector(collector);
+    hello(spark);
+    assert.deepEqual(spark.emitted, [{ name: 'ready', data: undefined }]);
+    assert.equal(collector.calls[0].data.id, 'node-a');
+    assert.equal(collector.calls[0].data.info.name, 'node-a');
+    assert.equal(Object.hasOwn(collector.calls[0].data, 'secret'), false);
+    assert.equal(JSON.stringify(collector.logs).includes(secretA), false);
+});
+
+for (const [name, options] of [
+    ['missing credential file', { environment: { WS_CREDENTIALS_FILE: undefined } }],
+    ['empty credential path', { environment: { WS_CREDENTIALS_FILE: '' } }],
+    ['empty configured secret', { credentials: { 'node-a': '' } }],
+    ['legacy shared secret', { environment: { WS_SECRET: secretA } }],
+]) {
+    test(`invalid startup never listens: ${name}`, t => {
+        const collector = loadCollector(t, options);
+        assert.equal(collector.listening, false);
+        assert.ok(collector.startupError);
+        assert.deepEqual(collector.calls, []);
+    });
+}
+
+for (const [event, payload, method] of events) {
+    test(`${event} accepts the authenticated identity`, t => {
+        const collector = loadCollector(t);
+        const spark = connectCollector(collector);
+        hello(spark);
+        collector.calls.length = 0;
+        spark.handlers.get(event)({ id: 'node-a', ...payload });
+        assert.deepEqual(collector.calls, method ? [{ method, id: 'node-a' }] : []);
+        assert.equal(spark.ended, false);
+        if (event === 'node-ping') assert.equal(spark.emitted[1].name, 'node-pong');
+    });
+    for (const mode of ['before hello', 'different identity', 'after disconnect']) {
+        test(`${event} is blocked ${mode}`, t => {
+            const collector = loadCollector(t);
+            const spark = connectCollector(collector);
+            if (mode !== 'before hello') hello(spark);
+            if (mode === 'after disconnect') spark.handlers.get('end')();
+            collector.calls.length = 0;
+            spark.handlers.get(event)({ id: mode === 'different identity' ? 'node-b' : 'node-a', ...payload });
+            assert.deepEqual(collector.calls, mode === 'different identity' ? [{ method: 'inactive', spark: 'session-a' }] : []);
+            assert.equal(spark.ended, true);
+        });
+    }
+}
+
+test('a credential for another node cannot register a different identity', t => {
+    const collector = loadCollector(t);
+    const spark = connectCollector(collector);
+    hello(spark, 'node-b', secretA);
+    assert.deepEqual(collector.calls, []);
+    assert.deepEqual(spark.emitted, []);
+    assert.equal(spark.ended, true);
+});
+
+test('rejected hello neither logs its credential nor permits a later hello on that session', t => {
+    const collector = loadCollector(t);
+    const spark = connectCollector(collector);
+    hello(spark, 'node-a', secretB);
+    hello(spark);
+    assert.deepEqual(collector.calls, []);
+    assert.deepEqual(spark.emitted, []);
+    assert.equal(collector.logs.some(value => value.includes(secretB)), false);
+});
+
+test('banned source address cannot authenticate', t => {
+    const collector = loadCollector(t, { banned: ['127.0.0.1'] });
+    const spark = connectCollector(collector);
+    hello(spark);
+    assert.equal(spark.ended, true);
+    assert.deepEqual(collector.calls, []);
+});
+
+test('duplicate identity is rejected without changing the existing session', t => {
+    const collector = loadCollector(t);
+    const owner = connectCollector(collector);
+    hello(owner);
+    collector.calls.length = 0;
+    const duplicate = connectCollector(collector, 'session-duplicate');
+    hello(duplicate);
+    duplicate.handlers.get('end')();
+    owner.handlers.get('stats')({ id: 'node-a', stats: { peers: 1 } });
+    assert.deepEqual(collector.calls, [{ method: 'updateStats', id: 'node-a' }]);
+    assert.equal(duplicate.ended, true);
+    assert.equal(owner.ended, false);
+});
+
+test('reconnect after disconnect accepts the rotating credential and ignores a late old end event', t => {
+    const collector = loadCollector(t, { credentials: { 'node-a': [secretA, secretNext] } });
+    const old = connectCollector(collector);
+    hello(old);
+    old.handlers.get('end')();
+    assert.equal(collector.calls.at(-1).method, 'inactive');
+    const fresh = connectCollector(collector, 'session-new');
+    hello(fresh, 'node-a', secretNext);
+    collector.calls.length = 0;
+    old.handlers.get('end')();
+    old.handlers.get('stats')({ id: 'node-a', stats: { peers: 1 } });
+    fresh.handlers.get('stats')({ id: 'node-a', stats: { peers: 2 } });
+    assert.deepEqual(collector.calls, [{ method: 'updateStats', id: 'node-a' }]);
+    assert.deepEqual(fresh.emitted, [{ name: 'ready', data: undefined }]);
+});
+
+test('repeated hello ends the old session and releases the identity for reconnect', t => {
+    const collector = loadCollector(t);
+    const old = connectCollector(collector);
+    hello(old);
+    collector.calls.length = 0;
+    hello(old);
+    assert.deepEqual(collector.calls, [{ method: 'inactive', spark: 'session-a' }]);
+    const fresh = connectCollector(collector, 'session-new');
+    hello(fresh);
+    assert.deepEqual(fresh.emitted, [{ name: 'ready', data: undefined }]);
+});
+
+test('failed collection registration sends no ready and releases its reservation', t => {
+    const collector = loadCollector(t, { failAdd: true });
+    const first = connectCollector(collector);
+    hello(first);
+    const second = connectCollector(collector, 'session-new');
+    hello(second);
+    assert.deepEqual(collector.calls.map(call => call.method), ['add', 'inactive', 'add', 'inactive']);
+    assert.deepEqual(first.emitted, []);
+    assert.deepEqual(second.emitted, []);
+});
+
+test('a delayed registration cannot publish ready after disconnect or replace a new owner', t => {
+    const collector = loadCollector(t, { deferAdd: true });
+    const old = connectCollector(collector);
+    hello(old);
+    old.handlers.get('stats')({ id: 'node-a', stats: { peers: 1 } });
+    const fresh = connectCollector(collector, 'session-new');
+    hello(fresh);
+    collector.registrations[0]();
+    collector.registrations[1]();
+    collector.calls.length = 0;
+    old.handlers.get('end')();
+    fresh.handlers.get('stats')({ id: 'node-a', stats: { peers: 1 } });
+    assert.deepEqual(old.emitted, []);
+    assert.deepEqual(fresh.emitted, [{ name: 'ready', data: undefined }]);
+    assert.deepEqual(collector.calls, [{ method: 'updateStats', id: 'node-a' }]);
+});
+
+for (const event of ['hello', ...events.map(value => value[0])]) {
+    test(`${event} rejects an absent envelope without throwing or logging it`, t => {
+        const collector = loadCollector(t);
+        const spark = connectCollector(collector);
+        if (event !== 'hello') hello(spark);
+        spark.handlers.get(event)(null);
+        assert.equal(spark.ended, true);
+    });
+}
+
+test('malformed report bodies close the authenticated session without a collection update', t => {
+    for (const event of ['update', 'block', 'pending', 'stats', 'history']) {
+        const collector = loadCollector(t);
+        const spark = connectCollector(collector);
+        hello(spark);
+        collector.calls.length = 0;
+        spark.handlers.get(event)({ id: 'node-a', stats: null, block: null, history: [null], secret: secretA });
+        assert.deepEqual(collector.calls, [{ method: 'inactive', spark: 'session-a' }]);
+        assert.equal(collector.logs.some(value => value.includes(secretA)), false);
+    }
+});
diff --git a/test/fixtures/collector.cjs b/test/fixtures/collector.cjs
new file mode 100644
index 0000000..649efc2
--- /dev/null
+++ b/test/fixtures/collector.cjs
@@ -0,0 +1,104 @@
+const assert = require('node:assert/strict');
+const { readFileSync, writeFileSync, mkdtempSync, unlinkSync, rmdirSync } = require('node:fs');
+const { join } = require('node:path');
+const { tmpdir } = require('node:os');
+const vm = require('node:vm');
+const loadTelemetryCredentials = require('../../lib/telemetry-credentials');
+
+const secretA = 'synthetic-node-a-credential-00000000000001';
+const secretB = 'synthetic-node-b-credential-00000000000002';
+const secretNext = 'synthetic-node-a-credential-00000000000003';
+
+function credentialFile(t, value, raw = false) {
+    const directory = mkdtempSync(join(tmpdir(), 'fsn-stats-credentials-'));
+    const file = join(directory, 'credentials.json');
+    writeFileSync(file, raw ? value : JSON.stringify(value), { encoding: 'utf8', mode: 0o600 });
+    t.after(() => { unlinkSync(file); rmdirSync(directory); });
+    return file;
+}
+
+function loadCollector(t, options = {}) {
+    const file = credentialFile(t, options.credentials || { 'node-a': secretA, 'node-b': secretB });
+    const result = { calls: [], logs: [], sockets: new Map(), listening: false, registrations: [] };
+    const server = { listen() { result.listening = true; } };
+    class Primus {
+        constructor(_, config) {
+            this.handlers = new Map();
+            this.writes = [];
+            result.sockets.set(config.pathname, this);
+        }
+        plugin() {}
+        on(name, handler) { this.handlers.set(name, handler); }
+        write(data) { this.writes.push(data); }
+    }
+    class Collection {
+        setChartsCallback() {}
+        add(data, callback) {
+            result.calls.push({ method: 'add', id: data.id, spark: data.spark, data });
+            if (options.deferAdd) {
+                result.registrations.push(() => callback(null, { id: data.id }));
+                return;
+            }
+            callback(options.failAdd ? 'registration failed' : null, { id: data.id });
+        }
+        inactive(spark, callback) {
+            result.calls.push({ method: 'inactive', spark });
+            callback(null, { active: false });
+        }
+        getCharts() {}
+        requiresUpdate() { return false; }
+    }
+    for (const method of ['update', 'addBlock', 'updatePending', 'updateStats', 'addHistory', 'updateLatency']) {
+        Collection.prototype[method] = function (id, data, callback) {
+            result.calls.push({ method, id });
+            callback(null, data);
+        };
+    }
+    const modules = {
+        './lib/telemetry-credentials': loadTelemetryCredentials,
+        lodash: { isUndefined: value => value === undefined, now: () => 1234 },
+        './lib/utils/logger': {},
+        './lib/utils/config': { banned: options.banned || [] },
+        chalk: { reset: { cyan: value => value } },
+        http: { createServer: () => server },
+        primus: Primus,
+        'primus-emit': {},
+        'primus-spark-latency': {},
+        './lib/collection': Collection,
+    };
+    const consoleStub = Object.fromEntries(['info', 'error', 'success', 'warn', 'log', 'time', 'timeEnd'].map(name => [name, (...args) => result.logs.push(JSON.stringify(args))]));
+    const context = vm.createContext({
+        require(name) {
+            if (!Object.hasOwn(modules, name)) throw new Error(`Unexpected dependency: ${name}`);
+            return modules[name];
+        },
+        process: { env: { NODE_ENV: 'production', WS_CREDENTIALS_FILE: file, ...options.environment } },
+        console: consoleStub,
+        setInterval: () => 0,
+        module: { exports: {} },
+    });
+    try {
+        vm.runInContext(readFileSync(join(__dirname, '../../server.js'), 'utf8'), context, { filename: 'fsn-stats/server.js', timeout: 1000 });
+    } catch (error) {
+        result.startupError = error;
+    }
+    return result;
+}
+
+function connectCollector(collector, id = 'session-a') {
+    assert.equal(collector.startupError, undefined);
+    const spark = {
+        id, address: { ip: '127.0.0.1' }, handlers: new Map(), emitted: [], ended: false,
+        on(name, handler) { this.handlers.set(name, handler); },
+        emit(name, data) { this.emitted.push({ name, data }); },
+        end() { this.ended = true; },
+    };
+    collector.sockets.get('/api').handlers.get('connection')(spark);
+    return spark;
+}
+
+function hello(spark, id = 'node-a', secret = secretA) {
+    spark.handlers.get('hello')({ id, secret, info: { name: id, node: 'efsn-test', network: '99032659' } });
+}
+
+module.exports = { credentialFile, loadCollector, connectCollector, hello, secretA, secretB, secretNext };
