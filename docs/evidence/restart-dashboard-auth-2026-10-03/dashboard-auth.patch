diff --git a/docs/telemetry-enrollment.md b/docs/telemetry-enrollment.md
new file mode 100644
index 0000000..9084616
--- /dev/null
+++ b/docs/telemetry-enrollment.md
@@ -0,0 +1,98 @@
+# Collector credentials and node enrollment
+
+The collector requires `WS_CREDENTIALS_FILE`, an absolute path to a private
+UTF-8 JSON file. There is no shared `WS_SECRET` or implicit `ws_secret.json`
+fallback. An invalid or missing configuration stops startup before listening.
+This changes collector configuration; the existing efsn `hello` / `ready`
+WebSocket envelope and `--ethstats` format stay unchanged.
+
+The JSON object maps each permitted dashboard node name to its own credential:
+
+```json
+{
+  "donation-node": "<unique-generated-token>",
+  "independent-node": "<different-unique-generated-token>"
+}
+```
+
+Replace the placeholders. Node names use 1–64 letters, digits, dots, underscores
+or hyphens and start with a letter or digit. Credentials use 32–256 characters
+from `A-Z`, `a-z`, `0-9`, `_` and `-`. Use cryptographically generated credentials,
+for example 32 random bytes encoded as 64 hex characters. Minimum length alone
+does not establish entropy. Duplicate credentials, even under different node
+names, are refused.
+
+Store the actual file outside the checkout with access restricted to the
+collector service account and its administrator. Provide each operator only
+their own dashboard credential. Never collect validator signing keys. No real
+credential or populated deployment configuration belongs in Git.
+
+For a Unix service with its environment already protected, the collector uses:
+
+```sh
+WS_CREDENTIALS_FILE=/absolute/private/telemetry-credentials.json NODE_ENV=production PORT=3000 npm start
+```
+
+The existing listener is HTTP; public hosting still needs a private bind/proxy
+arrangement and TLS. Configure nodes with explicit WSS through that deployment:
+
+```text
+--ethstats <node-name>:<that-node-credential>@wss://<telemetry-host>
+```
+
+Use protected service configuration when supplying credentials. Changing the
+dashboard name requires changing its configured credential mapping as well.
+The published display name is the authenticated node name.
+
+## Sessions, reconnect and rotation
+
+Only one live connection owns a dashboard name at a time. A second connection
+with that name is rejected without changing the first. Stop the old telemetry
+connection and allow its disconnect to complete before moving the same identity
+to another process. Each concurrently running node needs a distinct dashboard
+name and credential, independent of its P2P or validator identity.
+
+Updates, block/history reports, pending/stat reports, latency and ping require a
+completed login and the same node name on that connection. A repeated hello,
+cross-node update or invalid top-level envelope ends the session. Closed sessions
+cannot change a later connection's state. Failed registration releases its
+reservation; delayed callbacks cannot make a disconnected session ready again.
+
+For rotation, a node's value may temporarily contain two unique credentials:
+
+```json
+{
+  "donation-node": ["<current-generated-token>", "<next-generated-token>"]
+}
+```
+
+The file is loaded at startup. Update it and restart the collector to enable the
+next credential, reconnect the node with that credential, then remove the old
+one and restart the collector again. The restart closes existing sessions, so
+removing a credential also requires reconnecting with an accepted one. There is
+no live reload or cross-process session coordination. Operate one collector for
+this identity registry until shared ownership has its own tested design.
+
+Enrollment grants dashboard visibility only. A Fusion node can synchronize,
+buy tickets and produce blocks without being enrolled here. Independent owners
+retain their signing keys and fund their own tickets.
+
+## Validation and remaining boundaries
+
+`npm test` runs credential and handler/session contracts with fake transports
+and collection callbacks. `npm run test:wire` runs the real pinned collector,
+Primus/WebSocket plugins and collection against synthetic clients on an ephemeral
+`127.0.0.1` listener. Tests use temporary synthetic credential files and delete
+them after completion. The observed runner is Node 22.11.0; the test API requires
+a runtime providing `node:test`. This does not select the production runtime.
+
+The transport check uses the efsn message envelope without running a chain node.
+It exercises collector-to-viewer updates and graceful child-process shutdown,
+not PostgreSQL persistence, the HTTP read API, a browser, TLS or deployment.
+Dependency deprecation warnings are retained, not treated as an advisory audit.
+
+This patch validates authentication and basic envelope/body shapes. Complete
+field schemas, payload/rate/connection limits, login deadlines, stale-data
+display, dependency maintenance and deployment configuration still need their
+own acceptance checks before public hosting. Dashboard data remains self-reported
+and is not proof of chain agreement or ticket-purchase health.
diff --git a/lib/telemetry-credentials.js b/lib/telemetry-credentials.js
new file mode 100644
index 0000000..3cacff2
--- /dev/null
+++ b/lib/telemetry-credentials.js
@@ -0,0 +1,60 @@
+const { readFileSync } = require('node:fs');
+const { isAbsolute } = require('node:path');
+const { createHash, timingSafeEqual } = require('node:crypto');
+
+function loadTelemetryCredentials(environment) {
+    if (environment.WS_SECRET !== undefined) {
+        throw new Error('WS_SECRET is unsupported; configure WS_CREDENTIALS_FILE with per-node credentials');
+    }
+    const file = environment.WS_CREDENTIALS_FILE;
+    if (typeof file !== 'string' || !isAbsolute(file)) {
+        throw new Error('WS_CREDENTIALS_FILE must name an absolute credential file');
+    }
+    let configured;
+    try {
+        configured = JSON.parse(readFileSync(file, 'utf8'));
+    } catch (_) {
+        throw new Error('Cannot read valid telemetry credentials from WS_CREDENTIALS_FILE');
+    }
+    if (!configured || typeof configured !== 'object' || Array.isArray(configured) || Object.keys(configured).length === 0) {
+        throw new Error('Telemetry credentials must be a nonempty object keyed by node ID');
+    }
+    const credentials = new Map();
+    const used = new Set();
+    for (const [id, value] of Object.entries(configured)) {
+        if (!/^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$/.test(id)) {
+            throw new Error('Telemetry node IDs must be 1-64 letters, digits, dots, underscores or hyphens, starting with a letter or digit');
+        }
+        const secrets = Array.isArray(value) ? value : [value];
+        if (secrets.length < 1 || secrets.length > 2) {
+            throw new Error('Each telemetry node requires one credential or two during rotation');
+        }
+        const digests = [];
+        for (const secret of secrets) {
+            if (!validSecret(secret) || used.has(secret)) {
+                throw new Error('Telemetry credentials must be unique 32-256 character URL-safe tokens');
+            }
+            used.add(secret);
+            digests.push(digestSecret(secret));
+        }
+        credentials.set(id, digests);
+    }
+    return function matchesTelemetryCredential(id, secret) {
+        const expected = credentials.get(id);
+        if (!expected || !validSecret(secret)) {
+            return false;
+        }
+        const digest = digestSecret(secret);
+        return expected.some(value => timingSafeEqual(value, digest));
+    };
+}
+
+function validSecret(secret) {
+    return typeof secret === 'string' && /^[A-Za-z0-9_-]{32,256}$/.test(secret);
+}
+
+function digestSecret(secret) {
+    return createHash('sha256').update(secret, 'utf8').digest();
+}
+
+module.exports = loadTelemetryCredentials;
