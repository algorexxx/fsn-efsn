diff --git a/test/telemetry-credentials.test.cjs b/test/telemetry-credentials.test.cjs
new file mode 100644
index 0000000..69adfb6
--- /dev/null
+++ b/test/telemetry-credentials.test.cjs
@@ -0,0 +1,63 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { join } = require('node:path');
+const loadCredentials = require('../lib/telemetry-credentials');
+const { credentialFile, secretA, secretB, secretNext } = require('./fixtures/collector.cjs');
+
+test('credentials match only their assigned node and never coerce input', t => {
+    const file = credentialFile(t, { 'node-a': secretA, 'node-b': secretB });
+    const matches = loadCredentials({ WS_CREDENTIALS_FILE: file });
+    assert.equal(matches('node-a', secretA), true);
+    assert.equal(matches('node-b', secretB), true);
+    assert.equal(matches('node-b', secretA), false);
+    assert.equal(matches('unknown-node', secretA), false);
+    assert.equal(matches('node-a', [secretA]), false);
+    assert.equal(matches(['node-a'], secretA), false);
+});
+
+test('rotation accepts current and next credentials until old credential is removed on reload', t => {
+    const overlap = loadCredentials({ WS_CREDENTIALS_FILE: credentialFile(t, { 'node-a': [secretA, secretNext] }) });
+    const rotated = loadCredentials({ WS_CREDENTIALS_FILE: credentialFile(t, { 'node-a': secretNext }) });
+    assert.equal(overlap('node-a', secretA), true);
+    assert.equal(overlap('node-a', secretNext), true);
+    assert.equal(rotated('node-a', secretA), false);
+    assert.equal(rotated('node-a', secretNext), true);
+});
+
+for (const [name, value] of [
+    ['null', null], ['array', []], ['empty mapping', {}],
+    ['empty token', { 'node-a': '' }], ['whitespace token', { 'node-a': ' '.repeat(32) }],
+    ['short token', { 'node-a': 'short' }], ['oversized token', { 'node-a': 'x'.repeat(257) }],
+    ['URL delimiter', { 'node-a': secretA + '@' }], ['numeric token', { 'node-a': 1234 }],
+    ['no rotation entries', { 'node-a': [] }], ['empty rotation entry', { 'node-a': [secretA, ''] }],
+    ['three rotation entries', { 'node-a': [secretA, secretB, secretNext] }],
+    ['shared credential', { 'node-a': secretA, 'node-b': secretA }],
+    ['duplicate rotation credential', { 'node-a': [secretA, secretA] }],
+    ['invalid node name', { 'node a': secretA }], ['long node name', { ['x'.repeat(65)]: secretA }],
+]) {
+    test(`invalid credential configuration fails: ${name}`, t => {
+        const file = credentialFile(t, value);
+        assert.throws(() => loadCredentials({ WS_CREDENTIALS_FILE: file }), error => !error.message.includes(secretA));
+    });
+}
+
+test('invalid JSON does not reveal file contents through the error', t => {
+    const file = credentialFile(t, '{"node-a":"' + secretA, true);
+    assert.throws(() => loadCredentials({ WS_CREDENTIALS_FILE: file }), {
+        message: 'Cannot read valid telemetry credentials from WS_CREDENTIALS_FILE',
+    });
+});
+
+test('missing path, relative path and unreadable file fail closed', t => {
+    const file = credentialFile(t, { 'node-a': secretA });
+    assert.throws(() => loadCredentials({}));
+    assert.throws(() => loadCredentials({ WS_CREDENTIALS_FILE: 'relative.json' }));
+    assert.throws(() => loadCredentials({ WS_CREDENTIALS_FILE: join(file, 'missing.json') }));
+});
+
+test('legacy shared secret setting cannot silently override the identity mapping', t => {
+    const file = credentialFile(t, { 'node-a': secretA });
+    assert.throws(() => loadCredentials({ WS_CREDENTIALS_FILE: file, WS_SECRET: secretA }), {
+        message: 'WS_SECRET is unsupported; configure WS_CREDENTIALS_FILE with per-node credentials',
+    });
+});
diff --git a/test/telemetry-wire.test.cjs b/test/telemetry-wire.test.cjs
new file mode 100644
index 0000000..2cdf4fb
--- /dev/null
+++ b/test/telemetry-wire.test.cjs
@@ -0,0 +1,138 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { fork } = require('node:child_process');
+const { join } = require('node:path');
+const { once, EventEmitter } = require('node:events');
+const WebSocket = require('ws');
+const { credentialFile, secretA, secretB, secretNext } = require('./fixtures/collector.cjs');
+
+function connect(t, port, endpoint) {
+    const socket = new WebSocket(`ws://127.0.0.1:${port}/${endpoint}`);
+    const connection = { socket, messages: [], changed: new EventEmitter() };
+    socket.on('message', raw => {
+        const message = JSON.parse(raw.toString());
+        if (typeof message === 'string' && message.startsWith('primus::ping::')) {
+            socket.send(JSON.stringify(message.replace('primus::ping::', 'primus::pong::')));
+            return;
+        }
+        connection.messages.push(message);
+        connection.changed.emit('message');
+    });
+    socket.on('error', () => {});
+    connection.closed = once(socket, 'close');
+    t.after(() => socket.terminate());
+    connection.opened = once(socket, 'open');
+    return connection;
+}
+
+function waitMessage(connection, predicate, from = 0) {
+    return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => {
+            connection.changed.off('message', check);
+            reject(new Error('Expected collector message did not arrive'));
+        }, 3000);
+        function check() {
+            const message = connection.messages.slice(from).find(predicate);
+            if (!message) return;
+            clearTimeout(timer);
+            connection.changed.off('message', check);
+            resolve(message);
+        }
+        connection.changed.on('message', check);
+        check();
+    });
+}
+
+function send(connection, event, payload) {
+    connection.socket.send(JSON.stringify({ emit: [event, payload] }));
+}
+
+async function login(connection, id, secret) {
+    await connection.opened;
+    send(connection, 'hello', {
+        id, secret,
+        info: { name: id, node: 'efsn-test', port: 30303, net: '99032659', protocol: 'efsn/66', api: 'No', os: 'linux', os_v: 'amd64', client: '0.1.1', canUpdateHistory: true },
+    });
+    await waitMessage(connection, message => message.emit && message.emit[0] === 'ready');
+}
+
+async function inventory(viewer) {
+    const from = viewer.messages.length;
+    send(viewer, 'ready', {});
+    const response = await waitMessage(viewer, message => message.emit && message.emit[0] === 'init', from);
+    return response.emit[1].nodes;
+}
+
+test('real loopback collector preserves identity, rejects unowned updates and reconnects after disconnect', { timeout: 15000 }, async t => {
+    const file = credentialFile(t, { 'node-a': [secretA, secretNext], 'node-b': secretB });
+    const child = fork(join(__dirname, 'fixtures/wire-server.cjs'), [], {
+        env: { SystemRoot: process.env.SystemRoot, NODE_ENV: 'production', WS_CREDENTIALS_FILE: file, VERBOSITY: '2' },
+        stdio: ['ignore', 'pipe', 'pipe', 'ipc'],
+    });
+    let logs = '';
+    child.stdout.on('data', chunk => { logs += chunk; });
+    child.stderr.on('data', chunk => { logs += chunk; });
+    const exited = once(child, 'exit');
+    t.after(async () => {
+        if (child.exitCode === null && child.signalCode === null) child.kill();
+        await exited;
+    });
+    const [address] = await Promise.race([
+        once(child, 'message'),
+        exited.then(() => { throw new Error(`Collector exited before listening: ${logs}`); }),
+    ]);
+    assert.equal(address.address, '127.0.0.1');
+    const viewer = connect(t, address.port, 'primus');
+    await viewer.opened;
+    const owner = connect(t, address.port, 'api');
+    await login(owner, 'node-a', secretA);
+    const stats = { active: true, mining: true, syncing: false, hashrate: 0, peers: 1, gasPrice: 1, ticketNumber: 2, myTicketNumber: 1, uptime: 100 };
+    send(owner, 'stats', { id: 'node-a', stats });
+    await waitMessage(viewer, message => message.action === 'stats' && message.data.id === 'node-a');
+    assert.equal((await inventory(viewer))[0].stats.peers, 1);
+
+    const unauthenticated = connect(t, address.port, 'api');
+    await unauthenticated.opened;
+    send(unauthenticated, 'stats', { id: 'node-a', stats: { ...stats, peers: 9 } });
+    await unauthenticated.closed;
+    assert.equal((await inventory(viewer))[0].stats.peers, 1);
+
+    const wrongCredential = connect(t, address.port, 'api');
+    await wrongCredential.opened;
+    send(wrongCredential, 'hello', { id: 'node-b', secret: secretA, info: { name: 'node-b' } });
+    await wrongCredential.closed;
+    assert.deepEqual((await inventory(viewer)).map(node => node.id), ['node-a']);
+
+    const duplicate = connect(t, address.port, 'api');
+    await duplicate.opened;
+    send(duplicate, 'hello', { id: 'node-a', secret: secretNext, info: { name: 'node-a' } });
+    await duplicate.closed;
+    assert.equal((await inventory(viewer))[0].stats.active, true);
+
+    const other = connect(t, address.port, 'api');
+    await login(other, 'node-b', secretB);
+    send(other, 'stats', { id: 'node-a', stats: { ...stats, peers: 9 } });
+    await other.closed;
+    const afterRejectedUpdate = await inventory(viewer);
+    assert.equal(afterRejectedUpdate.find(node => node.id === 'node-a').stats.peers, 1);
+    assert.equal(afterRejectedUpdate.find(node => node.id === 'node-b').stats.active, false);
+
+    const from = viewer.messages.length;
+    owner.socket.close();
+    await owner.closed;
+    await waitMessage(viewer, message => message.action === 'inactive' && message.data.id === 'node-a', from);
+    const reconnected = connect(t, address.port, 'api');
+    await login(reconnected, 'node-a', secretNext);
+    send(reconnected, 'stats', { id: 'node-a', stats: { ...stats, peers: 2 } });
+    await waitMessage(viewer, message => message.action === 'stats' && message.data.id === 'node-a' && message.data.stats.peers === 2);
+    assert.equal((await inventory(viewer)).find(node => node.id === 'node-a').stats.peers, 2);
+
+    viewer.socket.close();
+    reconnected.socket.close();
+    await Promise.all([viewer.closed, reconnected.closed]);
+    child.send('stop');
+    const [code, signal] = await exited;
+    assert.equal(code, 0);
+    assert.equal(signal, null);
+    for (const secret of [secretA, secretB, secretNext]) assert.equal(logs.includes(secret), false);
+});
