diff --git a/react-frontend/src/snapshot-polling.js b/react-frontend/src/snapshot-polling.js
new file mode 100644
index 0000000..c0535cf
--- /dev/null
+++ b/react-frontend/src/snapshot-polling.js
@@ -0,0 +1,98 @@
+const prepareSnapshot = require('./snapshot-view');
+
+function startSnapshotPolling(config, dependencies) {
+    let stopped = false;
+    let request = null;
+    let pollTimer;
+    let deadlineTimer;
+    let expiryTimer;
+
+    function clearSnapshot() {
+        if (stopped) {
+            return;
+        }
+        dependencies.clearTimeout(expiryTimer);
+        dependencies.onUnavailable();
+    }
+
+    function finishRequest(current) {
+        if (stopped || request !== current) {
+            return false;
+        }
+        request = null;
+        dependencies.clearTimeout(deadlineTimer);
+        pollTimer = dependencies.setTimeout(poll, config.intervalMs);
+        return true;
+    }
+
+    function poll() {
+        if (stopped || request !== null) {
+            return;
+        }
+        const startedAt = dependencies.now();
+        let current;
+        try {
+            current = dependencies.request();
+        } catch (_) {
+            clearSnapshot();
+            pollTimer = dependencies.setTimeout(poll, config.intervalMs);
+            return;
+        }
+        request = current;
+        deadlineTimer = dependencies.setTimeout(() => {
+            if (finishRequest(current)) {
+                current.cancel();
+                clearSnapshot();
+            }
+        }, config.timeoutMs);
+        current.promise.then(response => {
+            if (stopped || request !== current) {
+                return;
+            }
+            const { validForMs, ...snapshot } = prepareSnapshot(response);
+            const remaining = validForMs - (dependencies.now() - startedAt);
+            if (remaining <= 0) {
+                throw new Error('Snapshot expired in transit');
+            }
+            finishRequest(current);
+            dependencies.clearTimeout(expiryTimer);
+            dependencies.onSnapshot(snapshot);
+            expiryTimer = dependencies.setTimeout(clearSnapshot, remaining);
+        }).catch(() => {
+            if (finishRequest(current)) {
+                clearSnapshot();
+            }
+        });
+    }
+
+    function refresh() {
+        if (stopped) {
+            return;
+        }
+        dependencies.clearTimeout(pollTimer);
+        dependencies.clearTimeout(deadlineTimer);
+        const previous = request;
+        request = null;
+        if (previous) {
+            previous.cancel();
+        }
+        clearSnapshot();
+        poll();
+    }
+
+    function stop() {
+        stopped = true;
+        dependencies.clearTimeout(pollTimer);
+        dependencies.clearTimeout(deadlineTimer);
+        dependencies.clearTimeout(expiryTimer);
+        if (request) {
+            request.cancel();
+            request = null;
+        }
+    }
+
+    poll();
+    return { refresh, stop };
+}
+
+module.exports = startSnapshotPolling;
diff --git a/react-frontend/src/snapshot-view.js b/react-frontend/src/snapshot-view.js
new file mode 100644
index 0000000..e5be468
--- /dev/null
+++ b/react-frontend/src/snapshot-view.js
@@ -0,0 +1,76 @@
+function object(value) {
+    return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function optionalNumber(value) {
+    if (value === undefined || value === null) {
+        return null;
+    }
+    if (!Number.isFinite(value) || value < 0) {
+        throw new Error('Invalid numeric report');
+    }
+    return value;
+}
+
+function readNode(row, observedAt) {
+    if (!object(row) || typeof row.id !== 'string' || row.utctime !== observedAt || typeof row.stats !== 'string') {
+        throw new Error('Invalid node row');
+    }
+    const node = JSON.parse(row.stats);
+    if (!object(node) || node.id !== row.id || !object(node.info) || typeof node.info.node !== 'string' ||
+        !object(node.stats) || !object(node.stats.block)) {
+        throw new Error('Invalid node report');
+    }
+    const block = node.stats.block;
+    if (!Number.isSafeInteger(block.number) || block.number < 0 || typeof block.hash !== 'string' ||
+        !/^0x[0-9a-fA-F]{64}$/.test(block.hash)) {
+        throw new Error('Invalid reported block');
+    }
+    for (const field of ['active', 'mining', 'syncing']) {
+        if (typeof node.stats[field] !== 'boolean') {
+            throw new Error('Invalid reported state');
+        }
+    }
+    for (const field of ['pending', 'myTicketNumber', 'peers', 'uptime', 'latency']) {
+        node.stats[field] = optionalNumber(node.stats[field]);
+    }
+    node.stats.block.received = optionalNumber(block.received);
+    node.stats.block.ticketNumber = optionalNumber(block.ticketNumber);
+    const geo = node.geo;
+    if (geo !== null && (!object(geo) || typeof geo.country !== 'string' || !/^[A-Z]{2}$/.test(geo.country) ||
+        !Array.isArray(geo.ll) || geo.ll.length !== 2 || !geo.ll.every(Number.isFinite) ||
+        Math.abs(geo.ll[0]) > 90 || Math.abs(geo.ll[1]) > 180)) {
+        node.geo = null;
+    }
+    return node;
+}
+
+function prepareSnapshot(response) {
+    const observedAt = response.headers && response.headers['x-dashboard-observed-at'];
+    const budget = response.headers && response.headers['x-dashboard-valid-for-ms'];
+    if (response.status !== 200 || typeof observedAt !== 'string' || !Number.isFinite(Date.parse(observedAt)) ||
+        new Date(observedAt).toISOString() !== observedAt || typeof budget !== 'string' ||
+        !/^(0|[1-9][0-9]*)$/.test(budget) || Number(budget) > 2147483647 || !Array.isArray(response.data)) {
+        throw new Error('Invalid snapshot response');
+    }
+    const nodesList = response.data.map(row => readNode(row, observedAt));
+    if (new Set(nodesList.map(node => node.id)).size !== nodesList.length) {
+        throw new Error('Duplicate node');
+    }
+    nodesList.sort((left, right) => right.stats.block.number - left.stats.block.number || left.id.localeCompare(right.id));
+    const activeNodes = nodesList.filter(node => node.stats.active);
+    const highest = activeNodes[0];
+    const geoCharts = nodesList.filter(node => node.geo !== null).map(node => ({
+        name: node.id, radius: 2, latitude: node.geo.ll[0], longitude: node.geo.ll[1], fillKey: 'bubbleFill',
+    }));
+    return {
+        observedAt, validForMs: Number(budget), nodesList, geoCharts,
+        totalNodes: nodesList.length, activeNodes: activeNodes.length,
+        highestBlock: highest ? highest.stats.block.number : null,
+        lastUpdatedBlock: highest ? highest.stats.block.received : null,
+        ticketNumber: highest ? highest.stats.block.ticketNumber : null,
+        pendingTransactions: highest ? highest.stats.pending : null,
+    };
+}
+
+module.exports = prepareSnapshot;
diff --git a/test/browser-snapshot.test.cjs b/test/browser-snapshot.test.cjs
new file mode 100644
index 0000000..2453be2
--- /dev/null
+++ b/test/browser-snapshot.test.cjs
@@ -0,0 +1,195 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const prepareSnapshot = require('../react-frontend/src/snapshot-view');
+const startSnapshotPolling = require('../react-frontend/src/snapshot-polling');
+const { loadPollingConfig } = require('../react-frontend/src/config');
+
+const observedAt = '2026-10-03T12:00:00.000Z';
+const hash = '0x' + '1'.repeat(64);
+
+function row(id, height, active = true) {
+    return { id, utctime: observedAt, stats: JSON.stringify({
+        id, info: { node: 'efsn/v5.0.0-local' }, geo: null,
+        stats: { active, mining: true, syncing: false, pending: 0, myTicketNumber: 0, peers: 0, uptime: 100, latency: 0,
+            block: { number: height, hash, received: 1791028799000, ticketNumber: 0 } },
+    }) };
+}
+
+function response(data = [], budget = '1000') {
+    return { status: 200, headers: { 'x-dashboard-observed-at': observedAt, 'x-dashboard-valid-for-ms': budget }, data };
+}
+
+function fixture() {
+    let time = 0;
+    let nextTimer = 0;
+    const timers = new Map();
+    const requests = [];
+    const states = [];
+    const polling = startSnapshotPolling({ intervalMs: 100, timeoutMs: 50 }, {
+        now: () => time,
+        setTimeout(callback, delay) { timers.set(++nextTimer, { callback, at: time + delay }); return nextTimer; },
+        clearTimeout(id) { timers.delete(id); },
+        request() {
+            let resolve, reject;
+            const promise = new Promise((yes, no) => { resolve = yes; reject = no; });
+            const request = { promise, resolve, reject, canceled: false, cancel() { this.canceled = true; } };
+            requests.push(request);
+            return request;
+        },
+        onSnapshot(snapshot) { states.push({ status: 'ready', snapshot }); },
+        onUnavailable() { states.push({ status: 'unavailable' }); },
+    });
+    function advance(milliseconds) {
+        const end = time + milliseconds;
+        while (true) {
+            const next = [...timers].sort((a, b) => a[1].at - b[1].at)[0];
+            if (!next || next[1].at > end) { break; }
+            time = next[1].at;
+            timers.delete(next[0]);
+            next[1].callback();
+        }
+        time = end;
+    }
+    return { polling, requests, states, timers, advance };
+}
+
+async function settle() {
+    await Promise.resolve();
+    await Promise.resolve();
+    await Promise.resolve();
+}
+
+test('browser timing settings require bounded explicit positive integers', () => {
+    assert.deepEqual(loadPollingConfig('100', '50'), { intervalMs: 100, timeoutMs: 50 });
+    for (const value of [undefined, '', '0', '-1', '1.5', '2147483648', '100x']) {
+        assert.throws(() => loadPollingConfig(value, '50'), /REACT_APP_STATS_POLL_INTERVAL_MS/);
+        assert.throws(() => loadPollingConfig('100', value), /REACT_APP_STATS_REQUEST_TIMEOUT_MS/);
+    }
+});
+
+test('snapshot summaries use current connected reports and preserve zeroes and full hashes', () => {
+    const result = prepareSnapshot(response([row('offline', 999, false), row('beta', 2), row('alpha', 1)]));
+    assert.deepEqual({ total: result.totalNodes, active: result.activeNodes, height: result.highestBlock,
+        received: result.lastUpdatedBlock, tickets: result.ticketNumber, pending: result.pendingTransactions,
+        ids: result.nodesList.map(node => node.id), hash: result.nodesList[1].stats.block.hash, geo: result.geoCharts },
+    { total: 3, active: 2, height: 2, received: 1791028799000, tickets: 0, pending: 0,
+        ids: ['offline', 'beta', 'alpha'], hash: '0x1111111111111111111111111111111111111111111111111111111111111111', geo: [] });
+});
+
+test('empty and disconnected snapshots do not invent current block, ticket or pending values', () => {
+    for (const data of [[], [row('offline', 42, false)]]) {
+        const result = prepareSnapshot(response(data));
+        assert.deepEqual([result.activeNodes, result.highestBlock, result.ticketNumber, result.pendingTransactions], [0, null, null, null]);
+    }
+});
+
+test('response validation rejects incomplete metadata, mixed observations and malformed rows', () => {
+    const invalid = [
+        { ...response(), status: 503 }, { ...response(), headers: {} }, response({}, '1000'), response([], '-1'),
+        response([], '2147483648'), response([{ ...row('alpha', 1), utctime: '2026-10-03T11:00:00.000Z' }]),
+        response([row('alpha', 1), row('alpha', 2)]), response([{ ...row('alpha', 1), stats: '{' }]),
+        response([{ ...row('alpha', 1), stats: JSON.stringify({}) }]),
+    ];
+    for (const value of invalid) { assert.throws(() => prepareSnapshot(value)); }
+});
+
+test('new snapshots replace nodes, geography and summary values even when height decreases', () => {
+    const first = row('alpha', 100);
+    const node = JSON.parse(first.stats);
+    node.geo = { country: 'SE', ll: [59, 18] };
+    first.stats = JSON.stringify(node);
+    const initial = prepareSnapshot(response([first]));
+    const replacement = prepareSnapshot(response([row('beta', 1)]));
+    assert.deepEqual(initial.geoCharts, [{ name: 'alpha', radius: 2, latitude: 59, longitude: 18, fillKey: 'bubbleFill' }]);
+    assert.deepEqual([replacement.nodesList.map(value => value.id), replacement.highestBlock, replacement.geoCharts], [['beta'], 1, []]);
+});
+
+test('HTTP failure clears a successful view, retries once and recovers with an empty snapshot', async () => {
+    const f = fixture();
+    f.requests[0].resolve(response([row('alpha', 1)]));
+    await settle();
+    f.advance(100);
+    f.requests[1].reject(new Error('HTTP 503'));
+    await settle();
+    f.advance(100);
+    f.requests[2].resolve(response());
+    await settle();
+    assert.deepEqual(f.states.map(state => state.status), ['ready', 'unavailable', 'ready']);
+    assert.deepEqual(f.states[2].snapshot.nodesList, []);
+    assert.equal(f.requests.length, 3);
+    f.polling.stop();
+});
+
+test('request timeout cancels work and late success cannot replace a newer response', async () => {
+    const f = fixture();
+    f.advance(50);
+    f.advance(100);
+    f.requests[1].resolve(response([row('beta', 2)]));
+    await settle();
+    f.requests[0].resolve(response([row('alpha', 1)]));
+    await settle();
+    assert.equal(f.requests[0].canceled, true);
+    assert.deepEqual(f.states.map(state => state.status), ['unavailable', 'ready']);
+    assert.equal(f.states[1].snapshot.nodesList[0].id, 'beta');
+    f.polling.stop();
+});
+
+test('snapshot expires during a pending poll after subtracting transport time', async () => {
+    const f = fixture();
+    f.advance(20);
+    f.requests[0].resolve(response([row('alpha', 1)], '150'));
+    await settle();
+    f.advance(100);
+    assert.equal(f.requests.length, 2);
+    f.advance(29);
+    assert.equal(f.states.at(-1).status, 'ready');
+    f.advance(1);
+    assert.deepEqual(f.states.map(state => state.status), ['ready', 'unavailable']);
+    f.polling.stop();
+});
+
+test('expired-in-transit and malformed successful responses clear data and retain retries', async () => {
+    const f = fixture();
+    f.advance(20);
+    f.requests[0].resolve(response([], '10'));
+    await settle();
+    f.advance(100);
+    f.requests[1].resolve({ status: 200, data: [] });
+    await settle();
+    f.advance(100);
+    assert.deepEqual(f.states, [{ status: 'unavailable' }, { status: 'unavailable' }]);
+    assert.equal(f.requests.length, 3);
+    f.polling.stop();
+});
+
+test('visibility refresh invalidates old data and cancels pending callbacks; stop removes timers', async () => {
+    const f = fixture();
+    f.requests[0].resolve(response([row('alpha', 1)]));
+    await settle();
+    f.advance(100);
+    f.polling.refresh();
+    f.requests[1].resolve(response([row('old', 99)]));
+    await settle();
+    f.requests[2].resolve(response([row('new', 2)]));
+    f.polling.stop();
+    await settle();
+    f.advance(10000);
+    assert.equal(f.requests[1].canceled, true);
+    assert.equal(f.requests[2].canceled, true);
+    assert.deepEqual(f.states.map(state => state.status), ['ready', 'unavailable']);
+    assert.equal(f.timers.size, 0);
+    assert.equal(f.requests.length, 3);
+});
+
+test('a synchronous request-adapter error becomes unavailable with one retry timer', () => {
+    const events = [];
+    const polling = startSnapshotPolling({ intervalMs: 100, timeoutMs: 50 }, {
+        now: () => 0,
+        request() { throw new Error('Request setup failed'); },
+        onUnavailable() { events.push('unavailable'); },
+        setTimeout(callback, delay) { events.push(delay); },
+        clearTimeout() {},
+    });
+    assert.deepEqual(events, ['unavailable', 100]);
+    polling.stop();
+});
