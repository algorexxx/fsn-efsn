diff --git a/react-frontend/src/pinned-nodes.js b/react-frontend/src/pinned-nodes.js
new file mode 100644
index 0000000..b6036a4
--- /dev/null
+++ b/react-frontend/src/pinned-nodes.js
@@ -0,0 +1,21 @@
+const storageKey = 'pinnedNodes';
+
+function readPinnedNodes() {
+    try {
+        const stored = JSON.parse(window.localStorage.getItem(storageKey));
+        return Array.isArray(stored) ? [...new Set(stored.filter(id => typeof id === 'string' && id.length > 0))] : [];
+    } catch (_) {
+        return [];
+    }
+}
+
+function writePinnedNodes(ids) {
+    try {
+        window.localStorage.setItem(storageKey, JSON.stringify(ids));
+        return true;
+    } catch (_) {
+        return false;
+    }
+}
+
+module.exports = {readPinnedNodes, writePinnedNodes};
diff --git a/react-frontend/src/pinned-nodes.test.js b/react-frontend/src/pinned-nodes.test.js
