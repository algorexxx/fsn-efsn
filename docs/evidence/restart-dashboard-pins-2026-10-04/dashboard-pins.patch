@@ -0,0 +1,87 @@
+const {readPinnedNodes, writePinnedNodes} = require('./pinned-nodes');
+
+afterEach(() => {
+    jest.restoreAllMocks();
+    localStorage.clear();
+});
+
+it.each([null, '{broken', '{}', '"alpha"', '17', 'false', 'null'])(
+    'returns no pins for a missing or invalid stored list: %s', value => {
+        const expected = [];
+        jest.spyOn(Storage.prototype, 'getItem').mockReturnValue(value);
+
+        const result = readPinnedNodes();
+
+        expect(result).toEqual(expected);
+    }
+);
+
+it('keeps unique nonempty string IDs from stored pins', () => {
+    const value = '["alpha",17,null,"beta","alpha","",{"id":"gamma"}]';
+    const expected = ['alpha', 'beta'];
+    jest.spyOn(Storage.prototype, 'getItem').mockReturnValue(value);
+
+    const result = readPinnedNodes();
+
+    expect(result).toEqual(expected);
+});
+
+it('returns no pins when browser storage access is denied', () => {
+    const expected = [];
+    jest.spyOn(window, 'localStorage', 'get').mockImplementation(() => { throw new DOMException('Denied', 'SecurityError'); });
+
+    const result = readPinnedNodes();
+
+    expect(result).toEqual(expected);
+});
+
+it('returns no pins when reading browser storage fails', () => {
+    const expected = [];
+    jest.spyOn(Storage.prototype, 'getItem').mockImplementation(() => { throw new Error('Cannot read'); });
+
+    const result = readPinnedNodes();
+
+    expect(result).toEqual(expected);
+});
+
+it('writes the selected IDs under the existing preference key', () => {
+    const value = ['alpha', 'beta'];
+    const expected = {saved: true, calls: [['pinnedNodes', '["alpha","beta"]']]};
+    const write = jest.spyOn(Storage.prototype, 'setItem').mockImplementation(() => {});
+
+    const saved = writePinnedNodes(value);
+    const result = {saved, calls: write.mock.calls};
+
+    expect(result).toEqual(expected);
+});
+
+it('writes an empty list after clearing the last pin', () => {
+    const value = [];
+    const expected = {saved: true, calls: [['pinnedNodes', '[]']]};
+    const write = jest.spyOn(Storage.prototype, 'setItem').mockImplementation(() => {});
+
+    const saved = writePinnedNodes(value);
+    const result = {saved, calls: write.mock.calls};
+
+    expect(result).toEqual(expected);
+});
+
+it('reports an unsaved change when the browser storage getter is denied', () => {
+    const value = ['alpha'];
+    const expected = false;
+    jest.spyOn(window, 'localStorage', 'get').mockImplementation(() => { throw new DOMException('Denied', 'SecurityError'); });
+
+    const result = writePinnedNodes(value);
+
+    expect(result).toEqual(expected);
+});
+
+it('reports an unsaved change when the browser quota is exceeded', () => {
+    const value = ['alpha'];
+    const expected = false;
+    jest.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new DOMException('Full', 'QuotaExceededError'); });
+
+    const result = writePinnedNodes(value);
+
+    expect(result).toEqual(expected);
+});
