+
+func stateSyncMissing(sched *trie.Sync, limit int) []common.Hash {
+	nodes, _, codes := sched.Missing(limit)
+	return append(nodes, codes...)
+}
+
+func loadStateSyncData(t *testing.T, db Database, hash common.Hash) []byte {
+	t.Helper()
+	data, err := db.TrieDB().Node(hash)
+	if err == nil {
+		return data
+	}
+	data = rawdb.ReadCodeWithPrefix(db.TrieDB().DiskDB(), hash)
+	if len(data) == 0 {
+		t.Fatalf("missing fixture node or code %x: %v", hash, err)
+	}
+	return data
+}
+
+func commitStateSync(t *testing.T, sched *trie.Sync, db ethdb.Database, results []trie.SyncResult) {
+	t.Helper()
+	for i, result := range results {
+		if err := sched.Process(result); err != nil {
+			t.Fatalf("failed to process result #%d: %v", i, err)
+		}
+	}
+	batch := db.NewBatch()
+	if err := sched.Commit(batch); err != nil {
+		t.Fatal(err)
+	}
+	if err := batch.Write(); err != nil {
+		t.Fatal(err)
+	}
+}
