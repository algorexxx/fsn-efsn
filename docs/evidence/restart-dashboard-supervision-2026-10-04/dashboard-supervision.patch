diff --git a/deploy/systemd/fsn-stats-api.service b/deploy/systemd/fsn-stats-api.service
new file mode 100644
index 0000000000000000000000000000000000000000..03d94028b4a2d1d2f0628ba939b27024b028edd2
--- /dev/null
+++ b/deploy/systemd/fsn-stats-api.service
@@ -0,0 +1,35 @@
+[Unit]
+Description=Fusion dashboard api
+After=network.target
+StartLimitIntervalSec=60s
+StartLimitBurst=5
+
+[Service]
+Type=exec
+DynamicUser=yes
+WorkingDirectory=/opt/fsn-stats/current
+ExecStart=/opt/fsn-stats/node/bin/node api-server/server.js
+Environment=NODE_ENV=production
+EnvironmentFile=/etc/fsn-stats/api.env
+LoadCredential=api.password:/etc/fsn-stats/credentials/api.password
+Environment=DB_PASSWORD_FILE=%d/api.password
+Restart=always
+RestartSec=5s
+TimeoutStopSec=15s
+KillMode=control-group
+UMask=0077
+NoNewPrivileges=yes
+ProtectSystem=strict
+ProtectHome=yes
+PrivateTmp=yes
+PrivateDevices=yes
+RestrictSUIDSGID=yes
+RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
+CapabilityBoundingSet=
+LimitCORE=0
+StandardOutput=journal
+StandardError=journal
+LogNamespace=fsn-stats
+
+[Install]
+WantedBy=multi-user.target
