[Unit]
Description=Fusion dashboard collector
After=network.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/mnt/c/Users/Peter/Documents/CODING/fsn-efsn/tmp/fsn-stats-auth
ExecStart=/mnt/c/Users/Peter/Documents/CODING/fsn-efsn/tmp/dashboard-runtime-review/v24.21.0/node server.js
Environment=NODE_ENV=production
EnvironmentFile=/home/rehearsal/fusion-dashboard-supervision-ralls4q1/collector.env
LoadCredential=telemetry.json:/home/rehearsal/fusion-dashboard-supervision-ralls4q1/telemetry.json
Environment=WS_CREDENTIALS_FILE=%d/telemetry.json
Restart=always
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
StandardOutput=journal
StandardError=journal
LogNamespace=fsn-stats-test-75c276d5

[Install]
WantedBy=multi-user.target
