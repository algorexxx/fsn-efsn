diff --git a/test/fixtures/efsn-browser.cjs b/test/fixtures/efsn-browser.cjs
new file mode 100644
index 0000000..65e5ce6
--- /dev/null
+++ b/test/fixtures/efsn-browser.cjs
@@ -0,0 +1,73 @@
+const assert = require('node:assert/strict');
+const { writeFileSync } = require('node:fs');
+const { join } = require('node:path');
+
+async function checkBrowser(url, head, controls) {
+    const { chromium } = require(process.env.EFSN_BROWSER_MODULE);
+    const browser = await chromium.launch({ channel: 'msedge', headless: true, chromiumSandbox: true });
+    const errors = [];
+    const foreignRequests = [];
+    const responses = [];
+    const checkpoints = [];
+    const output = process.env.EFSN_TELEMETRY_EVIDENCE;
+    try {
+        const context = await browser.newContext({ viewport: { width: 1440, height: 1000 } });
+        const page = await context.newPage();
+        page.on('pageerror', error => errors.push(error.message));
+        page.on('response', response => {
+            if (response.url().endsWith('/stats-api/nodes')) {
+                responses.push(response.status());
+            }
+        });
+        await context.route('**/*', route => {
+            if (new URL(route.request().url()).origin !== url) {
+                foreignRequests.push(route.request().url());
+                return route.abort();
+            }
+            return route.continue();
+        });
+        await page.goto(url, { waitUntil: 'domcontentloaded' });
+        await page.getByRole('button', { name: 'Pin node-a', exact: true }).waitFor();
+        const headers = await page.locator('thead th').allTextContents();
+        assert.deepEqual(headers, ['Pin', 'Connected', 'Location', 'Node / Reports', 'Type', 'Height', 'Block Received', 'Pending Txs', 'Tickets', 'Mining', 'Peers', 'Last Latency']);
+        const row = page.locator('tbody tr');
+        assert.equal(await row.count(), 1);
+        assert.equal(await row.locator('td').count(), headers.length);
+        assert.match(await row.locator('td').nth(5).innerText(), /# 60/);
+        assert.ok((await row.locator('td').nth(5).innerText()).includes(head.hash.slice(0, 6) + ' … ' + head.hash.slice(-4)));
+        assert.equal(await row.locator('td').nth(7).innerText(), '0');
+        assert.equal(await row.locator('td').nth(8).innerText(), '2');
+        assert.equal(await row.locator('td').nth(10).innerText(), '0');
+        assert.equal(await page.locator('[role="progressbar"]').count(), 0);
+        checkpoints.push({ name: 'actual-head', headers, row: await row.innerText() });
+        await page.screenshot({ path: join(output, 'browser-actual.png'), fullPage: true });
+        await page.getByRole('button', { name: 'Pin node-a', exact: true }).click();
+        await page.getByRole('button', { name: 'Unpin node-a', exact: true }).waitFor();
+        assert.equal(await row.locator('td').count(), headers.length);
+        assert.equal(await row.locator('td').nth(10).innerText(), '0');
+        assert.equal(await page.locator('[role="progressbar"]').count(), 0);
+        checkpoints.push({ name: 'pinned-actual-head', row: await row.innerText() });
+        await controls.stopCollection();
+        await page.getByText('Dashboard data unavailable or expired. Retrying automatically.', { exact: false }).waitFor({ timeout: 15000 });
+        assert.equal(await page.locator('tbody tr').count(), 0);
+        assert.equal((await page.locator('body').innerText()).includes('# 60'), false);
+        const duringOutage = await controls.readHead();
+        assert.equal(duringOutage.hash, head.hash);
+        checkpoints.push({ name: 'stopped-writer-expired', directHead: duringOutage.hash, text: await page.locator('[aria-live="polite"]').innerText() });
+        await page.screenshot({ path: join(output, 'browser-expired.png'), fullPage: true });
+        controls.resumeCollection();
+        await page.getByRole('button', { name: 'Unpin node-a', exact: true }).waitFor();
+        assert.equal(await row.count(), 1);
+        assert.match(await row.locator('td').nth(5).innerText(), /# 60/);
+        checkpoints.push({ name: 'writer-recovered', row: await row.innerText() });
+        assert.deepEqual(errors, []);
+        assert.deepEqual(foreignRequests, []);
+        assert.ok(responses.includes(503) && responses[responses.length - 1] === 200);
+        return { browser: browser.version(), checkpoints, errors, foreignRequests, responses };
+    } finally {
+        writeFileSync(join(output, 'browser-checkpoints.json'), JSON.stringify({ checkpoints, errors, foreignRequests, responses }, null, 2) + '\n', 'utf8');
+        await browser.close();
+    }
+}
+
+module.exports = checkBrowser;
