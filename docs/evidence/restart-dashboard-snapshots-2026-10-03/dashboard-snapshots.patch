diff --git a/db/schema/001-dashboard.sql b/db/schema/001-dashboard.sql
new file mode 100644
index 0000000..4ced315
--- /dev/null
+++ b/db/schema/001-dashboard.sql
@@ -0,0 +1,12 @@
+BEGIN;
+CREATE SCHEMA dashboard_v1;
+CREATE TABLE dashboard_v1.snapshot (
+    singleton boolean PRIMARY KEY CHECK (singleton),
+    observed_at timestamptz NOT NULL CHECK (isfinite(observed_at)),
+    payload jsonb NOT NULL CHECK (
+        (jsonb_typeof(payload) = 'object'
+         AND jsonb_typeof(payload->'nodes') = 'array'
+         AND jsonb_typeof(payload->'charts') = 'object') IS TRUE
+    )
+);
+COMMIT;
