diff --git a/api-server/app.js b/api-server/app.js
new file mode 100644
index 0000000..9649153
--- /dev/null
+++ b/api-server/app.js
@@ -0,0 +1,31 @@
+const express = require('express');
+
+function createApp(retrieve, now, maximumAgeMs) {
+    const app = express();
+    const views = {
+        '/nodes': snapshot => snapshot.payload.nodes.map(node => ({ id: node.id, utctime: snapshot.observed_at, block: node.stats.block.number, stats: JSON.stringify(node), info: JSON.stringify(node.info) })),
+        '/blocks': snapshot => snapshot.payload.nodes.map(node => ({ id: node.id, utctime: snapshot.observed_at, blocks: JSON.stringify(node.stats.block) })),
+        '/info': snapshot => snapshot.payload.nodes.map(node => ({ id: node.id, utctime: snapshot.observed_at, info: JSON.stringify(node.info) })),
+        '/charts': snapshot => [{ utctime: snapshot.observed_at, charts: JSON.stringify(snapshot.payload.charts) }],
+    };
+    for (const [path, project] of Object.entries(views)) {
+        app.get(path, async (request, response) => {
+            response.set('Cache-Control', 'no-store');
+            try {
+                const snapshot = await retrieve.readSnapshot();
+                const age = snapshot ? now() - snapshot.observed_at.getTime() : NaN;
+                if (!Number.isFinite(age) || age < 0 || age > maximumAgeMs) {
+                    response.status(503).json({ error: 'snapshot_unavailable' });
+                    return;
+                }
+                response.set('X-Dashboard-Observed-At', snapshot.observed_at.toISOString());
+                response.json(project(snapshot));
+            } catch (_) {
+                response.status(503).json({ error: 'snapshot_unavailable' });
+            }
+        });
+    }
+    return app;
+}
+
+module.exports = createApp;
