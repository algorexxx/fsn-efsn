+++ b/test/fixtures/wire-client.cjs
@@ -0,0 +1,61 @@
+const { once, EventEmitter } = require('node:events');
+const WebSocket = require('ws');
+
+function connect(t, port, endpoint) {
+    const socket = new WebSocket(`ws://127.0.0.1:${port}/${endpoint}`);
+    const connection = { socket, messages: [], changed: new EventEmitter() };
+    socket.on('message', raw => {
+        const message = JSON.parse(raw.toString());
+        if (typeof message === 'string' && message.startsWith('primus::ping::')) {
+            socket.send(JSON.stringify(message.replace('primus::ping::', 'primus::pong::')));
+            return;
+        }
+        connection.messages.push(message);
+        connection.changed.emit('message');
+    });
+    socket.on('error', () => {});
+    connection.closed = once(socket, 'close');
+    t.after(() => socket.terminate());
+    connection.opened = once(socket, 'open');
+    return connection;
+}
+
+function waitMessage(connection, predicate, from = 0) {
+    return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => {
+            connection.changed.off('message', check);
+            reject(new Error('Expected collector message did not arrive'));
+        }, 3000);
+        function check() {
+            const message = connection.messages.slice(from).find(predicate);
+            if (!message) return;
+            clearTimeout(timer);
+            connection.changed.off('message', check);
+            resolve(message);
+        }
+        connection.changed.on('message', check);
+        check();
+    });
+}
+
+function send(connection, event, payload) {
+    connection.socket.send(JSON.stringify({ emit: [event, payload] }));
+}
+
+async function login(connection, id, secret, extraInfo = {}) {
+    await connection.opened;
+    send(connection, 'hello', {
+        id, secret,
+        info: { name: id, node: 'efsn-test', port: 30303, net: '99032659', protocol: 'efsn/66', api: 'No', os: 'linux', os_v: 'amd64', client: '0.1.1', canUpdateHistory: true, ...extraInfo },
+    });
+    await waitMessage(connection, message => message.emit && message.emit[0] === 'ready');
+}
+
+async function inventory(viewer) {
+    const from = viewer.messages.length;
+    send(viewer, 'ready', {});
+    const response = await waitMessage(viewer, message => message.emit && message.emit[0] === 'init', from);
+    return response.emit[1].nodes;
+}
+
+module.exports = { connect, waitMessage, send, login, inventory };
