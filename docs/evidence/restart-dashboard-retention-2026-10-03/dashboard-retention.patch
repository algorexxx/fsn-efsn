+        number, hash: '0x' + (number * 100 + fork).toString(16).padStart(64, '0'),
+        parentHash: '0x' + '0'.repeat(64), miner: '0x' + '1'.repeat(40),
+        transactionsRoot: '0x' + '2'.repeat(64), stateRoot: '0x' + '3'.repeat(64),
