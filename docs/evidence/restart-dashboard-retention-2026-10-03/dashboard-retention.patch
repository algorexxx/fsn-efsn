diff --git a/lib/telemetry-report.js b/lib/telemetry-report.js
index 2406047..aa5b119 100644
--- a/lib/telemetry-report.js
+++ b/lib/telemetry-report.js
@@ -6,19 +6,49 @@ function count(value) {
     return Number.isSafeInteger(value) && value >= 0;
 }
 
+function hex(value, digits) {
+    return typeof value === 'string' && value.length === digits + 2 && /^0x[0-9a-fA-F]+$/.test(value);
+}
+
+function difficulty(value) {
+    return count(value) || (typeof value === 'string' && value.length <= 78 && /^(0|[1-9][0-9]*)$/.test(value));
+}
+
+function quantity(value, digits) {
+    return typeof value === 'string' && value.length <= digits + 2 && /^0x(0|[1-9a-fA-F][0-9a-fA-F]*)$/.test(value);
+}
+
+function uncle(value) {
+    return object(value)
+        && ['hash', 'parentHash', 'sha3Uncles', 'stateRoot', 'transactionsRoot', 'receiptsRoot', 'mixHash'].every(field => hex(value[field], 64))
+        && hex(value.miner, 40) && hex(value.logsBloom, 512) && hex(value.nonce, 16)
+        && ['difficulty', 'number'].every(field => quantity(value[field], 64))
+        && ['gasLimit', 'gasUsed', 'timestamp'].every(field => quantity(value[field], 16))
+        && BigInt(value.gasUsed) <= BigInt(value.gasLimit)
+        && typeof value.extraData === 'string' && /^0x([0-9a-fA-F]{2})*$/.test(value.extraData)
+        && (value.baseFeePerGas == null || quantity(value.baseFeePerGas, 64));
+}
+
 function isTelemetryReport(kind, value) {
     if (!object(value)) {
         return false;
     }
     if (kind === 'block') {
-        return count(value.number) && typeof value.hash === 'string' && /^0x[0-9a-fA-F]{64}$/.test(value.hash)
-            && Array.isArray(value.transactions) && Array.isArray(value.uncles) && value.difficulty !== undefined;
+        return count(value.number) && count(value.timestamp) && value.timestamp <= Math.floor(Number.MAX_SAFE_INTEGER / 1000)
+            && ['hash', 'parentHash', 'transactionsRoot', 'stateRoot'].every(field => hex(value[field], 64))
+            && (value.sha3Uncles === undefined || hex(value.sha3Uncles, 64)) && hex(value.miner, 40)
+            && count(value.gasLimit) && count(value.gasUsed) && value.gasUsed <= value.gasLimit
+            && difficulty(value.difficulty) && difficulty(value.totalDifficulty)
+            && ['ticketNumber', 'myTicketNumber'].every(field => value[field] == null || count(value[field]))
+            && Array.isArray(value.transactions) && value.transactions.every(tx => object(tx) && hex(tx.hash, 64))
+            && Array.isArray(value.uncles) && value.uncles.every(uncle);
     }
     if (kind === 'pending') {
         return count(value.pending);
     }
-    return ['active', 'mining', 'syncing'].every(field => typeof value[field] === 'boolean')
-        && count(value.peers) && Number.isFinite(value.uptime) && value.uptime >= 0 && value.uptime <= 100
+    return kind === 'stats' && ['active', 'mining', 'syncing'].every(field => typeof value[field] === 'boolean')
+        && ['peers', 'gasPrice', 'hashrate'].every(field => count(value[field]))
+        && Number.isFinite(value.uptime) && value.uptime >= 0 && value.uptime <= 100
         && ['ticketNumber', 'myTicketNumber'].every(field => value[field] == null || count(value[field]));
 }
 
