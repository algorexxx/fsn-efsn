+}
+
+function stats() {
+    return { active: true, mining: true, syncing: false, peers: 1, uptime: 100, ticketNumber: null, myTicketNumber: null, gasPrice: 0, hashrate: 0 };
+}
+
+function uncle() {
+    return {
+        hash: '0x' + '1'.repeat(64), parentHash: '0x' + '2'.repeat(64), sha3Uncles: '0x' + '3'.repeat(64),
+        miner: '0x' + '4'.repeat(40), stateRoot: '0x' + '5'.repeat(64), transactionsRoot: '0x' + '6'.repeat(64),
+        receiptsRoot: '0x' + '7'.repeat(64), logsBloom: '0x' + '0'.repeat(512),
+        difficulty: '0x1', number: '0x1', gasLimit: '0x100', gasUsed: '0x0', timestamp: '0x1',
+        extraData: '0x', mixHash: '0x' + '8'.repeat(64), nonce: '0x' + '0'.repeat(16), baseFeePerGas: null,
+    };
+}
+
+module.exports = { block, stats, uncle };
