diff --git a/test/telemetry-report.test.cjs b/test/telemetry-report.test.cjs
new file mode 100644
index 0000000..eb8fcc1
--- /dev/null
+++ b/test/telemetry-report.test.cjs
@@ -0,0 +1,116 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const isTelemetryReport = require('../lib/telemetry-report');
+const History = require('../lib/history');
+const Collection = require('../lib/collection');
+const { block, stats, uncle } = require('./fixtures/telemetry-report.cjs');
+
+function collection(t) {
+    const value = new Collection({ write() {} }, () => 1000);
+    value.add({ id: 'node-a', info: {}, ip: '127.0.0.1', spark: 'a' }, () => {});
+    t.after(() => { if (value._debounced) { value._debounced.cancel(); } });
+    return value;
+}
+
+test('complete efsn reports accept decimal difficulty, zero counters and unavailable ticket counts', () => {
+    const reports = [block(0), block(), { ...block(), difficulty: 1, totalDifficulty: 2 }, { ...block(), difficulty: '9'.repeat(78), totalDifficulty: '9'.repeat(78), ticketNumber: null, myTicketNumber: undefined }, { ...block(), uncles: [uncle()] }];
+
+    const result = reports.map(value => isTelemetryReport('block', value));
+
+    assert.deepEqual(result, [true, true, true, true, true]);
+    assert.equal(isTelemetryReport('stats', stats()), true);
+    assert.equal(isTelemetryReport('pending', { pending: 0 }), true);
+    assert.equal(isTelemetryReport('unknown', stats()), false);
+});
+
+test('missing and malformed block fields are rejected before arithmetic or chart retention', () => {
+    const invalid = [
+        { parentHash: undefined }, { parentHash: '0x1' }, { transactionsRoot: null }, { stateRoot: [] },
+        { miner: 'miner-a' }, { timestamp: undefined }, { timestamp: Number.MAX_SAFE_INTEGER },
+        { gasLimit: -1 }, { gasUsed: 101 }, { gasUsed: 0.5 }, { gasUsed: Number.MAX_SAFE_INTEGER + 1 },
+        { difficulty: {} }, { difficulty: '1e3' }, { difficulty: '01' }, { difficulty: '9'.repeat(79) },
+        { totalDifficulty: undefined }, { totalDifficulty: Infinity }, { totalDifficulty: '-1' },
+        { transactions: [null] }, { transactions: [{ hash: '0x1' }] }, { transactions: ['0x' + '1'.repeat(64)] },
+        { ticketNumber: '1' }, { myTicketNumber: -1 }, { sha3Uncles: {} }, { uncles: [null] },
+    ];
+
+    const accepted = invalid.filter(fields => isTelemetryReport('block', { ...block(), ...fields }));
+
+    assert.deepEqual(accepted, []);
+});
+
+test('uncle headers validate their retained wire fields without assuming Fusion uncles are impossible', () => {
+    const invalid = [{ hash: undefined }, { logsBloom: '0x' }, { difficulty: {} }, { number: '0x01' }, { timestamp: '0x' }, { gasLimit: '0x' + '1'.repeat(17) }, { extraData: '0x1' }, { nonce: null }, { baseFeePerGas: -1 }];
+
+    const accepted = invalid.filter(fields => isTelemetryReport('block', { ...block(), uncles: [{ ...uncle(), ...fields }] }));
+
+    assert.deepEqual(accepted, []);
+});
+
+test('stats require every numeric field that the dashboard stores', () => {
+    const invalid = [{ gasPrice: undefined }, { gasPrice: {} }, { gasPrice: -1 }, { hashrate: undefined }, { hashrate: '0' }, { hashrate: Infinity }, { peers: Number.MAX_SAFE_INTEGER + 1 }, { myTicketNumber: 1.1 }, { uptime: NaN }];
+
+    const accepted = invalid.filter(fields => isTelemetryReport('stats', { ...stats(), ...fields }));
+
+    assert.deepEqual(accepted, []);
+});
+
+test('invalid complete and combined reports leave all accepted state and receipts unchanged', t => {
+    const value = collection(t);
+    value.update('node-a', { ...stats(), block: block(), pending: 0 }, () => {});
+    const before = JSON.stringify({ nodes: value._items, cache: value.getHistory()._items });
+    const errors = [];
+
+    value.addBlock('node-a', { ...block(101), gasUsed: {} }, error => errors.push(error));
+    value.updateStats('node-a', { ...stats(), hashrate: {} }, error => errors.push(error));
+    value.update('node-a', { ...stats(), gasPrice: {}, block: block(101), pending: 1 }, error => errors.push(error));
+
+    assert.deepEqual(errors, ['Invalid block report', 'Invalid stats report', 'Invalid combined report']);
+    assert.equal(JSON.stringify({ nodes: value._items, cache: value.getHistory()._items }), before);
+});
+
+test('invalid or oversized history batches cannot clear the outstanding request or partially populate history', t => {
+    const value = collection(t);
+    const errors = [];
+    value.askedForHistory(true);
+
+    value.addHistory('node-a', [block(100), { ...block(99), timestamp: {} }], error => errors.push(error));
+    value.addHistory('node-a', Array.from({ length: 51 }, (_, index) => block(index + 1)), error => errors.push(error));
+
+    assert.deepEqual(errors, ['Invalid history report', 'Invalid history report']);
+    assert.deepEqual(value.getHistory()._items, []);
+    assert.equal(value._askedForHistory, true);
+});
+
+test('chart records retain counts and fixed scalar fields while the current head keeps transaction hashes and timing', t => {
+    const value = collection(t);
+    const input = { ...block(), transactions: [{ hash: '0x' + 'a'.repeat(64) }, { hash: '0x' + 'b'.repeat(64) }], uncles: [uncle()], extension: { value: 'unneeded chart data' } };
+    let charts;
+    value.getHistory().setCallback((error, result) => { charts = result; });
+
+    value.addBlock('node-a', input, () => {});
+    value.getHistory().getCharts();
+    const cached = value.getHistory().search(100).block;
+    const current = value.getNode({ id: 'node-a' }).stats.block;
+
+    assert.deepEqual({ transactions: charts.transactions, uncles: charts.uncles }, { transactions: [2], uncles: [1] });
+    assert.deepEqual({ transactions: cached.transactionCount, uncles: cached.uncleCount, arrays: [cached.transactions, cached.uncles], extension: cached.extension }, { transactions: 2, uncles: 1, arrays: [undefined, undefined], extension: undefined });
+    assert.equal(Object.values(cached).every(item => item === undefined || item === null || ['number', 'string', 'boolean'].includes(typeof item)), true);
+    assert.deepEqual(current.transactions, [{ hash: '0x' + 'a'.repeat(64) }, { hash: '0x' + 'b'.repeat(64) }]);
+    assert.deepEqual(current.uncles, [uncle()]);
+    assert.deepEqual({ arrived: current.arrived, received: current.received, propagation: current.propagation, time: current.time, trusted: current.trusted, fork: current.fork }, { arrived: 1000, received: 1000, propagation: 0, time: 0, trusted: false, fork: 0 });
+    assert.notEqual(cached, current);
+});
+
+test('mutating a caller report after ingestion cannot alter cached fork identity or counts', () => {
+    const history = new History(() => 1000);
+    const input = { ...block(), transactions: [{ hash: '0x' + 'a'.repeat(64) }] };
+    history.add(input, 'node-a', true);
+    const before = JSON.stringify(history._items);
+
+    input.hash = '0x' + 'f'.repeat(64);
+    input.transactions.push({ hash: '0x' + 'b'.repeat(64) });
+
+    assert.equal(JSON.stringify(history._items), before);
+    assert.deepEqual(history.getTransactionsCount(), [1]);
+});
