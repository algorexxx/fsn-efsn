diff --git a/lib/geoip-dataset.js b/lib/geoip-dataset.js
new file mode 100644
index 0000000..a1bae96
--- /dev/null
+++ b/lib/geoip-dataset.js
@@ -0,0 +1,156 @@
+const fs = require('node:fs');
+const path = require('node:path');
+const {createHash} = require('node:crypto');
+const {isUtf8} = require('node:buffer');
+
+const formats = [
+    {name: 'geoip-city-names.dat', size: 88, addressBytes: 0},
+    {name: 'geoip-country.dat', size: 10, addressBytes: 4},
+    {name: 'geoip-country6.dat', size: 34, addressBytes: 16},
+    {name: 'geoip-city.dat', size: 24, addressBytes: 4},
+    {name: 'geoip-city6.dat', size: 48, addressBytes: 16},
+];
+
+function validateGeoipDataset(directory, maxBytes) {
+    if (typeof directory !== 'string' || !path.isAbsolute(directory)) {
+        throw new Error('GeoIP directory must be an absolute path');
+    }
+    if (!Number.isSafeInteger(maxBytes) || maxBytes <= 0) {
+        throw new Error('GeoIP byte limit must be a positive safe integer');
+    }
+    const resolved = fs.realpathSync(directory);
+    const opened = [];
+    try {
+        openDataset(resolved, maxBytes, opened);
+        const locationCount = Number(opened[0].stat.size) / formats[0].size;
+        const files = Object.fromEntries(opened.map(file => [file.name, inspectFile(file, locationCount)]));
+        verifyUnchanged(directory, resolved, opened);
+        return {directory: resolved, files};
+    } finally {
+        for (const file of opened) {
+            fs.closeSync(file.fd);
+        }
+    }
+}
+
+function openDataset(directory, maxBytes, opened) {
+    let total = 0n;
+    for (const format of formats) {
+        const filename = path.join(directory, format.name);
+        if (!fs.lstatSync(filename).isFile()) {
+            throw new Error(`${format.name}: expected a regular file without a symlink`);
+        }
+        const fd = fs.openSync(filename, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
+        const file = {...format, filename, fd};
+        opened.push(file);
+        file.stat = fs.fstatSync(fd, {bigint: true});
+        total += file.stat.size;
+        if (!file.stat.isFile() || file.stat.size === 0n || file.stat.size % BigInt(file.size) !== 0n) {
+            throw new Error(`${format.name}: expected nonempty aligned records`);
+        }
+        if (total > BigInt(maxBytes)) {
+            throw new Error('GeoIP dataset exceeds the configured byte limit');
+        }
+    }
+}
+
+function inspectFile(file, locationCount) {
+    const bytes = Number(file.stat.size);
+    const chunk = Buffer.alloc(file.size * 1024);
+    const hash = createHash('sha256');
+    let previousEnd = null;
+    for (let position = 0; position < bytes; position += chunk.length) {
+        const length = Math.min(chunk.length, bytes - position);
+        readChunk(file, chunk, position, length);
+        hash.update(chunk.subarray(0, length));
+        for (let offset = 0; offset < length; offset += file.size) {
+            const record = chunk.subarray(offset, offset + file.size);
+            const label = `${file.name} record ${(position + offset) / file.size}`;
+            if (file.addressBytes === 0) {
+                validateLocation(record, label);
+            } else {
+                previousEnd = validateRange(record, file.addressBytes, previousEnd, label);
+                validateRangeData(record, file.addressBytes, locationCount, label);
+            }
+        }
+    }
+    return {bytes, records: bytes / file.size, sha256: hash.digest('hex')};
+}
+
+function readChunk(file, chunk, position, length) {
+    let filled = 0;
+    while (filled < length) {
+        const count = fs.readSync(file.fd, chunk, filled, length - filled, position + filled);
+        if (count === 0) {
+            throw new Error(`${file.name}: file changed or ended during validation`);
+        }
+        filled += count;
+    }
+}
+
+function validateLocation(record, label) {
+    validateCountry(record.subarray(0, 2), true, label);
+    if (record.readInt32BE(5) < 0 || ![0, 48, 49].includes(record[9])) {
+        throw new Error(`${label}: invalid location metadata`);
+    }
+    for (const field of [record.subarray(2, 5), record.subarray(10, 42), record.subarray(42, 88)]) {
+        const end = field.indexOf(0);
+        if (!isUtf8(end === -1 ? field : field.subarray(0, end))) {
+            throw new Error(`${label}: invalid UTF-8 location field`);
+        }
+    }
+}
+
+function validateCountry(country, allowEmpty, label) {
+    if (allowEmpty && country[0] === 0 && country[1] === 0) {
+        return;
+    }
+    if (!country.every(value => value >= 65 && value <= 90)) {
+        throw new Error(`${label}: invalid country code`);
+    }
+}
+
+function validateRange(record, width, previousEnd, label) {
+    const first = width === 4 ? BigInt(record.readUInt32BE(0)) : record.readBigUInt64BE(0);
+    const last = width === 4 ? BigInt(record.readUInt32BE(4)) : record.readBigUInt64BE(16);
+    if (first > last) {
+        throw new Error(`${label}: reversed address range`);
+    }
+    if (width === 16 && (record.readBigUInt64BE(8) !== 0n || record.readBigUInt64BE(24) !== 0xffffffffffffffffn)) {
+        throw new Error(`${label}: IPv6 bounds exceed the reader's 64-bit precision`);
+    }
+    if (previousEnd !== null && first <= previousEnd) {
+        throw new Error(`${label}: address ranges overlap or are unsorted`);
+    }
+    return last;
+}
+
+function validateRangeData(record, width, locationCount, label) {
+    const offset = width * 2;
+    if (record.length === offset + 2) {
+        validateCountry(record.subarray(offset), false, label);
+        return;
+    }
+    const location = record.readUInt32BE(offset);
+    if (location !== 0xffffffff && location >= locationCount) {
+        throw new Error(`${label}: location reference is outside the names file`);
+    }
+    if (Math.abs(record.readInt32BE(offset + 4)) > 900000 || Math.abs(record.readInt32BE(offset + 8)) > 1800000 || record.readInt32BE(offset + 12) < 0) {
+        throw new Error(`${label}: invalid coordinates or accuracy radius`);
+    }
+}
+
+function verifyUnchanged(directory, resolved, opened) {
+    if (fs.realpathSync(directory) !== resolved) {
+        throw new Error('GeoIP directory changed during validation');
+    }
+    for (const file of opened) {
+        const current = fs.lstatSync(file.filename, {bigint: true});
+        const handle = fs.fstatSync(file.fd, {bigint: true});
+        if (!current.isFile() || ['dev', 'ino', 'size', 'mtimeNs', 'ctimeNs'].some(key => current[key] !== file.stat[key] || handle[key] !== file.stat[key])) {
+            throw new Error(`${file.name}: file changed during validation`);
+        }
+    }
+}
+
+module.exports = validateGeoipDataset;
