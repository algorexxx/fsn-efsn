+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const {spawnSync} = require('node:child_process');
+const validateGeoipDataset = require('../lib/geoip-dataset');
+const fixture = require('./fixtures/geoip-data.json');
+
+function writeDataset(t) {
+    const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'fsn-geoip-'));
+    t.after(() => fs.rmSync(directory, {recursive: true, force: true}));
+    for (const [name, record] of Object.entries(fixture)) {
+        fs.writeFileSync(path.join(directory, name), Buffer.from(record.hex, 'hex'));
+    }
+    return directory;
+}
+
+function readValidation(directory, limit) {
+    try {
+        return validateGeoipDataset(directory, limit);
+    } catch (error) {
+        return {error: error.message};
+    }
+}
+
+test('validates the independently encoded complete fixture at the exact byte limit', t => {
+    const directory = writeDataset(t);
+    const expected = {directory: fs.realpathSync(directory), files: Object.fromEntries(Object.entries(fixture).map(([name, {bytes, records, sha256}]) => [name, {bytes, records, sha256}]))};
+
+    const result = validateGeoipDataset(directory, 204);
+
+    assert.deepEqual(result, expected);
+});
+
+for (const directory of [undefined, '', '.', 'relative/data']) {
+    test(`requires an absolute dataset directory: ${directory}`, () => {
+        const expected = {error: 'GeoIP directory must be an absolute path'};
+
+        const result = readValidation(directory, 204);
+
+        assert.deepEqual(result, expected);
+    });
+}
+
+for (const limit of [undefined, 0, -1, 1.5, Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+    test(`requires an explicit safe byte limit: ${limit}`, t => {
+        const directory = writeDataset(t);
+        const expected = {error: 'GeoIP byte limit must be a positive safe integer'};
+
+        const result = readValidation(directory, limit);
+
+        assert.deepEqual(result, expected);
+    });
+}
+
+test('rejects a dataset over budget before inspecting records', t => {
+    const directory = writeDataset(t);
+    const expected = {error: 'GeoIP dataset exceeds the configured byte limit'};
+
+    const result = readValidation(directory, 203);
+
+    assert.deepEqual(result, expected);
+});
+
+for (const name of Object.keys(fixture)) {
+    test(`requires ${name}`, t => {
+        const directory = writeDataset(t);
+        fs.unlinkSync(path.join(directory, name));
+        const expected = 'ENOENT';
+
+        const result = readValidation(directory, 204).error.split(':')[0];
+
+        assert.equal(result, expected);
+    });
+    for (const mode of ['empty', 'truncated']) {
+        test(`rejects ${mode} ${name}`, t => {
+            const directory = writeDataset(t);
+            fs.truncateSync(path.join(directory, name), mode === 'empty' ? 0 : fixture[name].bytes - 1);
+            const expected = {error: `${name}: expected nonempty aligned records`};
+
+            const result = readValidation(directory, 204);
+
+            assert.deepEqual(result, expected);
+        });
+    }
+}
+
+for (const type of ['directory', 'symlink']) {
+    test(`rejects a ${type} in place of a dataset file`, t => {
+        const directory = writeDataset(t);
+        const file = path.join(directory, 'geoip-city.dat');
+        fs.unlinkSync(file);
+        if (type === 'directory') fs.mkdirSync(file);
+        else fs.symlinkSync(path.join(directory, 'geoip-city6.dat'), file);
+        const expected = {error: 'geoip-city.dat: expected a regular file without a symlink'};
+
+        const result = readValidation(directory, 204);
+
+        assert.deepEqual(result, expected);
+    });
+}
+
+const invalidRecords = [
+    ['geoip-country.dat', b => b.writeUInt32BE(0xc0000300, 0), 'reversed address range'],
+    ['geoip-country6.dat', b => b.writeBigUInt64BE(0x20010db900000000n, 0), 'reversed address range'],
+    ['geoip-country6.dat', b => { b[15] = 1; }, "IPv6 bounds exceed the reader's 64-bit precision"],
+    ['geoip-city6.dat', b => { b[31] = 254; }, "IPv6 bounds exceed the reader's 64-bit precision"],
+    ['geoip-country.dat', b => { b[8] = 110; }, 'invalid country code'],
+    ['geoip-country6.dat', b => { b[32] = 0; }, 'invalid country code'],
+    ['geoip-city-names.dat', b => { b[1] = 0; }, 'invalid country code'],
+    ['geoip-city-names.dat', b => { b[9] = 50; }, 'invalid location metadata'],
+    ['geoip-city-names.dat', b => b.writeInt32BE(-1, 5), 'invalid location metadata'],
+    ['geoip-city-names.dat', b => { b[42] = 255; }, 'invalid UTF-8 location field'],
+    ['geoip-city-names.dat', b => { b[2] = 255; }, 'invalid UTF-8 location field'],
+    ['geoip-city-names.dat', b => { b[10] = 255; }, 'invalid UTF-8 location field'],
+    ['geoip-city.dat', b => b.writeUInt32BE(1, 8), 'location reference is outside the names file'],
+    ['geoip-city6.dat', b => b.writeUInt32BE(1, 32), 'location reference is outside the names file'],
+    ['geoip-city.dat', b => b.writeInt32BE(900001, 12), 'invalid coordinates or accuracy radius'],
+    ['geoip-city.dat', b => b.writeInt32BE(-900001, 12), 'invalid coordinates or accuracy radius'],
+    ['geoip-city6.dat', b => b.writeInt32BE(1800001, 40), 'invalid coordinates or accuracy radius'],
+    ['geoip-city6.dat', b => b.writeInt32BE(-1800001, 40), 'invalid coordinates or accuracy radius'],
+    ['geoip-city.dat', b => b.writeInt32BE(-1, 20), 'invalid coordinates or accuracy radius'],
+];
+for (const [index, [name, edit, reason]] of invalidRecords.entries()) {
+    test(`rejects invalid record ${index}: ${reason}`, t => {
+        const directory = writeDataset(t);
+        const record = Buffer.from(fixture[name].hex, 'hex');
+        edit(record);
+        fs.writeFileSync(path.join(directory, name), record);
+        const expected = {error: `${name} record 0: ${reason}`};
+
+        const result = readValidation(directory, 204);
+
+        assert.deepEqual(result, expected);
+    });
+}
+
+for (const name of ['geoip-country.dat', 'geoip-country6.dat', 'geoip-city.dat', 'geoip-city6.dat']) {
+    test(`rejects overlapping ranges in ${name}`, t => {
+        const directory = writeDataset(t);
+        fs.appendFileSync(path.join(directory, name), Buffer.from(fixture[name].hex, 'hex'));
+        const expected = {error: `${name} record 1: address ranges overlap or are unsorted`};
+
+        const result = readValidation(directory, 1000);
+
+        assert.deepEqual(result, expected);
+    });
+}
+
+test('checks ordering across chunk boundaries', t => {
+    const directory = writeDataset(t);
+    const records = Buffer.alloc(1025 * 10);
+    for (let index = 0; index < 1025; index++) {
+        const value = 0xc0000200 + Math.min(index, 1023);
+        records.writeUInt32BE(value, index * 10);
+        records.writeUInt32BE(value, index * 10 + 4);
+        records.write('NO', index * 10 + 8);
+    }
+    fs.writeFileSync(path.join(directory, 'geoip-country.dat'), records);
+    const expected = {error: 'geoip-country.dat record 1024: address ranges overlap or are unsorted'};
+
+    const result = readValidation(directory, 20000);
+
+    assert.deepEqual(result, expected);
+});
+
+for (const [name, offset] of [['geoip-city.dat', 8], ['geoip-city6.dat', 32]]) {
+    test(`recognizes the defined no-location sentinel in ${name}`, t => {
+        const directory = writeDataset(t);
+        const record = Buffer.from(fixture[name].hex, 'hex');
+        record.writeUInt32BE(0xffffffff, offset);
+        fs.writeFileSync(path.join(directory, name), record);
+        const expected = 1;
+
+        const result = validateGeoipDataset(directory, 204).files[name].records;
+
+        assert.equal(result, expected);
+    });
+}
+
+test('preserves a structurally valid unknown location country', t => {
+    const directory = writeDataset(t);
+    const record = Buffer.from(fixture['geoip-city-names.dat'].hex, 'hex');
+    record.fill(0, 0, 2);
+    fs.writeFileSync(path.join(directory, 'geoip-city-names.dat'), record);
+    const expected = 1;
+
+    const result = validateGeoipDataset(directory, 204).files['geoip-city-names.dat'].records;
+
+    assert.equal(result, expected);
+});
+
+test('rejects a file modified during validation', t => {
+    const directory = writeDataset(t);
+    const read = fs.readSync;
+    let changed = false;
+    t.mock.method(fs, 'readSync', (...args) => {
+        const count = read(...args);
+        if (!changed) {
+            changed = true;
+            const filename = path.join(directory, 'geoip-city-names.dat');
+            const bytes = fs.readFileSync(filename);
+            bytes[42] = 90;
+            fs.writeFileSync(filename, bytes);
+        }
+        return count;
+    });
+    const expected = {error: 'geoip-city-names.dat: file changed during validation'};
+
+    const result = readValidation(directory, 204);
+
+    assert.deepEqual(result, expected);
+});
+
+test('CLI emits only the manifest on success', t => {
+    const directory = writeDataset(t);
+    const command = path.resolve(__dirname, '../deploy/validate-geoip.cjs');
+    const expected = {status: 0, stderr: '', directory: fs.realpathSync(directory)};
+
+    const child = spawnSync(process.execPath, [command, directory, '204'], {encoding: 'utf8', timeout: 10000});
+    const result = {status: child.status, stderr: child.stderr, directory: JSON.parse(child.stdout).directory};
+
+    assert.deepEqual(result, expected);
+});
+
+test('CLI rejects invalid argument counts without reading a dataset', () => {
+    const command = path.resolve(__dirname, '../deploy/validate-geoip.cjs');
+    const expected = {status: 1, stdout: '', stderr: 'GeoIP validation failed: Usage: node deploy/validate-geoip.cjs ABSOLUTE_DATA_DIRECTORY MAX_DATASET_BYTES\n'};
+
+    const child = spawnSync(process.execPath, [command], {encoding: 'utf8', timeout: 10000});
+    const result = {status: child.status, stdout: child.stdout, stderr: child.stderr};
+
+    assert.deepEqual(result, expected);
+});
