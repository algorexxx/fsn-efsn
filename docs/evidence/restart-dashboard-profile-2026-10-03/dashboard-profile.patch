+test('unexpected transport close is reported once without raw reason data and still reconnects', t => {
+    const fixture = setup(t);
+    const old = fixture.connections[0];
+    old.onopen();
+
+    old.onclose({ code: 1009, reason: 'private transport detail' });
+    old.onclose({ code: 1009, reason: 'private transport detail' });
+    fixture.tick();
+
+    assert.deepEqual(fixture.errors, ['Collector connection closed unexpectedly']);
+    assert.deepEqual(fixture.writes, []);
+    assert.equal(fixture.connections.length, 2);
+    assert.equal(fixture.timers.size, 1);
+});
+
+test('transport error is reported once and its subsequent close is not reported twice', t => {
+    const fixture = setup(t);
+    const old = fixture.connections[0];
+    old.onopen();
+
+    old.onerror(new Error('private transport detail'));
+    old.onerror(new Error('private transport detail'));
+    old.onclose();
+
+    assert.deepEqual(fixture.errors, ['Collector connection failed']);
+    assert.deepEqual(fixture.writes, []);
+    assert.equal(old.closed, true);
+    assert.deepEqual([...fixture.timers.values()].map(timer => timer.delay), [100]);
 });
