diff --git a/test/fixtures/profile-wire-server.cjs b/test/fixtures/profile-wire-server.cjs
new file mode 100644
index 0000000..8117fc7
--- /dev/null
+++ b/test/fixtures/profile-wire-server.cjs
@@ -0,0 +1,85 @@
+const { monitorEventLoopDelay } = require('node:perf_hooks');
+const WebSocket = require('ws');
+const Collection = require('../../lib/collection');
+
+let collection;
+const add = Collection.prototype.add;
+Collection.prototype.add = function (...args) {
+    collection = this;
+    return add.apply(this, args);
+};
+
+const records = [];
+const peaks = { rss: 0, heapUsed: 0, external: 0, arrayBuffers: 0 };
+const loop = monitorEventLoopDelay({ resolution: 20 });
+let samples = 0;
+let rejectedWrites = 0;
+let largestWrite = 0;
+let baseline;
+loop.enable();
+
+function sample() {
+    const memory = process.memoryUsage();
+    samples++;
+    for (const key of Object.keys(peaks)) {
+        peaks[key] = Math.max(peaks[key], memory[key]);
+    }
+}
+
+function capture(direction, path, raw) {
+    if (records.length >= 1000) {
+        throw new Error('Profile fixture message limit exceeded');
+    }
+    const message = JSON.parse(raw.toString());
+    const event = typeof message === 'string' ? 'control' : (message.emit ? message.emit[0] : message.action);
+    records.push({ direction, path, event, bytes: Buffer.byteLength(raw) });
+    sample();
+}
+
+const upgrade = WebSocket.Server.prototype.handleUpgrade;
+WebSocket.Server.prototype.handleUpgrade = function (request, connection, head, complete) {
+    return upgrade.call(this, request, connection, head, socket => {
+        socket.on('message', raw => capture('incoming', request.url, raw));
+        const send = socket.send;
+        socket.send = function (data, ...options) {
+            capture('outgoing', request.url, data);
+            return send.call(this, data, ...options);
+        };
+        complete(socket);
+    });
+};
+
+const server = require('../../server');
+server.on('connection', socket => {
+    const write = socket.write;
+    socket.write = function (data, ...options) {
+        largestWrite = Math.max(largestWrite, Buffer.byteLength(data));
+        const wasDestroyed = socket.destroyed;
+        const result = write.call(this, data, ...options);
+        if (!wasDestroyed && socket.destroyed) {
+            rejectedWrites++;
+        }
+        sample();
+        return result;
+    };
+});
+server.on('listening', () => {
+    baseline = process.memoryUsage();
+    loop.reset();
+    sample();
+    process.send(server.address());
+});
+const timer = setInterval(sample, 25);
+process.on('message', message => {
+    if (message === 'stop') {
+        clearInterval(timer);
+        loop.disable();
+        server.close(() => process.exit(0));
+    }
+    if (message === 'inspect') {
+        const items = collection.getHistory()._items;
+        sample();
+        process.send({ records, samples, baseline, sampledPeaks: peaks, current: process.memoryUsage(), largestWrite, rejectedWrites, eventLoopDelayMs: { mean: loop.mean / 1e6, max: loop.max / 1e6, p99: loop.percentile(99) / 1e6 }, cache: { heights: items.length, variants: items.reduce((sum, item) => sum + item.forks.length, 0), retainedArrays: items.reduce((sum, item) => sum + item.forks.filter(fork => fork.transactions || fork.uncles).length, 0) }, nodes: collection.all().map(node => ({ id: node.id, height: node.stats.block.number, transactions: node.stats.block.transactions.length, reports: node.reports, connected: node.uptime.lastStatus })) });
+    }
+});
+setTimeout(() => process.exit(2), 45000).unref();
