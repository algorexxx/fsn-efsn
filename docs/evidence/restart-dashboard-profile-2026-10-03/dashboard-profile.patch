+++ b/test/dashboard-profile.test.cjs
@@ -0,0 +1,170 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { readFileSync, writeFileSync } = require('node:fs');
+const { join } = require('node:path');
+const { once } = require('node:events');
+const { performance } = require('node:perf_hooks');
+const { Pool } = require('pg');
+const WebSocket = require('websocket').w3cwebsocket;
+const startCollector = require('./fixtures/collector-wire.cjs');
+const { connect, login, send, waitMessage } = require('./fixtures/wire-client.cjs');
+const { block, stats } = require('./fixtures/telemetry-report.cjs');
+const request = require('./fixtures/http.cjs');
+const Populate = require('../db_methods/populate');
+const Retrieve = require('../db_methods/retrieve');
+const startSnapshotCollection = require('../wsclient/collect-snapshots');
+const createApp = require('../api-server/app');
+
+const profiles = {
+    'small-snapshot': { nodes: 2, inputBytes: 4194304, outputBytes: 1048576, snapshotBytes: 65536, succeeds: false },
+    'small-output': { nodes: 8, inputBytes: 4194304, outputBytes: 262144, snapshotBytes: 1048576, succeeds: false },
+    'aligned': { nodes: 8, inputBytes: 4194304, outputBytes: 1048576, snapshotBytes: 1048576, succeeds: true },
+};
+const profile = profiles[process.env.DASHBOARD_PROFILE];
+if (!profile || !process.env.DASHBOARD_PROFILE_EVIDENCE || !process.env.TEST_PG_PORT || !process.env.TEST_PG_PASSWORD_FILE) {
+    throw new Error('Explicit profile, evidence path and disposable database settings required');
+}
+
+function busyBlock(number) {
+    return { ...block(number), timestamp: 1700000000 + number * 120, miner: '0x7E5F4552091A69125d5DfCb7b8C2659029395Bdf', difficulty: '3', totalDifficulty: String(number * 3), gasLimit: 15000000, gasUsed: 14994000, ticketNumber: 2, myTicketNumber: undefined, transactions: Array.from({ length: 714 }, (_, index) => ({ hash: '0x' + (number * 1000 + index).toString(16).padStart(64, '0') })) };
+}
+
+async function waitFor(read, predicate) {
+    const deadline = Date.now() + 6000;
+    while (Date.now() < deadline) {
+        const result = await read();
+        if (predicate(result)) {
+            return result;
+        }
+        await new Promise(resolve => setTimeout(resolve, 50));
+    }
+    throw new Error('Expected bounded profile state did not arrive');
+}
+
+test('bounded dashboard profile: ' + process.env.DASHBOARD_PROFILE, { timeout: 40000 }, async t => {
+    const credentials = Object.fromEntries(Array.from({ length: profile.nodes }, (_, index) => ['profile-' + index, 'synthetic-profile-credential-' + String(index).padStart(16, '0')]));
+    const server = await startCollector(t, { COLLECTOR_MAX_MESSAGE_BYTES: String(profile.inputBytes), COLLECTOR_MAX_BUFFERED_BYTES: String(profile.outputBytes), COLLECTOR_HELLO_TIMEOUT_MS: '5000' }, 'profile-wire-server.cjs', credentials);
+    const pool = new Pool({ host: '127.0.0.1', port: Number(process.env.TEST_PG_PORT), database: 'postgres', user: 'dashboard_test_admin', password: readFileSync(process.env.TEST_PG_PASSWORD_FILE, 'utf8'), connectionTimeoutMillis: 2000, statement_timeout: 2000, query_timeout: 2000 });
+    t.after(() => pool.end());
+    await pool.query(readFileSync(join(__dirname, '../db/schema/001-dashboard.sql'), 'utf8'));
+    const populate = new Populate(pool);
+    const retrieve = new Retrieve(pool);
+    const reporters = await Promise.all(Object.entries(credentials).map(async ([id, secret]) => {
+        const connection = connect(t, server.port, 'api');
+        await login(connection, id, secret, { node: 'profile-version-' + id });
+        return { id, connection };
+    }));
+    const errors = [];
+    const closes = [];
+    const saves = [];
+    const config = { url: `ws://127.0.0.1:${server.port}/primus`, intervalMs: 250, timeoutMs: 1500, maxBytes: profile.snapshotBytes, maxNodes: profile.nodes };
+    let collector;
+    t.after(() => collector && collector.stop());
+    let apiTime;
+    const api = createApp(retrieve, () => apiTime === undefined ? Date.now() : apiTime, 5000, 30000).listen(0, '127.0.0.1');
+    t.after(() => new Promise(resolve => api.close(resolve)));
+    await once(api, 'listening');
+    const evidence = { profile, scope: 'Synthetic telemetry only; no efsn process, executed transactions, chain database or real key. Eight-report concurrency is a bounded fixture, not a production capacity promise.', batches: [], errors, closes, saves };
+    t.after(() => writeFileSync(join(process.env.DASHBOARD_PROFILE_EVIDENCE, 'profile.json'), JSON.stringify(evidence, null, 2) + '\n', 'utf8'));
+
+    async function report(number, history) {
+        const head = busyBlock(number);
+        const started = performance.now();
+        await Promise.all(reporters.map(async ({ id, connection }, index) => {
+            const from = connection.messages.length;
+            send(connection, 'block', { id, block: head });
+            send(connection, 'stats', { id, stats: { ...stats(), peers: index, ticketNumber: 2, myTicketNumber: 1 } });
+            send(connection, 'pending', { id, stats: { pending: index } });
+            if (history) {
+                send(connection, 'history', { id, history });
+            }
+            send(connection, 'node-ping', { id, clientTime: 'batch-' + number });
+            await waitMessage(connection, message => message.emit && message.emit[0] === 'node-pong' && message.emit[1].clientTime === 'batch-' + number, from);
+        }));
+        evidence.batches.push({ number, historyBlocksPerReporter: history ? history.length : 0, acknowledgementMs: performance.now() - started });
+    }
+
+    await report(1000, Array.from({ length: 50 }, (_, index) => busyBlock(999 - index)));
+    evidence.beforeSnapshot = await server.command('inspect');
+    collector = startSnapshotCollection(config, {
+        connect(url, maxBytes) {
+            const socket = new WebSocket(url, undefined, undefined, undefined, undefined, { maxReceivedFrameSize: maxBytes, maxReceivedMessageSize: maxBytes });
+            socket.addEventListener('close', event => closes.push({ code: event.code, reason: event.reason }));
+            return socket;
+        },
+        async saveSnapshot(payload, observedAt) {
+            const started = performance.now();
+            await populate.saveSnapshot(payload, observedAt);
+            saves.push({ bytes: Buffer.byteLength(JSON.stringify(payload)), elapsedMs: performance.now() - started, heights: payload.nodes.map(node => node.stats.block.number) });
+        },
+        now: () => new Date(), setTimeout, clearTimeout, onError: message => errors.push(message),
+    });
+    if (!profile.succeeds) {
+        await waitFor(() => closes, values => values.length > 0);
+        await collector.stop();
+        assert.equal(await retrieve.readSnapshot(), null);
+        const response = await request(api.address().port, '/nodes');
+        assert.equal(response.status, 503);
+        assert.deepEqual(saves, []);
+        assert.deepEqual(errors, ['Collector connection closed unexpectedly']);
+        evidence.unavailableStatus = response.status;
+    } else {
+        for (const number of [1000, 1001, 1002, 1003]) {
+            if (number > 1000) {
+                await report(number, number === 1001 ? Array.from({ length: 50 }, (_, index) => busyBlock(1000 - index)) : undefined);
+            }
+            const snapshot = await waitFor(() => retrieve.readSnapshot(), value => value && value.payload.nodes.length === profile.nodes && value.payload.nodes.every(node => node.stats.block.number === number));
+            assert.deepEqual(snapshot.payload.charts.transactions, Array(40).fill(714));
+            assert.deepEqual(snapshot.payload.charts.height, Array.from({ length: 40 }, (_, index) => number - 39 + index));
+        }
+        const responses = {};
+        for (const path of ['/nodes', '/blocks', '/charts']) {
+            const started = performance.now();
+            const response = await request(api.address().port, path);
+            assert.equal(response.status, 200);
+            responses[path] = { bytes: Number(response.headers['content-length']), elapsedMs: performance.now() - started };
+            assert.equal(responses[path].bytes, Buffer.byteLength(JSON.stringify(response.body)));
+            if (path === '/nodes') {
+                for (const [index, reporter] of reporters.entries()) {
+                    const row = response.body.find(value => value.id === reporter.id);
+                    const node = JSON.parse(row.stats);
+                    assert.equal(node.info.node, 'profile-version-' + reporter.id);
+                    assert.equal(node.stats.peers, index);
+                    assert.equal(node.stats.pending, index);
+                    assert.deepEqual(node.stats.block.transactions, busyBlock(1003).transactions);
+                    assert.equal(Object.values(row.reportValidForMs).every(value => value > 0), true);
+                }
+            }
+            if (path === '/blocks') {
+                assert.equal(response.body.length, profile.nodes);
+                for (const row of response.body) {
+                    assert.deepEqual(JSON.parse(row.blocks).transactions, busyBlock(1003).transactions);
+                }
+            }
+        }
+        evidence.http = responses;
+        assert.deepEqual(closes, []);
+        await collector.stop();
+        const snapshot = await retrieve.readSnapshot();
+        apiTime = snapshot.observed_at.getTime() + 5001;
+        const expired = await request(api.address().port, '/nodes');
+        assert.equal(expired.status, 503);
+        evidence.expiredStatus = expired.status;
+        assert.deepEqual(errors, []);
+        assert.ok(saves.length >= 4);
+    }
+    evidence.collector = await server.command('inspect');
+    assert.equal(evidence.collector.nodes.length, profile.nodes);
+    assert.equal(evidence.collector.nodes.every(node => node.connected && node.transactions === 714 && Object.values(node.reports).every(value => Number.isSafeInteger(value))), true);
+    assert.equal(evidence.collector.cache.retainedArrays, 0);
+    const histories = evidence.collector.records.filter(record => record.direction === 'incoming' && record.event === 'history');
+    assert.equal(histories.length, profile.nodes * (profile.succeeds ? 2 : 1));
+    assert.equal(histories.every(record => record.bytes > 2 * 1024 * 1024 && record.bytes < profile.inputBytes), true);
+    assert.equal(evidence.collector.rejectedWrites > 0, process.env.DASHBOARD_PROFILE === 'small-output');
+    evidence.driverMemory = process.memoryUsage();
+    for (const { connection } of reporters) {
+        connection.socket.close();
+    }
+    await Promise.all(reporters.map(({ connection }) => connection.closed));
+    await server.stop();
+});
