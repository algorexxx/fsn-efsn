diff --git a/test/collector-output-wire.test.cjs b/test/collector-output-wire.test.cjs
new file mode 100644
index 0000000..f6e9e15
--- /dev/null
+++ b/test/collector-output-wire.test.cjs
@@ -0,0 +1,75 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const startCollector = require('./fixtures/collector-wire.cjs');
+const { secretA } = require('./fixtures/collector.cjs');
+const { connect, login, send, inventory, waitMessage } = require('./fixtures/wire-client.cjs');
+
+async function waitForWrites(server, port, expected) {
+    for (let attempt = 0; attempt < 40; attempt++) {
+        const state = await server.command({ action: 'inspect', port });
+        if (state.writes >= expected) {
+            return state;
+        }
+        await new Promise(resolve => setTimeout(resolve, 25));
+    }
+    throw new Error('Expected bounded fixture writes did not arrive');
+}
+
+test('held output disconnects only the slow telemetry session and its identity can reconnect', { timeout: 15000 }, async t => {
+    const server = await startCollector(t, { COLLECTOR_MAX_BUFFERED_BYTES: '8192' }, 'output-wire-server.cjs');
+    const viewer = connect(t, server.port, 'primus');
+    await viewer.opened;
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA);
+    const port = owner.socket._socket.localPort;
+    await server.command({ action: 'cork', port });
+    for (let index = 0; index < 2; index++) {
+        send(owner, 'node-ping', { id: 'node-a', clientTime: 'x'.repeat(3000) });
+    }
+    const held = await waitForWrites(server, port, 2);
+    assert.ok(held.queued > 6000 && held.queued <= 8192);
+    assert.equal(held.destroyed, false);
+    send(owner, 'node-ping', { id: 'node-a', clientTime: 'x'.repeat(3000) });
+    assert.equal((await owner.closed)[0], 1006);
+    const stopped = await server.command({ action: 'inspect', port });
+    assert.equal(stopped.destroyed, true);
+    assert.ok(stopped.peak <= 8192);
+    await waitMessage(viewer, message => message.action === 'inactive');
+    assert.equal((await inventory(viewer))[0].uptime.lastStatus, false);
+    const replacement = connect(t, server.port, 'api');
+    await login(replacement, 'node-a', secretA);
+    send(replacement, 'node-ping', { id: 'node-a', clientTime: 'recovered' });
+    await waitMessage(replacement, message => message.emit && message.emit[0] === 'node-pong' && message.emit[1].clientTime === 'recovered');
+    assert.equal((await inventory(viewer))[0].uptime.lastStatus, true);
+    t.diagnostic(JSON.stringify({ held, stopped }));
+    viewer.socket.close();
+    replacement.socket.close();
+    await Promise.all([viewer.closed, replacement.closed]);
+    await server.stop();
+});
+
+test('Primus and WebSocket control replies share the same output budget on every collector path', { timeout: 15000 }, async t => {
+    const server = await startCollector(t, { COLLECTOR_MAX_BUFFERED_BYTES: '512', COLLECTOR_HELLO_TIMEOUT_MS: '5000' }, 'output-wire-server.cjs');
+    for (const endpoint of ['api', 'primus', 'external']) {
+        const connection = connect(t, server.port, endpoint);
+        await connection.opened;
+        const port = connection.socket._socket.localPort;
+        await server.command({ action: 'cork', port });
+        connection.socket.send(JSON.stringify('primus::id::'));
+        const protocol = await waitForWrites(server, port, 1);
+        assert.ok(protocol.queued > 0 && protocol.queued < 128);
+        for (let index = 0; index < 3; index++) {
+            connection.socket.ping(Buffer.alloc(125));
+        }
+        const held = await waitForWrites(server, port, 4);
+        assert.equal(held.queued, protocol.queued + 381);
+        assert.equal(held.destroyed, false);
+        connection.socket.ping(Buffer.alloc(125));
+        assert.equal((await connection.closed)[0], 1006);
+        const stopped = await server.command({ action: 'inspect', port });
+        assert.equal(stopped.destroyed, true);
+        assert.ok(stopped.peak <= 512);
+        t.diagnostic(JSON.stringify({ endpoint, protocol, held, stopped }));
+    }
+    await server.stop();
+});
diff --git a/test/collector-output.test.cjs b/test/collector-output.test.cjs
new file mode 100644
index 0000000..829271c
--- /dev/null
+++ b/test/collector-output.test.cjs
@@ -0,0 +1,101 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { Writable } = require('node:stream');
+const { EventEmitter, once } = require('node:events');
+const limitCollectorOutput = require('../lib/collector-output');
+const { loadCollector } = require('./fixtures/collector.cjs');
+
+function stream(t, server) {
+    const writes = [];
+    const socket = new Writable({ highWaterMark: 4, write(chunk, encoding, callback) { writes.push(chunk.toString('hex')); callback(); } });
+    socket.on('error', () => {});
+    socket.cork();
+    server.emit('connection', socket);
+    t.after(() => socket.destroy());
+    return { socket, writes };
+}
+
+test('the exact queue budget accepts buffers and multibyte strings with native backpressure', async t => {
+    const server = new EventEmitter();
+    limitCollectorOutput(server, 8);
+    const { socket, writes } = stream(t, server);
+    const callbacks = [];
+
+    const accepted = [socket.write(Buffer.from('abcd'), error => callbacks.push(error ? error.message : 'ok')), socket.write('ÅÅ', 'utf8', error => callbacks.push(error ? error.message : 'ok'))];
+    const queued = socket.writableLength;
+    socket.uncork();
+    await new Promise(resolve => socket.end(resolve));
+
+    assert.deepEqual({ accepted, queued, writes, callbacks }, { accepted: [false, false], queued: 8, writes: ['61626364', 'c385c385'], callbacks: ['ok', 'ok'] });
+});
+
+test('one byte above the budget closes only that stream before enqueueing the new write', async t => {
+    const server = new EventEmitter();
+    limitCollectorOutput(server, 8);
+    const a = stream(t, server);
+    const b = stream(t, server);
+    a.socket.write(Buffer.alloc(8));
+    const closed = once(a.socket, 'close');
+    let result;
+
+    const error = await new Promise(resolve => { result = a.socket.write(Buffer.alloc(1), resolve); });
+    await closed;
+    b.socket.write('ok');
+    const other = { queued: b.socket.writableLength, destroyed: b.socket.destroyed };
+    b.socket.uncork();
+    await new Promise(resolve => b.socket.end(resolve));
+
+    assert.deepEqual({ result, error: error.message, destroyed: a.socket.destroyed, sent: a.writes, other, otherWrites: b.writes }, { result: false, error: 'Collector output buffer limit exceeded', destroyed: true, sent: [], other: { queued: 2, destroyed: false }, otherWrites: ['6f6b'] });
+});
+
+test('a single oversized write fails its callback asynchronously without writing payload bytes', async t => {
+    const server = new EventEmitter();
+    limitCollectorOutput(server, 4);
+    const { socket, writes } = stream(t, server);
+    let synchronous = true;
+    let callbackWasSynchronous;
+
+    const completed = new Promise(resolve => socket.write('ÅÅÅ', 'utf8', error => { callbackWasSynchronous = synchronous; resolve(error); }));
+    synchronous = false;
+    const error = await completed;
+
+    assert.deepEqual({ error: error.message, callbackWasSynchronous, destroyed: socket.destroyed, writes }, { error: 'Collector output buffer limit exceeded', callbackWasSynchronous: false, destroyed: true, writes: [] });
+});
+
+test('draining output restores the full byte budget rather than accumulating a lifetime quota', async t => {
+    const server = new EventEmitter();
+    limitCollectorOutput(server, 4);
+    const { socket, writes } = stream(t, server);
+    socket.uncork();
+
+    await new Promise(resolve => socket.write(Buffer.from('abcd'), resolve));
+    const afterFirst = socket.writableLength;
+    await new Promise(resolve => socket.write(Buffer.from('efgh'), resolve));
+
+    assert.deepEqual({ afterFirst, afterSecond: socket.writableLength, destroyed: socket.destroyed, writes }, { afterFirst: 0, afterSecond: 0, destroyed: false, writes: ['61626364', '65666768'] });
+});
+
+test('typed byte views count their visible bytes and refused writes need no callback', t => {
+    const server = new EventEmitter();
+    limitCollectorOutput(server, 2);
+    const { socket } = stream(t, server);
+
+    const accepted = socket.write(new Uint8Array([1, 2, 3, 4]).subarray(1, 3));
+    const queued = socket.writableLength;
+    const refused = socket.write(Buffer.from([9]));
+
+    assert.deepEqual({ accepted, queued, refused, destroyed: socket.destroyed }, { accepted: true, queued: 2, refused: false, destroyed: true });
+});
+
+test('collector requires an explicit output budget and attaches the guard before listening', t => {
+    const invalid = loadCollector(t, { environment: { COLLECTOR_MAX_BUFFERED_BYTES: undefined } });
+    const collector = loadCollector(t, { environment: { COLLECTOR_MAX_BUFFERED_BYTES: '2' } });
+    const { socket } = stream(t, collector.server);
+
+    const accepted = socket.write('abc');
+
+    assert.match(invalid.startupError.message, /COLLECTOR_MAX_BUFFERED_BYTES/);
+    assert.equal(invalid.listening, false);
+    assert.equal(collector.startupError, undefined);
+    assert.deepEqual({ accepted, destroyed: socket.destroyed }, { accepted: false, destroyed: true });
+});
