diff --git a/lib/collector-output.js b/lib/collector-output.js
new file mode 100644
index 0000000..c316f41
--- /dev/null
+++ b/lib/collector-output.js
@@ -0,0 +1,19 @@
+function limitCollectorOutput(server, maxBufferedBytes) {
+    server.on('connection', function (socket) {
+        const write = socket.write;
+        socket.write = function (data, encoding, callback) {
+            const chunk = typeof data === 'string' ? Buffer.from(data, typeof encoding === 'string' ? encoding : undefined) : data;
+            if (!socket.destroyed && socket.writableLength + chunk.byteLength > maxBufferedBytes) {
+                socket.destroy();
+                const complete = typeof encoding === 'function' ? encoding : callback;
+                if (typeof complete === 'function') {
+                    process.nextTick(complete, new Error('Collector output buffer limit exceeded'));
+                }
+                return false;
+            }
+            return write.call(this, chunk, encoding, callback);
+        };
+    });
+}
+
+module.exports = limitCollectorOutput;
