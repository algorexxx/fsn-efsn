+const server = require('../../server');
+const sockets = new Map();
+server.on('connection', socket => {
+    const record = { socket, writes: 0, peak: 0 };
+    sockets.set(socket.remotePort, record);
+    const write = socket.write;
+    socket.write = function (...args) {
+        const result = write.apply(this, args);
+        record.writes++;
+        record.peak = Math.max(record.peak, socket.writableLength);
+        return result;
+    };
+});
+server.on('listening', () => process.send(server.address()));
+process.on('message', message => {
+    if (message === 'stop') {
+        server.close(() => process.exit(0));
+        return;
+    }
+    if (message === 'connections') {
+        server.getConnections((error, count) => process.send({ connections: count }));
+        return;
+    }
+    const record = sockets.get(message.port);
+    if (message.action === 'cork') {
+        record.socket.cork();
+        record.writes = 0;
+        record.peak = 0;
+    }
+    process.send({ queued: record.socket.writableLength, peak: record.peak, writes: record.writes, destroyed: record.socket.destroyed });
+});
