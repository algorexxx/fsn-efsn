+const { once } = require('node:events');
+const { readFileSync } = require('node:fs');
+const { join } = require('node:path');
+const { Pool } = require('pg');
+const WebSocket = require('websocket').w3cwebsocket;
+const Retrieve = require('../../db_methods/retrieve');
+const Populate = require('../../db_methods/populate');
+const startSnapshotCollection = require('../../wsclient/collect-snapshots');
+const createApp = require('../../api-server/app');
+const startProxy = require('./nginx.cjs');
+
+async function startTlsApi(collectorPort, cleanup) {
+    const pool = new Pool({ host: '127.0.0.1', port: Number(process.env.TEST_PG_PORT), database: 'postgres', user: 'dashboard_test_admin', password: readFileSync(process.env.TEST_PG_PASSWORD_FILE, 'utf8'), connectionTimeoutMillis: 2000, statement_timeout: 2000, query_timeout: 2000 });
+    cleanup.push(() => pool.end());
+    const api = createApp(new Retrieve(pool), Date.now, 10000, 30000).listen(0, '127.0.0.1');
+    cleanup.push(() => new Promise(resolve => api.close(resolve)));
+    await once(api, 'listening');
+    const proxy = await startProxy({ after(callback) { cleanup.push(callback); } }, process.env.EFSN_TLS_OUTPUT, {
+        HOST: '127.0.0.1', CERT: process.env.EFSN_TLS_CERT, KEY: process.env.EFSN_TLS_KEY,
+        BUILD: join(__dirname, '../../react-frontend/build'), COLLECTOR_PORT: collectorPort, API_PORT: api.address().port,
+    });
+    const populate = new Populate(pool);
+    const state = { errors: [], transport: [], saves: [] };
+    let writer;
+    async function stopCollection() {
+        if (writer) {
+            await writer.stop();
+            writer = undefined;
+        }
+    }
+    cleanup.push(stopCollection);
+    return {
+        address: { tlsPort: proxy.port, apiPort: api.address().port },
+        state,
+        stopCollection,
+        startCollection() {
+            if (writer) {
+                throw new Error('Fixture writer already running');
+            }
+            writer = startSnapshotCollection({ url: `ws://127.0.0.1:${collectorPort}/primus`, intervalMs: 250, timeoutMs: 4000, maxBytes: 1048576, maxNodes: 8 }, {
+                connect(url, maxBytes) {
+                    const connection = new WebSocket(url, undefined, undefined, undefined, undefined, { maxReceivedFrameSize: maxBytes, maxReceivedMessageSize: maxBytes });
+                    const id = state.transport.filter(event => event.kind === 'connect').length;
+                    state.transport.push({ id, kind: 'connect', time: Date.now() });
+                    connection._client.on('connectFailed', error => state.transport.push({ id, kind: 'connectFailed', time: Date.now(), code: error.code }));
+                    connection.addEventListener('open', () => state.transport.push({ id, kind: 'open', time: Date.now() }));
+                    connection.addEventListener('close', event => state.transport.push({ id, kind: 'close', time: Date.now(), code: event.code }));
+                    return connection;
+                },
