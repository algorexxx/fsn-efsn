diff --git a/api-server/report-freshness.js b/api-server/report-freshness.js
new file mode 100644
index 0000000..72dfe99
--- /dev/null
+++ b/api-server/report-freshness.js
@@ -0,0 +1,12 @@
+function reportFreshness(node, observedAt, now, maximumAgeMs) {
+    return Object.fromEntries(['block', 'stats', 'pending'].map(kind => {
+        const receivedAt = node.reports && node.reports[kind];
+        const known = Number.isSafeInteger(receivedAt) && receivedAt >= 0 && receivedAt <= observedAt && receivedAt <= now;
+        if (!known) {
+            return [kind, null];
+        }
+        return [kind, node.connected === true ? Math.max(0, maximumAgeMs - (now - receivedAt)) : 0];
+    }));
+}
+
+module.exports = reportFreshness;
