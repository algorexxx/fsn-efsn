diff --git a/lib/telemetry-report.js b/lib/telemetry-report.js
new file mode 100644
index 0000000..2406047
--- /dev/null
+++ b/lib/telemetry-report.js
@@ -0,0 +1,25 @@
+function object(value) {
+    return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function count(value) {
+    return Number.isSafeInteger(value) && value >= 0;
+}
+
+function isTelemetryReport(kind, value) {
+    if (!object(value)) {
+        return false;
+    }
+    if (kind === 'block') {
+        return count(value.number) && typeof value.hash === 'string' && /^0x[0-9a-fA-F]{64}$/.test(value.hash)
+            && Array.isArray(value.transactions) && Array.isArray(value.uncles) && value.difficulty !== undefined;
+    }
+    if (kind === 'pending') {
+        return count(value.pending);
+    }
+    return ['active', 'mining', 'syncing'].every(field => typeof value[field] === 'boolean')
+        && count(value.peers) && Number.isFinite(value.uptime) && value.uptime >= 0 && value.uptime <= 100
+        && ['ticketNumber', 'myTicketNumber'].every(field => value[field] == null || count(value[field]));
+}
+
+module.exports = isTelemetryReport;
