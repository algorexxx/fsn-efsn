diff --git a/test/report-freshness-wire.test.cjs b/test/report-freshness-wire.test.cjs
new file mode 100644
index 0000000..5a933ef
--- /dev/null
+++ b/test/report-freshness-wire.test.cjs
@@ -0,0 +1,47 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const startCollector = require('./fixtures/collector-wire.cjs');
+const { secretA } = require('./fixtures/collector.cjs');
+const { connect, login, send, inventory, waitMessage } = require('./fixtures/wire-client.cjs');
+
+test('real collector timestamps reports, ignores ping/history for freshness and clears receipts on reconnect', { timeout: 15000 }, async t => {
+    const server = await startCollector(t);
+    const viewer = connect(t, server.port, 'primus');
+    await viewer.opened;
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA);
+    assert.deepEqual((await inventory(viewer))[0].reports, { block: null, stats: null, pending: null });
+    const block = { number: 100, hash: '0x' + '1'.repeat(64), difficulty: '1', totalDifficulty: '2', timestamp: 100, transactions: [], uncles: [], received: 1 };
+    const startedAt = Date.now();
+    send(owner, 'block', { id: 'node-a', block, reports: { block: 1 } });
+    send(owner, 'stats', { id: 'node-a', stats: { active: false, mining: false, syncing: false, peers: 1, uptime: 100, myTicketNumber: null } });
+    send(owner, 'pending', { id: 'node-a', stats: { pending: 0 } });
+    send(owner, 'node-ping', { id: 'node-a', clientTime: 'reports-sent' });
+    await waitMessage(owner, message => message.emit && message.emit[0] === 'node-pong' && message.emit[1].clientTime === 'reports-sent');
+    const received = (await inventory(viewer))[0];
+    assert.equal(received.uptime.lastStatus, true);
+    assert.equal(received.stats.active, false);
+    assert.equal(received.stats.myTicketNumber, null);
+    for (const timestamp of Object.values(received.reports)) {
+        assert.ok(timestamp >= startedAt && timestamp <= Date.now());
+    }
+    send(owner, 'latency', { id: 'node-a', latency: '12' });
+    send(owner, 'history', { id: 'node-a', history: [{ ...block, number: 99 }] });
+    send(owner, 'node-ping', { id: 'node-a', clientTime: 'history-sent' });
+    await waitMessage(owner, message => message.emit && message.emit[0] === 'node-pong' && message.emit[1].clientTime === 'history-sent');
+    const afterHistory = (await inventory(viewer))[0];
+    assert.deepEqual(afterHistory.reports, received.reports);
+    assert.equal(afterHistory.stats.latency, 12);
+    owner.socket.close();
+    await owner.closed;
+    await waitMessage(viewer, message => message.action === 'inactive');
+    const replacement = connect(t, server.port, 'api');
+    await login(replacement, 'node-a', secretA);
+    const reconnected = (await inventory(viewer))[0];
+    assert.deepEqual(reconnected.reports, { block: null, stats: null, pending: null });
+    assert.equal(reconnected.uptime.lastStatus, true);
+    viewer.socket.close();
+    replacement.socket.close();
+    await Promise.all([viewer.closed, replacement.closed]);
+    await server.stop();
+});
diff --git a/test/report-freshness.test.cjs b/test/report-freshness.test.cjs
new file mode 100644
index 0000000..4890b90
--- /dev/null
+++ b/test/report-freshness.test.cjs
@@ -0,0 +1,108 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const Collection = require('../lib/collection');
+const reportFreshness = require('../api-server/report-freshness');
+const { loadApiConfig } = require('../lib/deployment-config');
+
+function block(number = 100) {
+    return { number, hash: '0x' + '1'.repeat(64), difficulty: '1', totalDifficulty: '2', timestamp: 100, transactions: [], uncles: [] };
+}
+
+function stats() {
+    return { active: true, mining: true, syncing: false, peers: 1, uptime: 100, ticketNumber: null, myTicketNumber: null, gasPrice: 0, hashrate: 0 };
+}
+
+function fixture(t) {
+    let time = 1000;
+    const collection = new Collection({ write() {} }, () => time);
+    collection.add({ id: 'node-a', info: {}, ip: '127.0.0.1', spark: 'session-a' }, () => {});
+    const node = collection.getNode({ id: 'node-a' });
+    t.after(() => { if (collection._debounced) { collection._debounced.cancel(); } });
+    return { collection, node, setTime(value) { time = value; } };
+}
+
+test('reports begin unknown and identical accepted values refresh only their own receipt times', t => {
+    const f = fixture(t);
+    assert.deepEqual(f.node.reports, { block: null, stats: null, pending: null });
+    f.collection.addBlock('node-a', block(), () => {});
+    f.setTime(2000);
+    f.collection.updateStats('node-a', stats(), () => {});
+    f.setTime(3000);
+    f.collection.updatePending('node-a', { pending: 0 }, () => {});
+    assert.deepEqual(f.node.reports, { block: 1000, stats: 2000, pending: 3000 });
+    f.setTime(4000);
+    f.collection.addBlock('node-a', block(), () => {});
+    f.setTime(5000);
+    f.collection.updateStats('node-a', stats(), () => {});
+    f.setTime(6000);
+    f.collection.updatePending('node-a', { pending: 0 }, () => {});
+    assert.deepEqual(f.node.reports, { block: 4000, stats: 5000, pending: 6000 });
+    assert.equal(f.node.stats.myTicketNumber, null);
+});
+
+test('history and latency do not refresh current reports; reconnect requires new reports', t => {
+    const f = fixture(t);
+    f.collection.addBlock('node-a', block(), () => {});
+    f.setTime(2000);
+    f.collection.addHistory('node-a', [block(99)], () => {});
+    f.collection.updateLatency('node-a', '12', () => {});
+    assert.deepEqual(f.node.reports, { block: 1000, stats: null, pending: null });
+    f.collection.inactive('session-a', () => {});
+    assert.equal(f.node.uptime.lastStatus, false);
+    f.collection.add({ id: 'node-a', info: {}, ip: '127.0.0.1', spark: 'session-new' }, () => {});
+    assert.deepEqual(f.node.reports, { block: null, stats: null, pending: null });
+    assert.equal(f.node.uptime.lastStatus, true);
+});
+
+test('incomplete reports do not stamp receipts or replace previously accepted values', t => {
+    const f = fixture(t);
+    f.collection.addBlock('node-a', block(), () => {});
+    f.collection.updateStats('node-a', stats(), () => {});
+    f.collection.updatePending('node-a', { pending: 2 }, () => {});
+    f.setTime(2000);
+    const errors = [];
+    const capture = error => errors.push(error);
+    f.collection.addBlock('node-a', { number: 101 }, capture);
+    f.collection.updateStats('node-a', { peers: 9 }, capture);
+    f.collection.updatePending('node-a', { pending: -1 }, capture);
+    f.collection.update('node-a', { ...stats(), block: block(101) }, capture);
+    assert.deepEqual(errors, ['Invalid block report', 'Invalid stats report', 'Invalid pending report', 'Invalid combined report']);
+    assert.deepEqual(f.node.reports, { block: 1000, stats: 1000, pending: 1000 });
+    assert.deepEqual({ height: f.node.stats.block.number, peers: f.node.stats.peers, pending: f.node.stats.pending }, { height: 100, peers: 1, pending: 2 });
+});
+
+test('combined reports refresh all fields, preserve pending zero and complete exactly once', t => {
+    const f = fixture(t);
+    const errors = [];
+    f.collection.update('node-a', { ...stats(), block: block(), pending: 0 }, error => errors.push(error));
+    assert.deepEqual(errors, [null]);
+    assert.deepEqual(f.node.reports, { block: 1000, stats: 1000, pending: 1000 });
+    assert.equal(f.node.stats.pending, 0);
+});
+
+test('self-reported active status cannot overwrite the collector connection state', t => {
+    const f = fixture(t);
+    f.collection.updateStats('node-a', { ...stats(), active: false }, () => {});
+    assert.equal(f.node.stats.active, false);
+    assert.equal(f.node.uptime.lastStatus, true);
+});
+
+test('API report budgets expire independently and do not renew with a fresh snapshot', () => {
+    const node = { connected: true, reports: { block: 1000, stats: 1500, pending: 2000 } };
+    assert.deepEqual(reportFreshness(node, 2000, 2000, 1000), { block: 0, stats: 500, pending: 1000 });
+    assert.deepEqual(reportFreshness(node, 3000, 3000, 1000), { block: 0, stats: 0, pending: 0 });
+    assert.deepEqual(reportFreshness({ ...node, connected: false }, 2000, 2000, 1000), { block: 0, stats: 0, pending: 0 });
+});
+
+test('missing, invalid or future receipts never receive a positive budget', () => {
+    assert.deepEqual(reportFreshness({ connected: true }, 2000, 2000, 1000), { block: null, stats: null, pending: null });
+    assert.deepEqual(reportFreshness({ connected: true, reports: { block: -1, stats: 2001, pending: '1000' } }, 2000, 2100, 1000), { block: null, stats: null, pending: null });
+});
+
+test('API node-report lifetime must be explicitly configured independently of snapshot lifetime', () => {
+    const environment = { API_HOST: '127.0.0.1', API_PORT: '0', SNAPSHOT_MAX_AGE_MS: '1000', NODE_REPORT_MAX_AGE_MS: '45000' };
+    assert.deepEqual(loadApiConfig(environment), { host: '127.0.0.1', port: 0, maxAgeMs: 1000, reportMaxAgeMs: 45000 });
+    for (const value of [undefined, '', '0', '-1', '1.5', '2147483648']) {
+        assert.throws(() => loadApiConfig({ ...environment, NODE_REPORT_MAX_AGE_MS: value }), /NODE_REPORT_MAX_AGE_MS/);
+    }
+});
