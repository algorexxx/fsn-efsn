diff --git a/test/head-budget.test.cjs b/test/head-budget.test.cjs
new file mode 100644
index 0000000..ab3f742
--- /dev/null
+++ b/test/head-budget.test.cjs
@@ -0,0 +1,95 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const Collection = require('../lib/collection');
+const loadCredentials = require('../lib/telemetry-credentials');
+const { loadCollector, connectCollector, hello, credentialFile, secretA, secretB, secretNext } = require('./fixtures/collector.cjs');
+const { block, stats } = require('./fixtures/telemetry-report.cjs');
+const { head } = require('./fixtures/budget-report.cjs');
+
+function collection(t, maximum = 65536) {
+    const value = new Collection({ write() {} }, () => 1000, maximum);
+    value.add({ id: 'node-a', info: {}, ip: '127.0.0.1', spark: 'a' }, () => {});
+    t.after(() => { if (value._debounced) { value._debounced.cancel(); } });
+    return value;
+}
+
+test('head admission requires an explicit finite byte budget', () => {
+    const invalid = [undefined, 0, -1, 1.5, Infinity, Number.MAX_SAFE_INTEGER + 1];
+
+    const rejected = invalid.map(maximum => {
+        try {
+            new Collection({ write() {} }, () => 1000, maximum);
+            return false;
+        } catch (_) {
+            return true;
+        }
+    });
+
+    assert.deepEqual(rejected, [true, true, true, true, true, true]);
+});
+
+test('complete head retains every native hash and uncle field at the byte boundary and discards extensions', t => {
+    const value = collection(t);
+    const expected = head();
+    const input = structuredClone(expected);
+    input.extension = { label: 'unretained' };
+    input.transactions[0].extension = { label: 'unretained' };
+    input.uncles[0].extension = { label: 'unretained' };
+    let error;
+
+    value.addBlock('node-a', input, result => { error = result; });
+    const current = value.getNode({ id: 'node-a' }).stats.block;
+
+    assert.equal(Buffer.byteLength(JSON.stringify(expected)), 65536);
+    assert.equal(error, null);
+    assert.deepEqual(current.transactions, expected.transactions);
+    assert.deepEqual(current.uncles, expected.uncles);
+    assert.equal(current.extension, undefined);
+    assert.equal(current.received, 1000);
+    assert.deepEqual(value.getNode({ id: 'node-a' }).reports, { block: 1000, stats: null, pending: null });
+});
+
+test('oversized block and combined reports cannot replace heads, refresh receipts or populate history', t => {
+    const value = collection(t);
+    value.update('node-a', { ...stats(), block: block(), pending: 0 }, () => {});
+    const before = JSON.stringify({ nodes: value._items, history: value.getHistory()._items });
+    const errors = [];
+
+    value.addBlock('node-a', head(1001, 65537), error => errors.push(error));
+    value.update('node-a', { ...stats(), block: head(1002, 65537), pending: 1 }, error => errors.push(error));
+
+    assert.deepEqual(errors, ['Invalid block report', 'Invalid combined report']);
+    assert.equal(JSON.stringify({ nodes: value._items, history: value.getHistory()._items }), before);
+});
+
+test('enrollment counts all configured identities and rotation does not consume an extra slot', t => {
+    const file = credentialFile(t, { 'node-a': [secretA, secretNext], 'node-b': secretB });
+    const accepted = loadCredentials({ WS_CREDENTIALS_FILE: file }, 2);
+
+    const matches = [accepted('node-a', secretA), accepted('node-a', secretNext), accepted('node-b', secretB)];
+
+    assert.deepEqual(matches, [true, true, true]);
+    assert.throws(() => loadCredentials({ WS_CREDENTIALS_FILE: file }, 1), /enrollment limit/);
+    assert.throws(() => loadCredentials({ WS_CREDENTIALS_FILE: file }), /enrollment limit/);
+});
+
+test('over-enrolled collector configuration fails before constructing listeners', t => {
+    const result = loadCollector(t, { environment: { COLLECTOR_MAX_NODES: '1' } });
+
+    assert.equal(result.listening, false);
+    assert.equal(result.sockets.size, 0);
+    assert.match(result.startupError && result.startupError.message, /enrollment limit/);
+});
+
+test('collector-derived addresses must be bounded IP literals before registration', t => {
+    const addresses = ['127.0.0.1', '::1', 'ffff:ffff:ffff:ffff:ffff:ffff:255.255.255.255', '::1%scope', 'unbounded-label', 'x'.repeat(1000)];
+    const results = addresses.map(ip => {
+        const collector = loadCollector(t);
+        const spark = connectCollector(collector);
+        spark.address.ip = ip;
+        hello(spark);
+        return { ended: spark.ended, registered: collector.calls.length };
+    });
+
+    assert.deepEqual(results, [{ ended: false, registered: 1 }, { ended: false, registered: 1 }, { ended: false, registered: 1 }, { ended: true, registered: 0 }, { ended: true, registered: 0 }, { ended: true, registered: 0 }]);
+});
