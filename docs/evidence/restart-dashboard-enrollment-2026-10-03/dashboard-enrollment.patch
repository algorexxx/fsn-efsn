diff --git a/lib/telemetry-head.js b/lib/telemetry-head.js
new file mode 100644
index 0000000..737baf6
--- /dev/null
+++ b/lib/telemetry-head.js
@@ -0,0 +1,26 @@
+var isTelemetryReport = require('./telemetry-report');
+var chartBlock = require('./chart-block');
+
+function projectTelemetryHead(block, maximum) {
+    if (!isTelemetryReport('block', block)) {
+        return null;
+    }
+    var head = chartBlock(block);
+    delete head.transactionCount;
+    delete head.uncleCount;
+    head.transactions = block.transactions.map(function (transaction) {
+        return { hash: transaction.hash };
+    });
+    head.uncles = block.uncles.map(function (uncle) {
+        var header = {};
+        ['hash', 'parentHash', 'sha3Uncles', 'miner', 'stateRoot', 'transactionsRoot', 'receiptsRoot', 'logsBloom', 'difficulty', 'number', 'gasLimit', 'gasUsed', 'timestamp', 'extraData', 'mixHash', 'nonce', 'baseFeePerGas'].forEach(function (field) {
+            if (uncle[field] !== undefined) {
+                header[field] = uncle[field];
+            }
+        });
+        return header;
+    });
+    return Buffer.byteLength(JSON.stringify(head), 'utf8') <= maximum ? head : null;
+}
+
+module.exports = projectTelemetryHead;
