+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { readFileSync, writeFileSync } = require('node:fs');
+const { join } = require('node:path');
+const { once } = require('node:events');
+const { Pool } = require('pg');
+const WebSocket = require('websocket').w3cwebsocket;
+const startCollector = require('./fixtures/collector-wire.cjs');
+const { connect, login, send, waitMessage } = require('./fixtures/wire-client.cjs');
+const { stats } = require('./fixtures/telemetry-report.cjs');
+const { head, metadata } = require('./fixtures/budget-report.cjs');
+const request = require('./fixtures/http.cjs');
+const Populate = require('../db_methods/populate');
+const Retrieve = require('../db_methods/retrieve');
+const createApp = require('../api-server/app');
+const startSnapshotCollection = require('../wsclient/collect-snapshots');
+
+async function waitFor(read, predicate) {
+    const deadline = Date.now() + 6000;
+    while (Date.now() < deadline) {
+        const value = await read();
+        if (predicate(value)) {
+            return value;
+        }
+        await new Promise(resolve => setTimeout(resolve, 50));
+    }
+    throw new Error('Expected bounded enrollment profile state did not arrive');
+}
+
+async function acknowledge(connection, id, marker) {
+    const from = connection.messages.length;
+    send(connection, 'node-ping', { id, clientTime: marker });
+    await waitMessage(connection, message => message.emit && message.emit[0] === 'node-pong' && message.emit[1].clientTime === marker, from);
+}
+
+test('maximum-size enrolled heads remain complete with inactive rows and credential rotation', { timeout: 40000 }, async t => {
+    assert.ok(process.env.TEST_PG_PORT && process.env.TEST_PG_PASSWORD_FILE && process.env.DASHBOARD_PROFILE_EVIDENCE);
+    const ids = Array.from({ length: 8 }, (_, index) => ('enrolled-' + index).padEnd(64, 'x'));
+    const nextSecret = 'synthetic-enrollment-rotating-credential-00000000';
+    const secrets = ids.map((_, index) => 'synthetic-enrollment-credential-' + String(index).padStart(16, '0'));
+    const credentials = Object.fromEntries(ids.map((id, index) => [id, index === 0 ? [secrets[index], nextSecret] : secrets[index]]));
+    const server = await startCollector(t, { COLLECTOR_MAX_MESSAGE_BYTES: '4194304', COLLECTOR_MAX_HEAD_BYTES: '65536', COLLECTOR_MAX_NODES: '8', COLLECTOR_MAX_CONNECTIONS: '3', COLLECTOR_MAX_BUFFERED_BYTES: '1048576' }, 'profile-wire-server.cjs', credentials);
+    const pool = new Pool({ host: '127.0.0.1', port: Number(process.env.TEST_PG_PORT), database: 'postgres', user: 'dashboard_test_admin', password: readFileSync(process.env.TEST_PG_PASSWORD_FILE, 'utf8'), connectionTimeoutMillis: 2000, statement_timeout: 2000, query_timeout: 2000 });
+    t.after(() => pool.end());
+    await pool.query(readFileSync(join(__dirname, '../db/schema/001-dashboard.sql'), 'utf8'));
+    const populate = new Populate(pool);
+    const retrieve = new Retrieve(pool);
+    const errors = [];
+    const evidence = { scope: 'Eight synthetic enrolled identities, sequential reporters, three-connection cap; no efsn, real key or chain database.', headBytes: 65536, metadataBytes: 2048, ids: ids.length, errors, saves: [] };
+    t.after(() => writeFileSync(join(process.env.DASHBOARD_PROFILE_EVIDENCE, 'enrollment.json'), JSON.stringify(evidence, null, 2) + '\n', 'utf8'));
+
+    for (const [index, id] of ids.entries()) {
+        const connection = connect(t, server.port, 'api');
+        await login(connection, id, secrets[index], metadata(id));
+        const report = head(1000 + index);
+        assert.equal(Buffer.byteLength(JSON.stringify(report)), 65536);
+        assert.equal(Buffer.byteLength(JSON.stringify(metadata(id))), 2048);
+        if (index % 2) {
+            send(connection, 'update', { id, stats: { ...stats(), block: report, pending: Number.MAX_SAFE_INTEGER } });
+        } else {
+            send(connection, 'block', { id, block: report });
+            send(connection, 'stats', { id, stats: stats() });
+            send(connection, 'pending', { id, stats: { pending: Number.MAX_SAFE_INTEGER } });
+        }
+        if (index === 0) {
+            send(connection, 'history', { id, history: Array.from({ length: 50 }, (_, offset) => head(999 - offset)) });
+        }
+        await acknowledge(connection, id, 'accepted');
+        const before = await server.command('inspect');
+        send(connection, 'block', { id, block: head(2000 + index, 65537) });
+        send(connection, 'update', { id, stats: { ...stats(), block: head(3000 + index, 65537), pending: 0 } });
+        await acknowledge(connection, id, 'rejected');
+        const after = await server.command('inspect');
+        assert.deepEqual(after.nodes, before.nodes);
+        assert.deepEqual(after.cache, before.cache);
+        connection.socket.close();
+        await connection.closed;
+        await waitFor(() => server.command('inspect'), state => state.nodes.every(node => !node.connected));
+    }
+    evidence.inactive = await server.command('inspect');
+    assert.equal(evidence.inactive.nodes.length, 8);
+    const unconfigured = connect(t, server.port, 'api');
+    await unconfigured.opened;
+    send(unconfigured, 'hello', { id: 'not-enrolled', secret: secrets[0], info: metadata('not-enrolled') });
+    await unconfigured.closed;
+    assert.deepEqual((await server.command('inspect')).nodes, evidence.inactive.nodes);
+
+    const config = { url: `ws://127.0.0.1:${server.port}/primus`, intervalMs: 250, timeoutMs: 2000, maxBytes: 1048576, maxNodes: 8 };
+    const writer = startSnapshotCollection(config, {
+        connect(url, maxBytes) { return new WebSocket(url, undefined, undefined, undefined, undefined, { maxReceivedFrameSize: maxBytes, maxReceivedMessageSize: maxBytes }); },
+        async saveSnapshot(payload, time) {
+            await populate.saveSnapshot(payload, time);
+            evidence.saves.push({ bytes: Buffer.byteLength(JSON.stringify(payload)), connected: payload.nodes.filter(node => node.connected).length });
+        },
+        now: () => new Date(), setTimeout, clearTimeout, onError: message => errors.push(message),
+    });
+    t.after(() => writer.stop());
+    const api = createApp(retrieve, Date.now, 5000, 30000).listen(0, '127.0.0.1');
+    t.after(() => new Promise(resolve => api.close(resolve)));
+    await once(api, 'listening');
+    const snapshot = await waitFor(() => retrieve.readSnapshot(), value => value && value.payload.nodes.length === 8);
+    assert.equal(snapshot.payload.nodes.every(node => !node.connected), true);
+    evidence.http = {};
+    for (const path of ['/nodes', '/blocks']) {
+        const response = await request(api.address().port, path);
+        assert.equal(response.status, 200);
+        assert.equal(response.body.length, 8);
+        evidence.http[path] = { bytes: Number(response.headers['content-length']) };
+        for (const [index, id] of ids.entries()) {
+            const row = response.body.find(value => value.id === id);
+            const current = path === '/nodes' ? JSON.parse(row.stats).stats.block : JSON.parse(row.blocks);
+            const expected = head(1000 + index);
+            for (const [field, value] of Object.entries(expected)) {
+                assert.deepEqual(current[field], value, field);
+            }
+            if (path === '/nodes') {
+                const node = JSON.parse(row.stats);
+                assert.deepEqual(node.info, { ...metadata(id), ip: '127.0.0.1' });
+                assert.deepEqual(row.reportValidForMs, { block: 0, stats: 0, pending: 0 });
+            }
+        }
+    }
+    const replacement = connect(t, server.port, 'api');
+    await login(replacement, ids[0], nextSecret, metadata(ids[0]));
+    send(replacement, 'update', { id: ids[0], stats: { ...stats(), block: head(1010), pending: 0 } });
+    await acknowledge(replacement, ids[0], 'rotated');
+    const rotated = await waitFor(() => retrieve.readSnapshot(), value => value && value.payload.nodes.some(node => node.id === ids[0] && node.stats.block.number === 1010));
+    assert.equal(rotated.payload.nodes.length, 8);
+    assert.equal(rotated.payload.nodes.filter(node => node.connected).length, 1);
+    assert.deepEqual(rotated.payload.nodes.find(node => node.id === ids[0]).stats.block.transactions, head(1010).transactions);
+    evidence.rotated = await server.command('inspect');
+    assert.equal(evidence.rotated.rejectedWrites, 0);
+    assert.equal(evidence.rotated.cache.retainedArrays, 0);
+    assert.ok(evidence.saves.every(save => save.bytes < 1048576));
+    assert.deepEqual(errors, []);
+    await writer.stop();
+    replacement.socket.close();
+    await replacement.closed;
+    await server.stop();
+});
diff --git a/test/fixtures/budget-report.cjs b/test/fixtures/budget-report.cjs
new file mode 100644
index 0000000..45c1c20
--- /dev/null
+++ b/test/fixtures/budget-report.cjs
@@ -0,0 +1,23 @@
+const { block, uncle, info } = require('./telemetry-report.cjs');
+
+function head(number = 1000, bytes = 65536) {
+    const value = { ...block(number), difficulty: '9'.repeat(78), totalDifficulty: '9'.repeat(78), gasLimit: Number.MAX_SAFE_INTEGER, gasUsed: Number.MAX_SAFE_INTEGER, transactions: Array.from({ length: 714 }, (_, index) => ({ hash: '0x' + index.toString(16).padStart(64, '0') })), uncles: [uncle()] };
+    const remaining = bytes - Buffer.byteLength(JSON.stringify(value));
+    if (remaining < 0) {
+        throw new Error('Fixture head budget is too small');
+    }
+    value.uncles[0].extraData += 'ab'.repeat(Math.floor(remaining / 2));
+    if (remaining % 2) {
+        value.uncles[0].number = '0x10';
+    }
+    return value;
+}
+
+function metadata(id) {
+    const value = info(id);
+    const remaining = 2048 - Buffer.byteLength(JSON.stringify(value));
+    value.node += '\u2028'.repeat(Math.floor(remaining / 3)) + 'x'.repeat(remaining % 3);
+    return value;
+}
+
+module.exports = { head, metadata };
