+    const dialog = document.querySelector('[role="dialog"]');
+    expect(dialog.getAttribute('aria-hidden')).not.toBe('true');
+    expect(dialog.getAttribute('aria-labelledby')).toBe('geo-map-title');
+    expect(document.getElementById('geo-map-title').textContent).toBe('Geo Map');
+    const close = dialog.querySelector('.modal-footer button');
+    act(() => { close.dispatchEvent(new MouseEvent('click', {bubbles: true})); });
+    advance(1000);
+    expect(document.querySelector('[role="dialog"]')).toBeNull();
+    expect(errors).not.toHaveBeenCalled();
+});
