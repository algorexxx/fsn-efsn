diff --git a/test/fixtures/browser-server.cjs b/test/fixtures/browser-server.cjs
new file mode 100644
index 0000000..9621904
--- /dev/null
+++ b/test/fixtures/browser-server.cjs
@@ -0,0 +1,81 @@
+const express = require('express');
+const fs = require('node:fs');
+const path = require('node:path');
+const createApp = require('../../api-server/app');
+
+const scenarioFile = process.env.BROWSER_SCENARIO_FILE;
+if (!scenarioFile || !path.isAbsolute(scenarioFile)) {
+    throw new Error('BROWSER_SCENARIO_FILE must be an absolute path');
+}
+const application = express();
+const sockets = new Set();
+const counts = { reads: 0, ready: 0, empty: 0, unavailable: 0, expired: 0, hanging: 0 };
+const requests = [];
+const maximumAge = 2000;
+
+function readScenario() {
+    return JSON.parse(fs.readFileSync(scenarioFile, 'utf8'));
+}
+
+function makeNode(id, height, active, observedAt) {
+    return {
+        id, info: { node: 'efsn/v5.0.0-browser-acceptance' },
+        geo: { country: 'SE', ll: [59.33, 18.07] }, history: [],
+        stats: { active, mining: active, syncing: false, peers: active ? 1 : 0,
+            pending: 0, myTicketNumber: 0, uptime: 100, latency: 0,
+            block: { number: height, hash: '0x' + '1'.repeat(64), received: observedAt.getTime(), ticketNumber: 0 } },
+    };
+}
+
+const retrieve = {
+    async readSnapshot() {
+        const scenario = readScenario();
+        counts.reads++;
+        if (scenario.mode === 'unavailable') {
+            counts.unavailable++;
+            throw new Error('Synthetic unavailable storage');
+        }
+        if (scenario.mode === 'hanging') {
+            counts.hanging++;
+            return new Promise(() => {});
+        }
+        const observedAt = new Date(Date.now() - (scenario.mode === 'expired' ? maximumAge + 1 : 0));
+        counts[scenario.mode]++;
+        return {
+            observed_at: observedAt,
+            payload: {
+                nodes: scenario.mode === 'empty' ? [] : [
+                    makeNode(scenario.nodeId || 'synthetic-alpha', 42, true, observedAt),
+                    makeNode('synthetic-offline', 43, false, observedAt),
+                ], charts: {},
+            },
+        };
+    },
+};
+application.use((request, response, next) => {
+    response.on('finish', () => {
+        if (requests.length < 200) {
+            requests.push({ path: request.path, status: response.statusCode });
+        }
+    });
+    next();
+});
+application.use('/stats-api', createApp(retrieve, () => Date.now(), maximumAge));
+application.use(express.static(path.resolve(__dirname, '../../react-frontend/build')));
+const server = application.listen(0, '127.0.0.1', () => {
+    console.log(JSON.stringify({ url: 'http://127.0.0.1:' + server.address().port, pid: process.pid }));
+});
+server.on('connection', socket => {
+    sockets.add(socket);
+    socket.on('close', () => sockets.delete(socket));
+});
+const control = setInterval(() => {
+    if (readScenario().mode !== 'stop') {
+        return;
+    }
+    clearInterval(control);
+    for (const socket of sockets) {
+        socket.destroy();
+    }
+    server.close(() => console.log(JSON.stringify({ stopped: true, counts, requests })));
+}, 250);
