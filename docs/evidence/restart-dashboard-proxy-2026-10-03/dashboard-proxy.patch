--- /dev/null
+++ b/test/fixtures/proxy-wire-server.cjs
@@ -0,0 +1,21 @@
+const WebSocket = require('ws');
+const headers = [];
+const upgrade = WebSocket.Server.prototype.handleUpgrade;
+WebSocket.Server.prototype.handleUpgrade = function (request, ...args) {
+    const pairs = [];
+    for (let index = 0; index < request.rawHeaders.length; index += 2) {
+        const name = request.rawHeaders[index].toLowerCase();
+        if (!name.startsWith('sec-websocket-')) {
+            pairs.push([name, request.rawHeaders[index + 1]]);
+        }
+    }
+    const forwarded = Object.fromEntries(pairs);
+    headers.push({ path: request.url, headers: forwarded });
+    return upgrade.call(this, request, ...args);
+};
+require('./wire-server.cjs');
+process.on('message', message => {
+    if (message === 'headers') {
+        process.send(headers);
+    }
+});
