diff --git a/test/proxy-tls.test.cjs b/test/proxy-tls.test.cjs
new file mode 100644
index 0000000..9a805e7
--- /dev/null
+++ b/test/proxy-tls.test.cjs
@@ -0,0 +1,238 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { once } = require('node:events');
+const { readFileSync, writeFileSync } = require('node:fs');
+const { join } = require('node:path');
+const https = require('node:https');
+const http = require('node:http');
+const { setTimeout: delay } = require('node:timers/promises');
+const WebSocket = require('ws');
+const SnapshotWebSocket = require('websocket').w3cwebsocket;
+const startProxy = require('./fixtures/nginx.cjs');
+const startCollector = require('./fixtures/collector-wire.cjs');
+const { connect, login, send, waitMessage } = require('./fixtures/wire-client.cjs');
+const { head, metadata } = require('./fixtures/budget-report.cjs');
+const { stats } = require('./fixtures/telemetry-report.cjs');
+const createApp = require('../api-server/app');
+const startSnapshotCollection = require('../wsclient/collect-snapshots');
+
+function request(port, ca, path, options = {}) {
+    return new Promise((resolve, reject) => {
+        const connection = https.request({ host: '127.0.0.1', port, servername: 'dashboard.test', ca, path, agent: false, headers: { Host: 'dashboard.test' }, ...options }, response => {
+            const chunks = [];
+            const protocol = response.socket.getProtocol();
+            response.on('data', chunk => chunks.push(chunk));
+            response.on('error', reject);
+            response.on('end', () => resolve({ status: response.statusCode, headers: response.headers, body: Buffer.concat(chunks), protocol }));
+        });
+        connection.on('error', reject);
+        connection.setTimeout(8000, () => connection.destroy(new Error('HTTPS request deadline exceeded')));
+        connection.end();
+    });
+}
+
+async function waitFor(read, predicate) {
+    const deadline = Date.now() + 6000;
+    while (Date.now() < deadline) {
+        const value = await read();
+        if (predicate(value)) {
+            return value;
+        }
+        await delay(50);
+    }
+    throw new Error('Proxy fixture state deadline exceeded');
+}
+
+test('local TLS proxy preserves bounded telemetry and isolates private routes', { timeout: 85000 }, async t => {
+    const directory = process.env.DASHBOARD_PROXY_EVIDENCE;
+    assert.ok(directory && process.env.TEST_NGINX && process.env.TEST_TLS_CERT && process.env.TEST_TLS_KEY && process.env.TEST_TLS_CA);
+    const ca = readFileSync(process.env.TEST_TLS_CA);
+    const evidence = { scope: 'Loopback nginx, synthetic reporters, real collector/writer/API, in-memory snapshot store, compiled frontend bytes; no chain data, mining, PostgreSQL or browser execution.', requests: [], errors: [], saves: [], checks: {} };
+    t.after(() => writeFileSync(join(directory, 'proxy.json'), JSON.stringify(evidence, null, 2) + '\n', 'utf8'));
+    const ids = Array.from({ length: 8 }, (_, index) => ('tls-node-' + index).padEnd(64, 'x'));
+    const secrets = ids.map((_, index) => 'synthetic-tls-credential-' + String(index).padStart(20, '0'));
+    const credentials = Object.fromEntries(ids.map((id, index) => [id, secrets[index]]));
+    const collector = await startCollector(t, { COLLECTOR_MAX_MESSAGE_BYTES: '4194304', COLLECTOR_MAX_HEAD_BYTES: '65536', COLLECTOR_MAX_BUFFERED_BYTES: '1048576', COLLECTOR_HELLO_TIMEOUT_MS: '5000' }, 'proxy-wire-server.cjs', credentials);
+    let snapshot = null;
+    let clock = Date.now();
+    let delayedRead = false;
+    const api = createApp({ async readSnapshot() { if (delayedRead) { await delay(6000); } return snapshot; } }, () => clock, 10000, 30000).listen(0, '127.0.0.1');
+    t.after(() => new Promise(resolve => api.close(resolve)));
+    await once(api, 'listening');
+    const values = { HOST: 'dashboard.test', CERT: process.env.TEST_TLS_CERT, KEY: process.env.TEST_TLS_KEY, BUILD: join(__dirname, '../react-frontend/build'), COLLECTOR_PORT: collector.port, API_PORT: api.address().port };
+    const proxy = await startProxy(t, join(directory, 'active'), values);
+    const options = { secure: true, ca, servername: 'dashboard.test', headers: { Host: 'dashboard.test' } };
+    for (const protocol of ['TLSv1.2', 'TLSv1.3']) {
+        const response = await request(proxy.port, ca, '/', { minVersion: protocol, maxVersion: protocol });
+        assert.equal(response.status, 200);
+        assert.equal(response.protocol, protocol);
+        assert.deepEqual(response.body, readFileSync(join(values.BUILD, 'index.html')));
+        evidence.requests.push({ path: '/', status: response.status, protocol });
+    }
+    await assert.rejects(request(proxy.port, undefined, '/'), error => error.code === 'UNABLE_TO_VERIFY_LEAF_SIGNATURE');
+    await assert.rejects(request(proxy.port, ca, '/', { servername: 'wrong.test' }), error => error.code === 'ERR_TLS_CERT_ALTNAME_INVALID');
+    assert.equal((await request(proxy.port, ca, '/', { headers: { Host: 'wrong.test' } })).status, 421);
+    evidence.checks.certificateTrustAndHostname = true;
+    const manifest = JSON.parse(readFileSync(join(values.BUILD, 'asset-manifest.json'), 'utf8'));
+    const assetPath = manifest.files['main.js'];
+    const asset = await request(proxy.port, ca, assetPath);
+    assert.equal(asset.status, 200);
+    assert.match(asset.headers['content-type'], /application\/javascript/);
+    assert.deepEqual(asset.body, readFileSync(join(values.BUILD, assetPath)));
+    evidence.checks.compiledAssets = true;
+    const routes = ['/primus', '/primus/', '/primus/primus.js', '/external', '/external/', '/api/primus.js', '/api/extra', '/stats-api', '/stats-api/private', '/stats-api/primus'];
+    for (const path of routes) {
+        for (const headers of [{ Host: 'dashboard.test' }, { Host: 'dashboard.test', Upgrade: 'websocket', Connection: 'upgrade' }]) {
+            const response = await request(proxy.port, ca, path, { headers });
+            assert.equal(response.status, 404, path);
