diff --git a/test/fixtures/nginx.cjs b/test/fixtures/nginx.cjs
new file mode 100644
index 0000000..d3c59c4
--- /dev/null
+++ b/test/fixtures/nginx.cjs
@@ -0,0 +1,62 @@
+const assert = require('node:assert/strict');
+const { spawn, spawnSync } = require('node:child_process');
+const { readFileSync, writeFileSync, mkdirSync } = require('node:fs');
+const { once } = require('node:events');
+const { join } = require('node:path');
+const net = require('node:net');
+
+async function availablePort() {
+    const server = net.createServer().listen(0, '127.0.0.1');
+    await once(server, 'listening');
+    const port = server.address().port;
+    await new Promise(resolve => server.close(resolve));
+    return port;
+}
+
+async function startProxy(t, directory, values) {
+    mkdirSync(directory, { recursive: true });
+    const port = await availablePort();
+    const template = readFileSync(join(__dirname, '../../deploy/nginx.conf.template'), 'utf8');
+    const config = template.replace(/@@([A-Z_]+)@@/g, (_, name) => {
+        const value = { RUN: directory, TLS_PORT: port, ...values }[name];
+        assert.ok(value !== undefined && !/["\r\n]/.test(String(value)));
+        return value;
+    });
+    const file = join(directory, 'nginx.conf');
+    writeFileSync(file, config, 'utf8');
+    const args = ['-p', directory + '/', '-c', file];
+    const checked = spawnSync(process.env.TEST_NGINX, [...args, '-t'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });
+    writeFileSync(join(directory, 'config-check.txt'), checked.stdout + checked.stderr, 'utf8');
+    assert.equal(checked.status, 0);
+    const child = spawn(process.env.TEST_NGINX, args, { stdio: ['ignore', 'pipe', 'pipe'] });
+    let output = '';
+    child.stdout.on('data', chunk => { output += chunk; });
+    child.stderr.on('data', chunk => { output += chunk; });
+    const exited = once(child, 'exit');
+    t.after(async () => {
+        if (child.exitCode === null && child.signalCode === null) {
+            child.kill('SIGTERM');
+        }
+        const result = await exited;
+        writeFileSync(join(directory, 'process.json'), JSON.stringify({ pid: child.pid, result, output }) + '\n', 'utf8');
+        assert.deepEqual(result, [0, null]);
+    });
+    for (let attempt = 0; attempt < 50; attempt++) {
+        if (child.exitCode !== null) {
+            throw new Error('nginx exited before readiness: ' + output);
+        }
+        const ready = await new Promise(resolve => {
+            const socket = net.connect({ host: '127.0.0.1', port });
+            socket.once('connect', () => { socket.destroy(); resolve(true); });
+            socket.once('error', () => { socket.destroy(); resolve(false); });
+            socket.setTimeout(100, () => { socket.destroy(); resolve(false); });
+        });
+        if (ready) {
+            return { port, config };
+        }
+        await new Promise(resolve => setTimeout(resolve, 20));
+    }
+    throw new Error('nginx readiness deadline exceeded');
+}
+
+module.exports = startProxy;
diff --git a/test/fixtures/proxy-wire-server.cjs b/test/fixtures/proxy-wire-server.cjs
