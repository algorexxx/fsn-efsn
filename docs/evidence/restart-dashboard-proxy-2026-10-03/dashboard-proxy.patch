@@ -0,0 +1,104 @@
+worker_processes 1;
+daemon off;
+pid "@@RUN@@/nginx.pid";
+error_log "@@RUN@@/nginx-error.log" warn;
+events {
+    worker_connections 256;
+}
+http {
+    types {
+        text/html html;
+        text/css css;
+        application/javascript js;
+        application/json json;
+        image/png png;
+        image/jpeg jpg jpeg;
+        image/svg+xml svg;
+        image/x-icon ico;
+        font/woff woff;
+        font/woff2 woff2;
+        font/ttf ttf;
+    }
+    default_type application/octet-stream;
+    log_format dashboard '$remote_addr $request_method $uri $status $body_bytes_sent';
+    access_log "@@RUN@@/nginx-access.log" dashboard;
+    client_body_temp_path "@@RUN@@/body";
+    proxy_temp_path "@@RUN@@/proxy";
+    fastcgi_temp_path "@@RUN@@/fastcgi";
+    uwsgi_temp_path "@@RUN@@/uwsgi";
+    scgi_temp_path "@@RUN@@/scgi";
+    server_tokens off;
+    client_header_timeout 5s;
+    client_body_timeout 5s;
+    client_max_body_size 1k;
+    client_header_buffer_size 1k;
+    large_client_header_buffers 2 8k;
+    keepalive_timeout 15s;
+    keepalive_requests 100;
+    send_timeout 10s;
+    limit_conn_zone $server_name zone=dashboard:1m;
+    limit_conn_zone $server_name zone=reporters:1m;
+    limit_conn_status 503;
+    server {
+        listen 127.0.0.1:@@TLS_PORT@@ ssl;
+        server_name @@HOST@@;
+        ssl_certificate "@@CERT@@";
+        ssl_certificate_key "@@KEY@@";
+        ssl_protocols TLSv1.2 TLSv1.3;
+        ssl_session_cache shared:dashboard_tls:1m;
+        ssl_session_timeout 10m;
+        ssl_session_tickets off;
+        root "@@BUILD@@";
+        index index.html;
+        limit_conn dashboard 64;
+        if ($host != "@@HOST@@") { return 421; }
+        location = /api {
+            if ($request_method != GET) { return 405; }
+            if ($http_upgrade !~* ^websocket$) { return 426; }
+            limit_conn dashboard 64;
+            limit_conn reporters 12;
+            proxy_pass http://127.0.0.1:@@COLLECTOR_PORT@@;
+            proxy_http_version 1.1;
+            proxy_pass_request_headers off;
+            proxy_pass_request_body off;
+            proxy_set_header Host $host;
+            proxy_set_header Upgrade websocket;
+            proxy_set_header Connection upgrade;
+            proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;
+            proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;
+            proxy_set_header X-Forwarded-For $remote_addr;
+            proxy_set_header X-Forwarded-Port $remote_port;
+            proxy_set_header X-Forwarded-Proto $scheme;
+            proxy_connect_timeout 2s;
+            proxy_read_timeout 45s;
+            proxy_send_timeout 10s;
+            proxy_buffering off;
+            proxy_request_buffering off;
+            proxy_next_upstream off;
+        }
+        location /api { return 404; }
+        location /primus { return 404; }
+        location /external { return 404; }
+        location ~ ^/stats-api/(nodes|blocks|info|charts)$ {
+            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
+            rewrite ^/stats-api/(.*)$ /$1 break;
+            proxy_pass http://127.0.0.1:@@API_PORT@@;
+            proxy_http_version 1.1;
+            proxy_pass_request_headers off;
+            proxy_pass_request_body off;
+            proxy_set_header Host $host;
+            proxy_set_header Connection close;
+            proxy_connect_timeout 2s;
+            proxy_read_timeout 5s;
+            proxy_send_timeout 5s;
+            proxy_buffering off;
+            proxy_cache off;
+            proxy_next_upstream off;
+        }
+        location /stats-api { return 404; }
+        location / {
+            limit_except GET { deny all; }
+            try_files $uri $uri/ =404;
+        }
+    }
+}
