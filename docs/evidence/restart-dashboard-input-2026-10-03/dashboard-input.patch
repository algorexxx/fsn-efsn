+        { path: '/primus', maxLength: 65536, compression: false, guards: 1 },
+        { path: '/external', maxLength: 65536, compression: false, guards: 1 },
+    ]);
+});
+
+test('application allowance refills gradually, stays capped and closes only the over-budget connection', () => {
+    const fixture = inputFixture();
+    const a = fixture.spark();
+    const b = fixture.spark();
+    assert.equal(fixture.receive(a), undefined);
+    assert.equal(fixture.receive(a), undefined);
+    fixture.advance(500);
+    assert.equal(fixture.receive(a), undefined);
+    fixture.advance(10000);
+    assert.equal(fixture.receive(a), undefined);
+    assert.equal(fixture.receive(a), undefined);
+    assert.equal(fixture.receive(a), false);
+    fixture.advance(10000);
+    assert.equal(fixture.receive(a), false);
+    assert.equal(fixture.receive(b), undefined);
+    assert.deepEqual({ a: a.ends, b: b.ends }, { a: 1, b: 0 });
+});
+
+test('a fractional allowance cannot admit another application event', () => {
+    const fixture = inputFixture();
+    const spark = fixture.spark();
+    fixture.receive(spark);
+    fixture.receive(spark);
+    fixture.advance(499);
+    assert.equal(fixture.receive(spark), false);
+    assert.equal(spark.ends, 1);
+});
+
+test('unsupported or malformed application envelopes close before event dispatch', () => {
+    for (const data of [null, [], {}, 'text', { emit: null }, { emit: ['end', {}] }, { emit: ['ready'] }, { emit: ['ready', null] }, { emit: ['ready', []] }, { emit: ['ready', {}, 'extra'] }]) {
+        const fixture = inputFixture();
+        const spark = fixture.spark();
+        assert.equal(fixture.receive(spark, data), false);
+        assert.equal(spark.ends, 1);
+    }
+});
+
+test('silent telemetry connections expire without registering a node', t => {
+    const collector = loadCollector(t);
+    const spark = connectCollector(collector);
+    const deadline = [...collector.timers.values()][0];
+    assert.equal(deadline.delay, 1000);
+    deadline.callback();
+    hello(spark);
+    assert.equal(spark.ended, true);
+    assert.deepEqual(collector.calls, []);
+    assert.equal(collector.timers.size, 0);
+});
+
+test('successful hello and disconnect both cancel their login deadline', t => {
+    const collector = loadCollector(t);
+    const owner = connectCollector(collector);
+    hello(owner);
+    assert.equal(collector.timers.size, 0);
+    const silent = connectCollector(collector, 'silent');
+    silent.handlers.get('end')();
+    assert.equal(collector.timers.size, 0);
+    assert.equal(owner.ended, false);
+});
+
+test('registration that completes after the deadline cannot publish ready and releases its identity', t => {
+    const collector = loadCollector(t, { deferAdd: true });
+    const old = connectCollector(collector);
+    hello(old);
+    [...collector.timers.values()][0].callback();
+    const fresh = connectCollector(collector, 'fresh');
+    hello(fresh);
+    collector.registrations[0]();
+    collector.registrations[1]();
+    assert.equal(old.ended, true);
+    assert.deepEqual(old.emitted, []);
+    assert.deepEqual(fresh.emitted, [{ name: 'ready', data: undefined }]);
+    assert.equal(collector.timers.size, 0);
+});
+
+test('history admits the efsn batch limit and refuses a larger batch before collection', t => {
+    const collector = loadCollector(t);
+    const spark = connectCollector(collector);
+    hello(spark);
+    collector.calls.length = 0;
+    spark.handlers.get('history')({ id: 'node-a', history: Array.from({ length: 50 }, (_, index) => ({ number: index + 1 })) });
+    assert.deepEqual(collector.calls, [{ method: 'addHistory', id: 'node-a' }]);
+    collector.calls.length = 0;
+    spark.handlers.get('history')({ id: 'node-a', history: Array.from({ length: 51 }, (_, index) => ({ number: index + 1 })) });
+    assert.deepEqual(collector.calls, [{ method: 'inactive', spark: 'session-a' }]);
+    assert.equal(spark.ended, true);
+});
