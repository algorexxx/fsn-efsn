diff --git a/test/collector-input-wire.test.cjs b/test/collector-input-wire.test.cjs
new file mode 100644
index 0000000..fa9620b
--- /dev/null
+++ b/test/collector-input-wire.test.cjs
@@ -0,0 +1,146 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const net = require('node:net');
+const startCollector = require('./fixtures/collector-wire.cjs');
+const { secretA } = require('./fixtures/collector.cjs');
+const { connect, waitMessage, send, login, inventory } = require('./fixtures/wire-client.cjs');
+
+test('real telemetry login deadline closes a silent socket and ordinary login still works', { timeout: 10000 }, async t => {
+    const server = await startCollector(t, { COLLECTOR_HELLO_TIMEOUT_MS: '250' });
+    const silent = connect(t, server.port, 'api');
+    await silent.opened;
+    await silent.closed;
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA);
+    const viewer = connect(t, server.port, 'primus');
+    await viewer.opened;
+    assert.deepEqual((await inventory(viewer)).map(node => node.id), ['node-a']);
+    owner.socket.close();
+    viewer.socket.close();
+    await Promise.all([owner.closed, viewer.closed]);
+    await server.stop();
+});
+
+test('real transport refuses a message over its byte limit on every collector path', { timeout: 10000 }, async t => {
+    const server = await startCollector(t, { COLLECTOR_MAX_MESSAGE_BYTES: '2048' });
+    const permitted = connect(t, server.port, 'primus');
+    await permitted.opened;
+    const padding = 2047 - Buffer.byteLength(JSON.stringify({ emit: ['ready', { padding: '' }] }));
+    permitted.socket.send(JSON.stringify({ emit: ['ready', { padding: 'x'.repeat(padding) }] }));
+    await waitMessage(permitted, message => message.emit && message.emit[0] === 'init');
+    permitted.socket.close();
+    await permitted.closed;
+    for (const endpoint of ['api', 'primus', 'external']) {
+        const connection = connect(t, server.port, endpoint);
+        await connection.opened;
+        connection.socket.send(JSON.stringify('Å'.repeat(1024)));
+        const [code] = await connection.closed;
+        assert.equal(code, 1006);
+    }
+    const boundary = connect(t, server.port, 'primus');
+    await boundary.opened;
+    boundary.socket.send(JSON.stringify({ emit: ['ready', { padding: 'x'.repeat(padding + 1) }] }));
+    assert.equal((await boundary.closed)[0], 1006);
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA);
+    owner.socket.close();
+    await owner.closed;
+    await server.stop();
+});
+
+test('real transport counts the aggregate bytes of a fragmented message', { timeout: 10000 }, async t => {
+    const server = await startCollector(t, { COLLECTOR_MAX_MESSAGE_BYTES: '2048' });
+    const connection = connect(t, server.port, 'primus');
+    await connection.opened;
+    const message = JSON.stringify({ emit: ['ready', { padding: 'x'.repeat(2050) }] });
+    connection.socket.send(message.slice(0, 1500), { fin: false });
+    connection.socket.send(message.slice(1500), { fin: true });
+    const [code] = await connection.closed;
+    assert.equal(code, 1006);
+    await server.stop();
+});
+
+test('application message allowance closes the sender and permits a later fresh session', { timeout: 10000 }, async t => {
+    const server = await startCollector(t, { COLLECTOR_MESSAGES_PER_SECOND: '3' });
+    const viewer = connect(t, server.port, 'primus');
+    await viewer.opened;
+    for (let index = 0; index < 4; index++) send(viewer, 'ready', {});
+    await viewer.closed;
+    assert.equal(viewer.messages.filter(message => message.emit && message.emit[0] === 'init').length, 3);
+    const replacement = connect(t, server.port, 'primus');
+    await replacement.opened;
+    assert.deepEqual(await inventory(replacement), []);
+    replacement.socket.close();
+    await replacement.closed;
+    await server.stop();
+});
+
+test('TCP connection budget is shared across paths and a closed slot can be reused', { timeout: 10000 }, async t => {
+    const server = await startCollector(t, { COLLECTOR_MAX_CONNECTIONS: '3', COLLECTOR_HELLO_TIMEOUT_MS: '5000' });
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA);
+    const viewer = connect(t, server.port, 'primus');
+    const external = connect(t, server.port, 'external');
+    await Promise.all([viewer.opened, external.opened]);
+    const extra = net.connect({ host: '127.0.0.1', port: server.port });
+    extra.on('error', () => {});
+    t.after(() => extra.destroy());
+    await new Promise(resolve => extra.once('close', resolve));
+    viewer.socket.close();
+    await viewer.closed;
+    await server.waitForConnections(2);
+    const replacement = connect(t, server.port, 'primus');
+    await replacement.opened;
+    assert.deepEqual((await inventory(replacement)).map(node => node.id), ['node-a']);
+    owner.socket.close();
+    external.socket.close();
+    replacement.socket.close();
+    await Promise.all([owner.closed, external.closed, replacement.closed]);
+    await server.stop();
+});
+
+test('invalid envelopes close before the event plugin and do not interrupt another node', { timeout: 10000 }, async t => {
+    const server = await startCollector(t);
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA);
+    for (const data of [null, { emit: ['end', {}] }, { emit: ['ready', {}, 'extra'] }]) {
+        const invalid = connect(t, server.port, 'primus');
+        await invalid.opened;
+        invalid.socket.send(JSON.stringify(data));
+        await invalid.closed;
+    }
+    const undecodable = connect(t, server.port, 'api');
+    await undecodable.opened;
+    undecodable.socket.send('{');
+    assert.equal((await undecodable.closed)[0], 1006);
+    const viewer = connect(t, server.port, 'primus');
+    await viewer.opened;
+    assert.equal((await inventory(viewer))[0].stats.active, true);
+    owner.socket.close();
+    viewer.socket.close();
+    await Promise.all([owner.closed, viewer.closed]);
+    await server.stop();
+});
+
+test('efsn-sized history reaches collection and an extra entry closes the reporting session', { timeout: 10000 }, async t => {
+    const server = await startCollector(t);
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA);
+    const viewer = connect(t, server.port, 'primus');
+    await viewer.opened;
+    const history = Array.from({ length: 50 }, (_, index) => ({ number: 100 - index, hash: `0x${(100 - index).toString(16).padStart(64, '0')}`, parentHash: '0x' + '0'.repeat(64), difficulty: '1', totalDifficulty: '1', timestamp: 1704067200, gasLimit: 1000000, gasUsed: 0, transactions: [], uncles: [], miner: '0x' + '0'.repeat(40) }));
+    send(owner, 'block', { id: 'node-a', block: history[0] });
+    send(owner, 'history', { id: 'node-a', history });
+    send(owner, 'node-ping', { id: 'node-a', clientTime: 'synthetic-time' });
+    await waitMessage(owner, message => message.emit && message.emit[0] === 'node-pong');
+    const charts = await waitMessage(viewer, message => message.action === 'charts');
+    assert.equal(charts.data.height.length, 40);
+    assert.equal((await inventory(viewer))[0].stats.block.number, 100);
+    send(owner, 'history', { id: 'node-a', history: [...history, history[0]] });
+    await owner.closed;
+    await waitMessage(viewer, message => message.action === 'inactive');
+    assert.equal((await inventory(viewer))[0].stats.active, false);
+    viewer.socket.close();
+    await viewer.closed;
+    await server.stop();
+});
diff --git a/test/collector-input.test.cjs b/test/collector-input.test.cjs
