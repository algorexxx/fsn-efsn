+++ b/test/fixtures/collector-wire.cjs
@@ -0,0 +1,48 @@
+const assert = require('node:assert/strict');
+const { fork } = require('node:child_process');
+const { once } = require('node:events');
+const { join } = require('node:path');
+const environment = require('./collector-environment.cjs');
+const { credentialFile, secretA, secretB } = require('./collector.cjs');
+
+async function startCollector(t, settings = {}) {
+    const file = credentialFile(t, { 'node-a': secretA, 'node-b': secretB });
+    const child = fork(join(__dirname, 'wire-server.cjs'), [], {
+        env: { SystemRoot: process.env.SystemRoot, NODE_ENV: 'production', VERBOSITY: '2', WS_CREDENTIALS_FILE: file, ...environment, ...settings },
+        stdio: ['ignore', 'pipe', 'pipe', 'ipc'],
+    });
+    let logs = '';
+    child.stdout.on('data', chunk => { logs += chunk; });
+    child.stderr.on('data', chunk => { logs += chunk; });
+    const exited = once(child, 'exit');
+    t.after(async () => {
+        if (child.exitCode === null && child.signalCode === null) {
+            child.kill();
+        }
+        await exited;
+        assert.equal(logs.includes(secretA) || logs.includes(secretB), false);
+    });
+    const [address] = await Promise.race([once(child, 'message'), exited.then(() => { throw new Error(`Collector startup failed: ${logs}`); })]);
+    assert.equal(address.address, '127.0.0.1');
+    return {
+        port: address.port,
+        async waitForConnections(expected) {
+            for (let attempt = 0; attempt < 40; attempt++) {
+                const response = once(child, 'message');
+                child.send('connections');
+                const [message] = await response;
+                if (message.connections === expected) {
+                    return;
+                }
+                await new Promise(resolve => setTimeout(resolve, 50));
+            }
+            throw new Error(`Collector TCP connection count did not reach ${expected}`);
+        },
+        async stop() {
+            child.send('stop');
+            assert.deepEqual(await exited, [0, null]);
+        },
+    };
+}
+
+module.exports = startCollector;
