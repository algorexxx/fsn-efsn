diff --git a/lib/collector-input.js b/lib/collector-input.js
new file mode 100644
index 0000000..8ac8a34
--- /dev/null
+++ b/lib/collector-input.js
@@ -0,0 +1,34 @@
+const { performance } = require('perf_hooks');
+
+function limitCollectorInput(primus, events, messagesPerSecond, now = () => performance.now()) {
+    const connections = new WeakMap();
+    primus.on('connection', function (spark) {
+        spark.on('error', function () { spark.request.destroy(); });
+    });
+    primus.transform('incoming', function (packet) {
+        const time = now();
+        let state = connections.get(this);
+        if (!state) {
+            state = { time, allowance: messagesPerSecond, closed: false };
+            connections.set(this, state);
+        }
+        if (state.closed) {
+            return false;
+        }
+        state.allowance = Math.min(messagesPerSecond, state.allowance + Math.max(0, time - state.time) * messagesPerSecond / 1000);
+        state.time = time;
+        const data = packet.data;
+        const validEnvelope = data !== null && typeof data === 'object' && !Array.isArray(data)
+            && Array.isArray(data.emit) && data.emit.length === 2
+            && events.includes(data.emit[0]) && data.emit[1] !== null
+            && typeof data.emit[1] === 'object' && !Array.isArray(data.emit[1]);
+        if (!validEnvelope || state.allowance < 1) {
+            state.closed = true;
+            this.end(undefined, { reconnect: false });
+            return false;
+        }
+        state.allowance -= 1;
+    });
+}
+
+module.exports = limitCollectorInput;
