+    assert.equal(collector.listening, false);
+    assert.equal(collector.sockets.size, 0);
+});
+
+test('all collector WebSocket paths receive the transport byte limit without compression', t => {
+    const collector = loadCollector(t);
+    assert.equal(collector.server.maxConnections, 16);
