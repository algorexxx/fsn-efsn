index 0000000..d7904d4
--- /dev/null
+++ b/test/collector-input.test.cjs
@@ -0,0 +1,131 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const limitCollectorInput = require('../lib/collector-input');
+const { loadCollectorConfig } = require('../lib/deployment-config');
+const environment = require('./fixtures/collector-environment.cjs');
+const { loadCollector, connectCollector, hello } = require('./fixtures/collector.cjs');
+
+function inputFixture() {
+    let incoming;
+    let time = 0;
+    limitCollectorInput({ on() {}, transform(name, handler) { assert.equal(name, 'incoming'); incoming = handler; } }, ['ready'], 2, () => time);
+    return {
+        spark() { return { ends: 0, end() { this.ends++; } }; },
+        receive(spark, data = { emit: ['ready', {}] }) { return incoming.call(spark, { data }); },
+        advance(milliseconds) { time += milliseconds; },
+    };
+}
+
+test('collector input configuration has explicit finite limits and rejects missing or invalid limits', () => {
+    assert.deepEqual(loadCollectorConfig(environment), { host: '127.0.0.1', port: 0, maxBytes: 65536, maxConnections: 16, helloTimeoutMs: 1000, messagesPerSecond: 100 });
+    for (const name of Object.keys(environment).filter(name => !['COLLECTOR_HOST', 'COLLECTOR_PORT'].includes(name))) {
+        for (const value of [undefined, '', '0', '-1', '1.5', ' 10', '10x', '2147483648']) {
+            assert.throws(() => loadCollectorConfig({ ...environment, [name]: value }), new RegExp(name));
+        }
+    }
+});
+
+test('missing collector input limits stop before constructing any listener', t => {
