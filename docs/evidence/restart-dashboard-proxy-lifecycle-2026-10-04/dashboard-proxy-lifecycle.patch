@@ -0,0 +1,18 @@
+/var/log/fsn-stats-proxy/nginx-access.log /var/log/fsn-stats-proxy/nginx-error.log {
+    daily
+    maxsize 8M
+    rotate 7
+    maxage 7
+    missingok
+    notifempty
+    compress
+    delaycompress
+    create 0640 fsn-stats-proxy fsn-stats-proxy
+    su fsn-stats-proxy fsn-stats-proxy
+    sharedscripts
+    postrotate
+        if /usr/bin/systemctl --quiet is-active fsn-stats-proxy.service; then
+            /usr/bin/systemctl kill --kill-whom=main --signal=USR1 fsn-stats-proxy.service
+        fi
+    endscript
+}
