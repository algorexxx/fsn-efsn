+[Unit]
+Description=Rotate Fusion dashboard proxy logs
+
+[Service]
+Type=oneshot
+ExecStart=/usr/sbin/logrotate --state /var/lib/fsn-stats-logrotate/status /etc/fsn-stats/logrotate.conf
