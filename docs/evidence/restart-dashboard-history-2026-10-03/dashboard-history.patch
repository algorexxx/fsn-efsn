diff --git a/test/history-wire.test.cjs b/test/history-wire.test.cjs
new file mode 100644
index 0000000..cdf3b49
--- /dev/null
+++ b/test/history-wire.test.cjs
@@ -0,0 +1,41 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const startCollector = require('./fixtures/collector-wire.cjs');
+const { secretA } = require('./fixtures/collector.cjs');
+const { connect, login, send, inventory, waitMessage } = require('./fixtures/wire-client.cjs');
+
+function block(number) {
+    return { number, hash: '0x' + number.toString(16).padStart(64, '0'), difficulty: '1', totalDifficulty: '2', timestamp: number * 10, transactions: [], uncles: [], ticketNumber: 0 };
+}
+
+test('collector backfills requested gaps and broadcasts the newest forty heights as heads advance', { timeout: 15000 }, async t => {
+    const server = await startCollector(t);
+    const viewer = connect(t, server.port, 'primus');
+    await viewer.opened;
+    const owner = connect(t, server.port, 'api');
+    await login(owner, 'node-a', secretA);
+    send(owner, 'block', { id: 'node-a', block: block(100) });
+    send(owner, 'latency', { id: 'node-a', latency: '12' });
+    const request = await waitMessage(owner, message => message.emit && message.emit[0] === 'history');
+    assert.deepEqual(request.emit[1], { min: 50, max: 99, list: Array.from({ length: 50 }, (_, index) => 50 + index) });
+    send(owner, 'history', { id: 'node-a', history: request.emit[1].list.slice().reverse().map(block) });
+    await inventory(viewer);
+    const initial = await waitMessage(viewer, message => message.action === 'charts' && message.data.height.length === 40);
+    assert.deepEqual(initial.data.height, Array.from({ length: 40 }, (_, index) => 61 + index));
+    assert.deepEqual(initial.data.ticketNumber, Array(40).fill(0));
+    const ownerFrom = owner.messages.length;
+    send(owner, 'latency', { id: 'node-a', latency: '12' });
+    const remaining = await waitMessage(owner, message => message.emit && message.emit[0] === 'history', ownerFrom);
+    assert.deepEqual(remaining.emit[1], { min: 1, max: 49, list: Array.from({ length: 49 }, (_, index) => 1 + index) });
+    send(owner, 'history', { id: 'node-a', history: remaining.emit[1].list.slice().reverse().map(block) });
+    const viewerFrom = viewer.messages.length;
+    send(owner, 'block', { id: 'node-a', block: block(101) });
+    const advanced = await waitMessage(viewer, message => message.action === 'charts' && message.data.height[39] === 101, viewerFrom);
+    assert.deepEqual(advanced.data.height, Array.from({ length: 40 }, (_, index) => 62 + index));
+    assert.equal(viewer.messages.filter(message => message.action === 'charts').every(message => message.data && Array.isArray(message.data.height)), true);
+    assert.equal((await inventory(viewer))[0].stats.block.number, 101);
+    viewer.socket.close();
+    owner.socket.close();
+    await Promise.all([viewer.closed, owner.closed]);
+    await server.stop();
+});
diff --git a/test/history.test.cjs b/test/history.test.cjs
new file mode 100644
index 0000000..718af4e
--- /dev/null
+++ b/test/history.test.cjs
@@ -0,0 +1,199 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const History = require('../lib/history');
+const Collection = require('../lib/collection');
+
+function block(number, fork = 0) {
+    return { number, hash: '0x' + (number * 100 + fork).toString(16).padStart(64, '0'), parentHash: '0x' + '0'.repeat(64), difficulty: String(number), totalDifficulty: String(number * 2), timestamp: number * 10, miner: 'miner-a', transactions: [], uncles: [], gasLimit: number, gasUsed: number, ticketNumber: number, myTicketNumber: number };
+}
+
+function charts(history) {
+    let result;
+    history.setCallback((error, value) => { assert.equal(error, null); result = value; });
+    history.getCharts();
+    return result;
+}
+
+test('a partly filled cache accepts advancing heads and out-of-order reports', () => {
+    const history = new History(() => 1000);
+    history.add(block(100), 'node-a', false);
+    history.add(block(102), 'node-a', false);
+    history.add(block(101), 'node-b', false);
+
+    const result = charts(history);
+
+    assert.deepEqual(result.height, [100, 101, 102]);
+});
+
+test('charts take the newest forty heights before reversing and keep every series aligned', () => {
+    const history = new History(() => 1000);
+    const expected = Array.from({ length: 40 }, (_, index) => 61 + index);
+    history.add(block(100), 'node-a', true);
+    for (let height = 99; height >= 51; height--) {
+        history.add(block(height), 'node-a', true, true);
+    }
+
+    const result = charts(history);
+    const standalone = [history.getGasLimit(), history.getGasSpending(), history.getDifficulty(), history.getTicketNumber(), history.getmyTicketNumber()];
+
+    assert.deepEqual(result.height, expected);
+    assert.deepEqual([result.gasLimit, result.gasSpending, result.ticketNumber, result.myTicketNumber], [expected, expected, expected, expected]);
+    assert.deepEqual(result.difficulty, expected.map(String));
+    assert.deepEqual(standalone, [expected, expected, expected.map(String), expected, expected]);
+    assert.deepEqual(history._items.map(item => item.height), Array.from({ length: 50 }, (_, index) => 100 - index));
+});
+
+test('a moving two-thousand-height window evicts old reports and rejects later backfill below its floor', () => {
+    const history = new History(() => 1000);
+    history.add(block(2000), 'node-a', false);
+    history.add(block(1), 'node-a', false, true);
+    history.add(block(2001), 'node-a', false);
+    history.add(block(2), 'node-a', false, true);
+    history.add(block(1), 'node-a', false, true);
+
+    const firstWindow = history._items.map(item => item.height);
+    history.add(block(5001), 'node-a', false);
+
+    assert.deepEqual(firstWindow, [2001, 2000, 2]);
+    assert.deepEqual(history._items.map(item => item.height), [5001]);
+});
+
+test('full cache retains exactly the two thousand most recent positive heights', () => {
+    const history = new History(() => 1000);
+    for (let height = 2001; height >= 1; height--) {
+        history.add(block(height), 'node-a', false, true);
+    }
+
+    const retained = history._items.map(item => item.height);
+    const displayed = charts(history).height;
+
+    assert.deepEqual(retained, Array.from({ length: 2000 }, (_, index) => 2001 - index));
+    assert.deepEqual(displayed, Array.from({ length: 40 }, (_, index) => 1962 + index));
+    assert.equal(history.requiresUpdate(), false);
+    assert.equal(history.getHistoryRequestRange(), false);
+});
+
+test('history requests contain the newest fifty missing positive heights in ascending order', () => {
+    const history = new History(() => 1000);
+    history.add(block(100), 'node-a', false);
+
+    const result = history.getHistoryRequestRange();
+
+    assert.deepEqual(result, { min: 50, max: 99, list: Array.from({ length: 50 }, (_, index) => 50 + index) });
+    assert.equal(history.requiresUpdate(), true);
+});
+
+test('history request completion handles empty, genesis-only and contiguous short histories', () => {
+    const history = new History(() => 1000);
+    const before = { range: history.getHistoryRequestRange(), needsUpdate: history.requiresUpdate() };
+    history.add(block(0), 'node-a', false, true);
+    history.add(block(3), 'node-a', false);
+    history.add(block(1), 'node-a', false, true);
+    const gap = history.getHistoryRequestRange();
+    history.add(block(2), 'node-a', false, true);
+
+    const after = { range: history.getHistoryRequestRange(), needsUpdate: history.requiresUpdate() };
+
+    assert.deepEqual(before, { range: false, needsUpdate: false });
+    assert.deepEqual(gap, { min: 2, max: 2, list: [2] });
+    assert.deepEqual(after, { range: false, needsUpdate: false });
+});
+
+test('changing one node report releases unused forks while preserving the representative', () => {
+    const history = new History(() => 1000);
+    for (let fork = 0; fork < 12; fork++) {
+        history.add(block(100, fork), 'node-a', false);
+    }
+
+    const item = history.search(100);
+
+    assert.deepEqual(item.forks.map(value => value.hash), [block(100, 0).hash, block(100, 11).hash]);
+    assert.equal(item.block.hash, block(100, 0).hash);
+    assert.deepEqual(item.propagTimes.map(value => ({ node: value.node, fork: value.fork })), [{ node: 'node-a', fork: 1 }]);
+});
+
+test('two reporting nodes keep their distinct forks and indices remain consistent when one switches', () => {
+    const history = new History(() => 1000);
+    history.add(block(100, 0), 'node-a', false);
+    history.add(block(100, 1), 'node-b', false);
+    history.add(block(100, 2), 'node-a', false);
+    history.add(block(100, 3), 'node-a', false);
+
+    const before = history.search(100).forks.map(value => value.hash);
+    history.add(block(100, 1), 'node-a', false);
+    const item = history.search(100);
+
+    assert.deepEqual(before, [block(100, 0).hash, block(100, 1).hash, block(100, 3).hash]);
+    assert.deepEqual(item.forks.map(value => ({ hash: value.hash, fork: value.fork })), [{ hash: block(100, 0).hash, fork: 0 }, { hash: block(100, 1).hash, fork: 1 }]);
+    assert.deepEqual(item.propagTimes.map(value => ({ node: value.node, fork: value.fork })), [{ node: 'node-a', fork: 1 }, { node: 'node-b', fork: 1 }]);
+});
+
+test('trusted representative selection is preserved while abandoned forks are reclaimed', () => {
+    const history = new History(() => 1000);
+    history.add(block(100, 0), 'node-a', false);
+    history.add(block(100, 1), 'node-b', true);
+    history.add(block(100, 2), 'node-b', true);
+
+    const item = history.search(100);
+
+    assert.deepEqual(item.forks.map(value => value.hash), [block(100, 0).hash, block(100, 2).hash]);
+    assert.equal(item.block.hash, block(100, 2).hash);
+    assert.equal(item.block.trusted, true);
+    assert.deepEqual(item.propagTimes.map(value => ({ node: value.node, fork: value.fork })), [{ node: 'node-a', fork: 0 }, { node: 'node-b', fork: 1 }]);
+});
+
+test('duplicate reports preserve propagation timing but a changed fork receives a new receipt', () => {
+    let now = 1000;
+    const history = new History(() => now);
+    history.add(block(100), 'node-a', false);
+    now = 1500;
+    history.add(block(100), 'node-b', false);
+    now = 2000;
+    const duplicate = history.add(block(100), 'node-b', false);
+    now = 3000;
+    const switched = history.add(block(100, 1), 'node-b', false);
+
+    assert.deepEqual({ arrived: duplicate.block.arrived, received: duplicate.block.received, propagation: duplicate.block.propagation }, { arrived: 1000, received: 1500, propagation: 500 });
+    assert.deepEqual({ arrived: switched.block.arrived, received: switched.block.received, propagation: switched.block.propagation }, { arrived: 3000, received: 3000, propagation: 0 });
+    assert.deepEqual(history.search(100).propagTimes.map(value => ({ node: value.node, received: value.received, propagation: value.propagation })), [{ node: 'node-a', received: 1000, propagation: 0 }, { node: 'node-b', received: 3000, propagation: 0 }]);
+});
+
+test('ticket charts preserve zero and missing values at their original heights', () => {
+    const history = new History(() => 1000);
+    history.add({ ...block(3), ticketNumber: 4, myTicketNumber: 1 }, 'node-a', false);
+    history.add({ ...block(2), ticketNumber: 0, myTicketNumber: 0 }, 'node-a', false, true);
+    history.add({ ...block(1), ticketNumber: undefined, myTicketNumber: undefined }, 'node-a', false, true);
+
+    const result = charts(history);
+
+    assert.deepEqual(result.height, [1, 2, 3]);
+    assert.deepEqual(result.ticketNumber, [null, 0, 4]);
+    assert.deepEqual(result.myTicketNumber, [null, 0, 1]);
+});
+
+test('malformed history reports cannot partially mutate the cache or leave their callback pending', t => {
+    const collection = new Collection({ write() {} }, () => 1000);
+    const callbacks = [];
+    collection.add({ id: 'node-a', info: {}, ip: '127.0.0.1', spark: 'a' }, () => {});
+    t.after(() => { if (collection._debounced) { collection._debounced.cancel(); } });
+
+    collection.addHistory('node-a', [block(100), { ...block(99), transactions: null }], error => callbacks.push(error));
+
+    assert.deepEqual(callbacks, ['Invalid history report']);
+    assert.deepEqual(collection.getHistory()._items, []);
+});
+
+test('valid history completes once, does not reorder caller data and shares the injected receipt clock', t => {
+    const collection = new Collection({ write() {} }, () => 1234);
+    const callbacks = [];
+    const input = [block(100), block(99)];
+    collection.add({ id: 'node-a', info: {}, ip: '127.0.0.1', spark: 'a' }, () => {});
+    t.after(() => { if (collection._debounced) { collection._debounced.cancel(); } });
+
+    collection.addHistory('node-a', input, error => callbacks.push(error));
+
+    assert.deepEqual(callbacks, [null]);
+    assert.deepEqual(input.map(value => value.number), [100, 99]);
+    assert.deepEqual(collection.getHistory()._items.map(item => item.block.arrived), [1234, 1234]);
+    assert.deepEqual(collection.getNode({ id: 'node-a' }).reports, { block: null, stats: null, pending: null });
+});
