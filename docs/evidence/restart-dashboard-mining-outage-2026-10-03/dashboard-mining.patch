@@ -25,6 +25,7 @@ async function startCollector(t, settings = {}, fixture = 'wire-server.cjs', cre
     const [address] = await Promise.race([once(child, 'message'), exited.then(() => { throw new Error(`Collector startup failed: ${logs}`); })]);
     assert.equal(address.address, '127.0.0.1');
     return {
+        pid: child.pid,
         port: address.port,
         tlsPort: address.tlsPort,
         apiPort: address.apiPort,
@@ -49,6 +50,10 @@ async function startCollector(t, settings = {}, fixture = 'wire-server.cjs', cre
             child.send('stop');
             assert.deepEqual(await exited, [0, null]);
         },
+        async terminate() {
+            child.kill('SIGTERM');
+            assert.deepEqual(await exited, [null, 'SIGTERM']);
+        },
     };
 }
 
