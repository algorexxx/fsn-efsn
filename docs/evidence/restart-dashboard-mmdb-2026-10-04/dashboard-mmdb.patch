-module.exports = { loadListenerConfig, loadDatabaseConfig, loadPersistenceUrl, loadPersistenceConfig, loadApiConfig, loadCollectorConfig };
+function loadGeoipConfig(environment) {
+    if (environment.GEODATADIR !== undefined) {
+        throw new Error('GEODATADIR is unsupported; configure GEOIP_MODE and MMDB settings');
+    }
+    const mode = requiredSetting(environment, 'GEOIP_MODE');
+    if (mode === 'disabled') {
+        if (['GEOIP_DATABASE_FILE', 'GEOIP_DATABASE_SHA256', 'GEOIP_MAX_BYTES'].some(name => environment[name] !== undefined)) {
+            throw new Error('Disabled GeoIP must not have database settings');
+        }
+        return {mode};
+    }
+    if (mode !== 'mmdb') {
+        throw new Error('GEOIP_MODE must be mmdb or disabled');
+    }
+    const file = requiredSetting(environment, 'GEOIP_DATABASE_FILE');
+    if (!isAbsolute(file)) {
+        throw new Error('GEOIP_DATABASE_FILE must be an absolute path');
+    }
+    const sha256 = requiredSetting(environment, 'GEOIP_DATABASE_SHA256');
+    if (!/^[0-9a-f]{64}$/.test(sha256)) {
+        throw new Error('GEOIP_DATABASE_SHA256 must be 64 lowercase hexadecimal characters');
+    }
+    return {mode, file, sha256, maxBytes: positiveInteger(environment, 'GEOIP_MAX_BYTES')};
+}
+
+module.exports = { loadListenerConfig, loadDatabaseConfig, loadPersistenceUrl, loadPersistenceConfig, loadApiConfig, loadCollectorConfig, loadGeoipConfig };
