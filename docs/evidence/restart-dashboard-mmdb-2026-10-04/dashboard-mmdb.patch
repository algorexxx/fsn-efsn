new file mode 100644
index 0000000000000000000000000000000000000000..289c377ce18eb90547ed9ea757ace94378820a9e
--- /dev/null
+++ b/lib/geoip.js
@@ -0,0 +1,85 @@
+const fs = require('node:fs');
+const {createHash} = require('node:crypto');
+const {isIP} = require('node:net');
+const {Reader} = require('mmdb-lib');
+
+function loadGeoip(config) {
+    if (config.mode === 'disabled') {
+        return {lookup: () => null, database: null};
+    }
+    const buffer = readDatabase(config);
+    const reader = new Reader(buffer);
+    validateMetadata(reader.metadata, buffer.length);
+    return {
+        lookup: ip => lookupAddress(reader, ip),
+        database: {sha256: config.sha256, bytes: buffer.length, type: reader.metadata.databaseType,
+            buildEpoch: reader.metadata.buildEpoch.toISOString()},
+    };
+}
+
+function readDatabase(config) {
+    if (!fs.lstatSync(config.file).isFile()) {
+        throw new Error('GeoIP database must be a regular file without a symlink');
+    }
+    const resolved = fs.realpathSync(config.file);
+    const fd = fs.openSync(resolved, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
+    try {
+        const before = fs.fstatSync(fd, {bigint: true});
+        if (!before.isFile() || before.size === 0n || before.size > BigInt(config.maxBytes)) {
+            throw new Error('GeoIP database must be nonempty and within GEOIP_MAX_BYTES');
+        }
+        const buffer = Buffer.alloc(Number(before.size));
+        let offset = 0;
+        while (offset < buffer.length) {
+            const count = fs.readSync(fd, buffer, offset, buffer.length - offset, offset);
+            if (count === 0) {
+                throw new Error('GeoIP database ended during loading');
+            }
+            offset += count;
+        }
+        verifyUnchanged(config.file, resolved, fd, before);
+        if (createHash('sha256').update(buffer).digest('hex') !== config.sha256) {
+            throw new Error('GeoIP database does not match GEOIP_DATABASE_SHA256');
+        }
+        return buffer;
+    } finally {
+        fs.closeSync(fd);
+    }
+}
+
+function verifyUnchanged(file, resolved, fd, before) {
+    const current = fs.lstatSync(file, {bigint: true});
+    const handle = fs.fstatSync(fd, {bigint: true});
+    const changed = ['dev', 'ino', 'size', 'mtimeNs', 'ctimeNs'].some(key => before[key] !== current[key] || before[key] !== handle[key]);
+    if (!current.isFile() || fs.realpathSync(file) !== resolved || changed) {
+        throw new Error('GeoIP database changed during loading');
+    }
+}
+
+function validateMetadata(metadata, bytes) {
+    if (!['GeoLite2-City', 'GeoIP2-City'].includes(metadata.databaseType) || metadata.ipVersion !== 6 ||
+        metadata.binaryFormatMajorVersion !== 2 || metadata.binaryFormatMinorVersion !== 0 ||
+        !Number.isSafeInteger(metadata.nodeCount) || metadata.nodeCount <= 0 ||
+        !Number.isSafeInteger(metadata.searchTreeSize) || metadata.searchTreeSize + 16 >= bytes ||
+        !Number.isFinite(metadata.buildEpoch.getTime()) || metadata.buildEpoch.getTime() < 0) {
+        throw new Error('GeoIP database must be a supported IPv4/IPv6 City MMDB');
+    }
+}
+
+function lookupAddress(reader, ip) {
+    if (typeof ip !== 'string' || !isIP(ip)) {
+        return null;
+    }
+    const record = reader.get(ip);
+    const country = record?.country?.iso_code;
+    if (typeof country !== 'string' || !/^[A-Z]{2}$/.test(country)) {
+        return null;
+    }
+    const latitude = record.location?.latitude;
+    const longitude = record.location?.longitude;
+    const hasCoordinates = Number.isFinite(latitude) && Number.isFinite(longitude) &&
+        Math.abs(latitude) <= 90 && Math.abs(longitude) <= 180;
+    return {country, ll: hasCoordinates ? [latitude, longitude] : null};
+}
+
+module.exports = loadGeoip;
