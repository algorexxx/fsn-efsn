+    const actual = {ip: node.info.ip, geo: node.geo};
+
+    assert.deepEqual(actual, expected);
+});
+
+test('collector refuses missing mode or invalid configured database before creating sockets', t => {
+    const inputs = [{GEOIP_MODE: undefined}, {...environment, GEOIP_DATABASE_SHA256: '0'.repeat(64)}];
+    const expected = [{listening: false, sockets: 0, error: 'GEOIP_MODE must be explicitly configured'},
+        {listening: false, sockets: 0, error: 'GeoIP database does not match GEOIP_DATABASE_SHA256'}];
+
+    const actual = inputs.map(settings => { const collector = loadCollector(t, {environment: settings}); return {listening: collector.listening, sockets: collector.sockets.size, error: collector.startupError?.message}; });
+
+    assert.deepEqual(actual, expected);
+});
+
+test('CLI validates the configured file and reports its accepted metadata', () => {
+    const args = [path.join(__dirname, '../deploy/validate-geoip.cjs')];
+    const expected = {mode: 'mmdb', database: {sha256: cityHash, bytes: 21088, type: 'GeoLite2-City', buildEpoch: '2026-02-04T22:49:29.000Z'}};
