+const assert = require('node:assert/strict');
+const {test} = require('node:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const {spawnSync} = require('node:child_process');
+const {Reader} = require('mmdb-lib');
+const loadGeoip = require('../lib/geoip');
+const {loadGeoipConfig} = require('../lib/deployment-config');
+const {loadCollector, connectCollector, hello} = require('./fixtures/collector.cjs');
+const Node = require('../lib/node');
+
+const city = path.join(__dirname, 'fixtures/geoip/city.mmdb');
+const cityHash = 'f936702b51dcb6c94b286d77a6f182c31a1601baf4b27e8e896934deb41f49f2';
+const environment = {GEOIP_MODE: 'mmdb', GEOIP_DATABASE_FILE: city, GEOIP_DATABASE_SHA256: cityHash, GEOIP_MAX_BYTES: '21088'};
+
+function capture(operation) {
+    try {
+        return operation();
+    } catch (error) {
+        return {error: error.message};
+    }
+}
+
+function copyDatabase(t) {
+    const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'fsn-mmdb-'));
+    const file = path.join(directory, 'city.mmdb');
+    fs.copyFileSync(city, file);
+    t.after(() => fs.rmSync(directory, {recursive: true, force: true}));
+    return file;
+}
+
+test('requires explicit mode and validated MMDB settings', () => {
+    const invalid = [
+        [{}, /GEOIP_MODE/], [{GEOIP_MODE: 'unknown'}, /GEOIP_MODE/],
+        [{GEOIP_MODE: ' disabled'}, /GEOIP_MODE/],
+        [{GEOIP_MODE: 'disabled', GEODATADIR: '/old'}, /GEODATADIR/],
+        [{GEOIP_MODE: 'disabled', GEOIP_DATABASE_FILE: city}, /Disabled GeoIP/],
+        [{GEOIP_MODE: 'disabled', GEOIP_DATABASE_SHA256: cityHash}, /Disabled GeoIP/],
+        [{GEOIP_MODE: 'disabled', GEOIP_MAX_BYTES: '1'}, /Disabled GeoIP/],
+        [{...environment, GEOIP_DATABASE_FILE: undefined}, /GEOIP_DATABASE_FILE/],
+        [{...environment, GEOIP_DATABASE_FILE: 'relative.mmdb'}, /absolute path/],
+        [{...environment, GEOIP_DATABASE_SHA256: undefined}, /GEOIP_DATABASE_SHA256/],
+        [{...environment, GEOIP_DATABASE_SHA256: cityHash.toUpperCase()}, /lowercase/],
+        [{...environment, GEOIP_DATABASE_SHA256: 'not-a-hash'}, /hexadecimal/],
+        [{...environment, GEOIP_MAX_BYTES: undefined}, /GEOIP_MAX_BYTES/],
+        [{...environment, GEOIP_MAX_BYTES: '0'}, /GEOIP_MAX_BYTES/],
+        [{...environment, GEOIP_MAX_BYTES: '1.5'}, /GEOIP_MAX_BYTES/],
+        [{...environment, GEOIP_MAX_BYTES: '2147483648'}, /GEOIP_MAX_BYTES/],
+    ];
+    const expected = {mode: 'mmdb', file: city, sha256: cityHash, maxBytes: 21088};
+    const expectedMatches = [true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true];
+
+    const actual = loadGeoipConfig(environment);
+    const errors = invalid.map(([settings]) => capture(() => loadGeoipConfig(settings)).error);
+    const matches = errors.map((error, index) => invalid[index][1].test(error));
+
+    assert.deepEqual(actual, expected);
+    assert.deepEqual(matches, expectedMatches);
+});
+
+test('disabled geography is explicit and performs no database reads', t => {
+    const config = loadGeoipConfig({GEOIP_MODE: 'disabled'});
+    t.mock.method(fs, 'lstatSync', () => { throw new Error('Unexpected file read'); });
+    const expected = {database: null, geo: null};
+
+    const geoip = loadGeoip(config);
+    const actual = {database: geoip.database, geo: geoip.lookup('2.125.160.216')};
+
+    assert.deepEqual(actual, expected);
+});
+
+test('loads the published City fixture at the exact byte budget', () => {
+    const config = loadGeoipConfig(environment);
+    const expected = {sha256: cityHash, bytes: 21088, type: 'GeoLite2-City', buildEpoch: '2026-02-04T22:49:29.000Z'};
+
+    const actual = loadGeoip(config).database;
+
+    assert.deepEqual(actual, expected);
+});
+
+test('returns published IPv4 and IPv6 locations, mapped equivalents and unavailable results', () => {
+    const geoip = loadGeoip(loadGeoipConfig(environment));
+    const inputs = ['2.125.160.216', '::ffff:2.125.160.216', '::FFFF:027D:A0D8', '2001:218::', '127.0.0.1', 'invalid', null, '999.1.1.1'];
+    const expected = [{country: 'GB', ll: [51.75, -1.25]}, {country: 'GB', ll: [51.75, -1.25]},
+        {country: 'GB', ll: [51.75, -1.25]}, {country: 'JP', ll: [35.68536, 139.75309]}, null, null, null, null];
+
+    const actual = inputs.map(geoip.lookup);
+
+    assert.deepEqual(actual, expected);
+});
+
+for (const [record, expected] of [
+    [null, null], [{}, null], [{registered_country: {iso_code: 'SE'}}, null],
+    [{country: {iso_code: 'SE'}}, {country: 'SE', ll: null}],
+    [{country: {iso_code: 'SE'}, location: {latitude: 0, longitude: 0}}, {country: 'SE', ll: [0, 0]}],
+    [{country: {iso_code: 'SE'}, location: {latitude: 91, longitude: 18}}, {country: 'SE', ll: null}],
+    [{country: {iso_code: 'SE'}, location: {latitude: 59, longitude: 181}}, {country: 'SE', ll: null}],
+    [{country: {iso_code: 'SE'}, location: {latitude: 59}}, {country: 'SE', ll: null}],
+    [{country: {iso_code: 'SE'}, location: {latitude: null, longitude: null}}, {country: 'SE', ll: null}],
+    [{country: {iso_code: 'se'}, location: {latitude: 59, longitude: 18}}, null],
+]) {
+    test('maps optional provider fields without inventing geography: ' + JSON.stringify(record), t => {
+        const geoip = loadGeoip(loadGeoipConfig(environment));
+        t.mock.method(Reader.prototype, 'get', () => record);
+
+        const actual = geoip.lookup('2001:db8::1');
+
+        assert.deepEqual(actual, expected);
+    });
+}
+
+test('refuses files exceeding the byte budget before constructing the reader', () => {
+    const config = loadGeoipConfig({...environment, GEOIP_MAX_BYTES: '21087'});
+    const expected = {error: 'GeoIP database must be nonempty and within GEOIP_MAX_BYTES'};
+
+    const actual = capture(() => loadGeoip(config));
+
+    assert.deepEqual(actual, expected);
+});
+
+test('refuses a mismatched expected hash before decoding', () => {
+    const config = loadGeoipConfig({...environment, GEOIP_DATABASE_SHA256: '0'.repeat(64)});
+    const expected = {error: 'GeoIP database does not match GEOIP_DATABASE_SHA256'};
+
+    const actual = capture(() => loadGeoip(config));
