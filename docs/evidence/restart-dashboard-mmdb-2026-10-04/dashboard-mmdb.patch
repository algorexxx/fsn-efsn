+    assert.deepEqual(actual, expected);
+});
+
+test('refuses a non-City MMDB with an otherwise matching hash', () => {
+    const config = loadGeoipConfig({...environment, GEOIP_DATABASE_FILE: path.join(__dirname, 'fixtures/geoip/not-city.mmdb'), GEOIP_DATABASE_SHA256: '599f1555ce3a568c2d4ad965332dcba87d0d109297636f1b595241247263d98b'});
+    const expected = {error: 'GeoIP database must be a supported IPv4/IPv6 City MMDB'};
+
+    const actual = capture(() => loadGeoip(config));
+
+    assert.deepEqual(actual, expected);
+});
+
+for (const mode of ['empty', 'directory', 'symlink']) {
+    test('refuses a database that is ' + mode, t => {
+        const file = copyDatabase(t);
+        fs.unlinkSync(file);
+        if (mode === 'empty') { fs.writeFileSync(file, ''); }
+        if (mode === 'directory') { fs.mkdirSync(file); }
+        if (mode === 'symlink') { fs.symlinkSync(city, file); }
+        const config = loadGeoipConfig({...environment, GEOIP_DATABASE_FILE: file});
+        const expected = {error: mode === 'empty' ? 'GeoIP database must be nonempty and within GEOIP_MAX_BYTES' : 'GeoIP database must be a regular file without a symlink'};
+
+        const actual = capture(() => loadGeoip(config));
+
+        assert.deepEqual(actual, expected);
+    });
+}
+
+test('detects a database changed during reading and closes its descriptor', t => {
+    const file = copyDatabase(t);
+    const config = loadGeoipConfig({...environment, GEOIP_DATABASE_FILE: file});
+    const read = fs.readSync;
+    let descriptor;
+    t.mock.method(fs, 'readSync', (...args) => { descriptor = args[0]; const count = read(...args); fs.appendFileSync(file, 'x'); return count; });
+    const expected = {error: 'GeoIP database changed during loading'};
+    const expectedClosed = /^EBADF:/;
+
+    const actual = capture(() => loadGeoip(config));
+    const closed = capture(() => fs.fstatSync(descriptor));
+
+    assert.deepEqual(actual, expected);
+    assert.match(closed.error, expectedClosed);
+});
+
+test('keeps the loaded bytes stable if the file is removed after loading', t => {
+    const file = copyDatabase(t);
+    const geoip = loadGeoip(loadGeoipConfig({...environment, GEOIP_DATABASE_FILE: file}));
+    const expected = {country: 'GB', ll: [51.75, -1.25]};
+    fs.unlinkSync(file);
+
+    const actual = geoip.lookup('2.125.160.216');
+
+    assert.deepEqual(actual, expected);
+});
+
+test('collector derives geography from the connection and passes it through the real node model', t => {
+    const collector = loadCollector(t, {environment});
+    const spark = connectCollector(collector);
+    spark.address.ip = '::FFFF:027D:A0D8';
+    const expected = {ip: '::FFFF:027D:A0D8', geo: {country: 'GB', ll: [51.75, -1.25]}};
+
+    hello(spark);
