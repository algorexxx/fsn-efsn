@@ -0,0 +1,77 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { join } = require('node:path');
+const { loadListenerConfig, loadDatabaseConfig, loadPersistenceUrl } = require('../lib/deployment-config');
+const loadApiPath = require('../react-frontend/src/config');
+const { credentialFile } = require('./fixtures/collector.cjs');
+
+function databaseEnvironment(t, password = 'synthetic database password') {
+    return {
+        DB_HOST: '127.0.0.1', DB_PORT: '5439', DB_NAME: 'stats_test', DB_USER: 'stats_writer',
+        DB_PASSWORD_FILE: credentialFile(t, password, true),
+    };
+}
+
+test('listeners accept explicit loopback addresses and ephemeral or fixed ports', () => {
+    assert.deepEqual(loadListenerConfig({ COLLECTOR_HOST: '127.0.0.1', COLLECTOR_PORT: '0' }, 'COLLECTOR'), { host: '127.0.0.1', port: 0 });
+    assert.deepEqual(loadListenerConfig({ API_HOST: '::1', API_PORT: '3002' }, 'API'), { host: '::1', port: 3002 });
+});
+
+test('listener configuration never falls back to an implicit or public bind', () => {
+    for (const host of [undefined, '', ' ', 'localhost', '0.0.0.0', '::', '192.0.2.1']) {
+        assert.throws(() => loadListenerConfig({ COLLECTOR_HOST: host, COLLECTOR_PORT: '3000' }, 'COLLECTOR'), /COLLECTOR_HOST/);
+    }
+    for (const port of [undefined, '', ' 3000', '3000x', '1.5', '-1', '65536', '0001']) {
+        assert.throws(() => loadListenerConfig({ COLLECTOR_HOST: '127.0.0.1', COLLECTOR_PORT: port, PORT: '3000' }, 'COLLECTOR'), /COLLECTOR_PORT/);
+    }
+});
+
+test('database settings use explicit values and preserve password whitespace', t => {
+    const environment = databaseEnvironment(t, ' synthetic database password \r\n');
+
+    const result = loadDatabaseConfig(environment);
+
+    assert.deepEqual(result, { host: '127.0.0.1', port: 5439, database: 'stats_test', user: 'stats_writer', password: ' synthetic database password ', max: 5, ssl: false });
+});
+
+test('all database settings are required and legacy defaults cannot reappear', t => {
+    const environment = databaseEnvironment(t);
+    for (const name of Object.keys(environment)) {
+        assert.throws(() => loadDatabaseConfig({ ...environment, [name]: undefined }), new RegExp(name));
+        assert.throws(() => loadDatabaseConfig({ ...environment, [name]: '' }), new RegExp(name));
+    }
+    assert.throws(() => loadDatabaseConfig({ ...environment, SQLHOST: 'localhost' }), /SQLHOST and SQLPASS/);
+    assert.throws(() => loadDatabaseConfig({ ...environment, SQLPASS: 'private-value' }), { message: 'SQLHOST and SQLPASS are unsupported; configure DB_* settings' });
+    assert.throws(() => loadDatabaseConfig({ ...environment, DB_HOST: '192.0.2.10' }), /DB_HOST/);
+    assert.throws(() => loadDatabaseConfig({ ...environment, DB_PORT: '0' }), /DB_PORT/);
+});
+
+test('database password read errors omit paths and password contents', t => {
+    const environment = databaseEnvironment(t);
+    assert.throws(() => loadDatabaseConfig({ ...environment, DB_PASSWORD_FILE: 'private-path' }), { message: 'DB_PASSWORD_FILE must be an absolute path' });
+    assert.throws(() => loadDatabaseConfig({ ...environment, DB_PASSWORD_FILE: join(environment.DB_PASSWORD_FILE, 'private-path') }), { message: 'DB_PASSWORD_FILE could not be read' });
+    for (const password of ['', '\n', 'private-value\nsecond-line', 'private-value\0']) {
+        const file = credentialFile(t, password, true);
+        assert.throws(() => loadDatabaseConfig({ ...environment, DB_PASSWORD_FILE: file }), { message: 'DB_PASSWORD_FILE must contain one nonempty password line' });
+    }
+});
+
+test('persistence accepts explicit loopback WS or encrypted remote WSS', () => {
+    for (const url of ['ws://127.0.0.1:3000/primus', 'ws://[::1]:3000/primus', 'wss://stats.example/primus']) {
+        assert.equal(loadPersistenceUrl({ COLLECTOR_WS_URL: url }), url);
+    }
+});
+
+test('persistence rejects missing, plaintext remote, credential-bearing and wrong-path URLs', () => {
+    for (const url of [undefined, '', 'invalid-private-value', 'ws://stats.example/primus', 'https://stats.example/primus', 'wss://user:private-value@stats.example/primus', 'wss://stats.example/api', 'wss://stats.example/primus?key=private-value', 'wss://stats.example/primus#private-value']) {
