diff --git a/lib/deployment-config.js b/lib/deployment-config.js
new file mode 100644
index 0000000..342d12d
--- /dev/null
+++ b/lib/deployment-config.js
@@ -0,0 +1,80 @@
+const { readFileSync } = require('fs');
+const { isAbsolute } = require('path');
+
+function requiredSetting(environment, name) {
+    const value = environment[name];
+    if (typeof value !== 'string' || value.length === 0 || value.trim() !== value) {
+        throw new Error(`${name} must be explicitly configured`);
+    }
+    return value;
+}
+
+function loopbackHost(environment, name) {
+    const value = requiredSetting(environment, name);
+    if (value !== '127.0.0.1' && value !== '::1') {
+        throw new Error(`${name} must be 127.0.0.1 or ::1; use a local reverse proxy for public access`);
+    }
+    return value;
+}
+
+function portNumber(environment, name, minimum) {
+    const value = requiredSetting(environment, name);
+    if (!/^(0|[1-9][0-9]{0,4})$/.test(value) || Number(value) < minimum || Number(value) > 65535) {
+        throw new Error(`${name} must be an integer from ${minimum} to 65535`);
+    }
+    return Number(value);
+}
+
+function loadListenerConfig(environment, prefix) {
+    return {
+        host: loopbackHost(environment, `${prefix}_HOST`),
+        port: portNumber(environment, `${prefix}_PORT`, 0),
+    };
+}
+
+function loadDatabaseConfig(environment) {
+    if (environment.SQLHOST !== undefined || environment.SQLPASS !== undefined) {
+        throw new Error('SQLHOST and SQLPASS are unsupported; configure DB_* settings');
+    }
+    const config = {
+        host: loopbackHost(environment, 'DB_HOST'),
+        port: portNumber(environment, 'DB_PORT', 1),
+        database: requiredSetting(environment, 'DB_NAME'),
+        user: requiredSetting(environment, 'DB_USER'),
+        ssl: false,
+        max: 5,
+    };
+    const file = requiredSetting(environment, 'DB_PASSWORD_FILE');
+    if (!isAbsolute(file)) {
+        throw new Error('DB_PASSWORD_FILE must be an absolute path');
+    }
+    let password;
+    try {
+        password = readFileSync(file, 'utf8').replace(/\r?\n$/, '');
+    } catch (_) {
+        throw new Error('DB_PASSWORD_FILE could not be read');
+    }
+    if (!password || /[\r\n\0]/.test(password)) {
+        throw new Error('DB_PASSWORD_FILE must contain one nonempty password line');
+    }
+    config.password = password;
+    return config;
+}
+
+function loadPersistenceUrl(environment) {
+    const value = requiredSetting(environment, 'COLLECTOR_WS_URL');
+    let url;
+    try {
+        url = new URL(value);
+    } catch (_) {
+        throw new Error('COLLECTOR_WS_URL must be a WebSocket URL ending in /primus');
+    }
+    const local = url.hostname === '127.0.0.1' || url.hostname === '[::1]';
+    const transportAllowed = url.protocol === 'wss:' || (url.protocol === 'ws:' && local);
+    if (!transportAllowed || url.username || url.password || url.search || url.hash || url.pathname !== '/primus') {
+        throw new Error('COLLECTOR_WS_URL requires WSS or loopback WS, path /primus and no credentials, query or fragment');
+    }
+    return url.href;
+}
+
+module.exports = { loadListenerConfig, loadDatabaseConfig, loadPersistenceUrl };
