[Unit]
Description=Isolated historical Fusion gateway for %i
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=USER=%i TERM=dumb
ExecStart=-/usr/local/libexec/fusion-gateway/fusion-gateway.sh start
ExecStop=/usr/local/libexec/fusion-gateway/fusion-gateway.sh stop
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
